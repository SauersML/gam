                            -o ConnectTimeout=5 -o LogLevel=ERROR -p "$pport" "root@$pip" \
                            'nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits -l 1 & p=$!; sleep 5; kill $p' 2> /dev/null < /dev/null |
                            awk '{ s += $1; n++ } END { if (n) printf "%d*", s / n }') && [ -n "$u" ] && { echo "$u"; break; }
