            total=$(awk -v a="$total" -v b="$est" 'BEGIN { printf "%.2f", a + b }')
        done
        budget "$total" "this batch's estimate (${#runs[@]} runs)"
        for run in "${runs[@]}"; do
            envs=()
            IFS=$'\x1f' read -r -a words <<< "$run"
            while [[ ${words[0]:-} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; do envs+=("${words[0]}"); words=("${words[@]:1}"); done
            mkdir -p "$RP/${words[0]}"
            env "${envs[@]}" RP_BATCH=1 RP_PARALLEL=1 nohup "$SELF" "${words[@]}" > "$RP/${words[0]}/console.log" 2>&1 < /dev/null &
            echo "rp-run: launched ${words[0]} (process $!); console $RP/${words[0]}/console.log; rp-run status shows it" >&2
        done
        exit 0 ;;
    stop)
        [ $# -eq 2 ] || usage
        # A run packed onto another's pod: its runner stops it and leaves the pod.
        g=$(ls "$ACTIVE"/.*.guests/"$2" 2> /dev/null | head -n 1 || true)
        if [ -n "$g" ]; then
            owner=$(cat "$g")
            touch "$RP/$2/STOP"
            kill -TERM "$owner" 2> /dev/null || true
            for i in $(seq 60); do kill -0 "$owner" 2> /dev/null || break; sleep 1; done
            kill -KILL "$owner" 2> /dev/null || true
            rm -f "$RP/$2/STOP"
            echo "rp-run: $2 stopped (it shared a pod; the pod stays while other runs use it)" >&2
            exit 0
        fi
