        if kill -0 "$owner" 2> /dev/null; then
            # A held pod's holder sees STOP within seconds; a run's runner ends on TERM (its exit
            # deletes the pod and enters it in the ledger); a runner that does not end within a
            # minute is killed and the pod deleted here.
            touch "$RP/$2/STOP"
            for i in $(seq 10); do [ -f "$ACTIVE/$pod" ] || break; sleep 1; done
            [ ! -f "$ACTIVE/$pod" ] || kill -TERM "$owner" 2> /dev/null || true
            for i in $(seq 60); do [ -f "$ACTIVE/$pod" ] || break; sleep 1; done
            if [ -f "$ACTIVE/$pod" ]; then
                echo "rp-run: the runner of $2 (process $owner) did not end; killing it and deleting pod $pod" >&2
                kill -KILL "$owner" 2> /dev/null || true
                reap "$pod"
            fi
        else
            reap "$pod"
        fi
        rm -f "$RP/$2/STOP"
        if [ -f "$ACTIVE/$pod" ]; then
            echo "rp-run: $2 stopped; pod $pod stays for the runs packed onto it ($(ls "$ACTIVE/.$pod.guests" 2> /dev/null | paste -sd ' ' -))" >&2
        else
            echo "rp-run: $2 stopped; pod $pod deleted ($(grep "$pod" "$LEDGER" | tail -n 1 | cut -f5,6 | awk '{ printf "%s h, $%s", $1, $2 }'))" >&2
        fi
        exit 0 ;;
    extend)
        [ $# -eq 3 ] || usage
        hours_ok "$3"
        h=$(held "$2") || { echo "rp-run: no pod held for $2" >&2; exit 2; }
        read -r pod price owner <<< "$h"
        kill -0 "$owner" 2> /dev/null || { echo "rp-run: the process holding $2 is gone" >&2; exit 2; }
        budget "$(awk -v p="$price" -v h="$3" 'BEGIN { printf "%.2f", p * h }')" "this extension"
        was=$(cat "$ACTIVE/.$pod.deadline" 2> /dev/null || echo 0)
        echo "$3" > "$RP/$2/EXTEND"
        # The runner takes it within seconds (hold() for a dev pod, extend_loop for a run); one that
        # does not (a run still before its pod answers SSH, or a runner from before extend_loop)
        # leaves it, and nothing changes.
        for i in $(seq 90); do [ -f "$RP/$2/EXTEND" ] || break; sleep 1; done
        if [ -f "$RP/$2/EXTEND" ]; then
            rm -f "$RP/$2/EXTEND"
            echo "rp-run: $2's runner did not take the extension within 90 s (a run whose pod does not answer SSH yet, or a runner started before runs could be extended); its cap stays at $(date -r "$was" '+%F %T')" >&2
            exit 1
        fi
        now=$(cat "$ACTIVE/.$pod.deadline" 2> /dev/null || echo "$was")
        if (( now > was )); then
            echo "rp-run: $2 ($pod) now runs until $(date -r "$now" '+%F %T')" >&2
            exit 0
        fi
        echo "rp-run: $2's runner could not move the pod's own deletion timer; its cap stays at $(date -r "$was" '+%F %T') (rp-run.log)" >&2
        exit 1 ;;
    dev)
        MODE=dev
        shift
        [ $# -ge 1 ] || usage
        NAME=$1 GPU="RTX A5000,RTX 4090" HOURS=4
        shift
        [ $# -gt 0 ] && [ "$1" != -- ] && { GPU=$1; shift; }
        [ $# -gt 0 ] && [ "$1" != -- ] && { HOURS=$1; shift; }
        [ $# -eq 0 ] || { [ "$1" = -- ] || usage; shift; } ;;
    *)
        [ $# -ge 5 ] && [ "$4" = -- ] || usage
        NAME=$1 GPU=$2 HOURS=$3
        shift 4 ;;
esac
name_ok "$NAME"
# Listed in APPROVED.txt, or approved automatically as a small run once its estimate is known.
APPROVAL=auto
! approved "$NAME" || APPROVAL=listed
hours_ok "$HOURS"
CAP_SECONDS=$(awk -v h="$HOURS" 'BEGIN { printf "%d", h * 3600 }')
OUT=$RP/$NAME
# The run's directory on the pod: its source, binaries, data and outputs, beside any other run the
# pod holds (pod-wide: /workspace/gpu-util.log and the Python packages).
WS=/workspace/runs/$NAME

# How long a new pod may take to answer SSH (reach waits that long): the slowest time to SSH
# measured (SSH_UP, at least ten pods) plus the median, the wait a replacement pod typically costs;
# 300 s until ten are measured. 107 pods answered in 8-56 s (median 26 s); the six that took longer
# never answered, and each held a paid GPU for 300 s.
SSH_UP=$RP/ssh_up.tsv BAD_IPS=$RP/bad_ips
ssh_wait() {
    cut -f3 "$SSH_UP" 2> /dev/null | sort -n | awk '{ a[NR] = $1 } END { print (NR >= 10 ? a[NR] + a[int((NR + 1) / 2)] : 300) }'
}
# GPU_TYPE auto: OFFERS ("KIND|PRICE|GPU id"), every offer (card and cloud) of the measured cards
# with the memory the run asks (RP_MIN_VRAM_GB), by expected dollars per useful scored token, and
# their listing on stdout. Scored tokens per second R come from the benchmark table: Qwen3-0.6B's
# step when the run needs more than 24 GB, else vpd4l's bf16 step at 32 sequences. An offer at P $/h
# costs P / (3600 R) per token once a pod works. An attempt on it fails with probability f, and a
# failure costs W seconds of the pod (creation until the failure shows) before the next attempt, so
# the expected number of failures before a working pod is f / (1 - f), and the run's L = HOURS
# seconds of tokens cost P / (3600 R) * (1 + f / (1 - f) * W / L) per token. f and W come from
# ATTEMPTS (outcomes other than "ended"): for the offer's card and cloud, n attempts with m failures
# losing w seconds in all, f = (m + 2 F) / (n + 2) and W = (w + V) / (m + 1), drawn toward its
# cloud's F = (M + 1) / (N + 2) and V = (U + W0) / (M + 1) over all cards (N attempts, M failures,
# U seconds), where W0 is the longest a pod waits for SSH (ssh_wait). With no records every offer
# has f = 1/2 and W = W0, and the cheaper cloud leads. Cards the table has not measured are offered
# only when no measured card has the memory, cheapest per hour first. Thunder's and Nebius's offers
# are ranked by their own measured rows (card thunder:CARD:MODE, nebius:PLATFORM).
AUTO=0
rank_auto() {
    local stats
    stats=$(awk -F'\t' 'NR > 1 && $10 != "ended" && $10 != "" && $10 != "discarded" && $11 != "host failed before" && $11 != "data center failed before" {
                o = $4 "|" $5; c = $5; n[o]++; nc[c]++
                if ($10 != "worked") { m[o]++; w[o] += $9; mc[c]++; wc[c] += $9 }
            }
            END { for (o in n) print "o\t" o "\t" n[o] "\t" m[o] + 0 "\t" w[o] + 0; for (c in nc) print "c\t" c "\t" nc[c] "\t" mc[c] + 0 "\t" wc[c] + 0 }' "$ATTEMPTS" 2> /dev/null |
        jq -Rsc 'split("\n") | map(select(length > 0) | split("\t")) | {o: (map(select(.[0] == "o") | {key: .[1], value: {n: (.[2] | tonumber), m: (.[3] | tonumber), w: (.[4] | tonumber)}}) | from_entries),
                                                                   c: (map(select(.[0] == "c") | {key: .[1], value: {n: (.[2] | tonumber), m: (.[3] | tonumber), w: (.[4] | tonumber)}}) | from_entries)}') || true
    [ -n "$stats" ] || stats='{"o": {}, "c": {}}'
    OFFERS=$(awk -F'\t' -v m="$metric" 'NR == 1 { for (i = 1; i <= NF; i++) { if ($i == "card") c = i; if ($i == m) t = i }; next }
             t && $t != "-" && $t + 0 > 0 { print $c "\t" $t }' "$TABLE" |
        jq -Rrs --argjson types "$(jq -c '.data.gpuTypes' <<< "$prices")" --argjson need "${RP_MIN_VRAM_GB:-0}" --argjson others "$others" \
            --argjson stats "$stats" --argjson w0 "$(ssh_wait)" --argjson L "$CAP_SECONDS" '
            (split("\n") | map(select(length > 0) | split("\t") | {key: .[0], value: (.[1] | tonumber)}) | from_entries) as $rate
            | def offers($t): [{k: "COMMUNITY", c: 0, p: $t.communityPrice}, {k: "SECURE:cheapest-per-token", c: 1, p: $t.securePrice}] | map(select((.p // 0) > 0));
              def risk: (.k | split(":")[0]) as $cl | ($stats.c[$cl] // {n: 0, m: 0, w: 0}) as $C | ($stats.o[.g + "|" + $cl] // {n: 0, m: 0, w: 0}) as $O
                | (($C.m + 1) / ($C.n + 2)) as $F | (($C.w + $w0) / ($C.m + 1)) as $V
                | (($O.m + 2 * $F) / ($O.n + 2)) as $f | (($O.w + $V) / ($O.m + 1)) as $W
                | . + {f: $f, W: $W, n: $O.n, x: (1 + $f / (1 - $f) * $W / $L)};
              ([$types[] | . as $t | offers($t)[] | . + {g: $t.id, mem: ($t.memoryInGb // 0)}] + $others | map(select(.mem >= $need))) as $all
            | [$all[] | select($rate[.g] != null) | . + {per: (.p / ($rate[.g] * 3600 / 1e6))} | risk | . + {exp: (.per * .x)}]
            | if length > 0 then sort_by([.exp, .c])
              else [$all[] | select((.g | test("^(thunder|nebius):")) or (.g | test("A40|A6000|L40|A100|H100|H200"))) | . + {per: null}] | sort_by([.c, .p]) end
            | .[] | "\(.k)|\(.p)|\(.g)|\(.per // "-")|\(.exp // "-")|\(.f // "-")|\(.W // "-")|\(.n // "-")"')
    echo "rp-run: auto, by expected dollars per scored token on the $metric workload (rates from $TABLE, failures from $ATTEMPTS):"
    awk -F'|' -v cap="${RP_MAX_PRICE:-}" '{ over = (cap != "" && $2 + 0 > cap + 0) ? sprintf("; dropped: over RP_MAX_PRICE $%s/h", cap) : ""
                 if ($4 == "-") printf "rp-run:   %s %s $%s/h, not measured%s\n", $3, $1, $2, over
                 else printf "rp-run:   %s %s $%s/h, $%.4f per million scored tokens, $%.4f expected (an attempt fails with p = %.2f, %d attempts recorded, %d s lost per failure)%s\n", $3, $1, $2, $4, $5, $6, $8, $7, over }' <<< "$OFFERS"
    OFFER_PER=$(cut -d'|' -f1,3,4 <<< "$OFFERS")
    OFFERS=$(cut -d'|' -f1-3 <<< "$OFFERS")
    cap_offers > /dev/null
}

# RP_MAX_PRICE ($/h): a run that states it never takes an offer above it, in auto and in a list
# of types. The ranking is per token on the benchmark workload, which is not every run's workload
# (oracle-train-dir1 took an H100 SECURE at $3.49/h when every 48 GB offer below it failed). Drops
# those offers from OFFERS and prints each dropped one.
cap_offers() {
    [ -n "${RP_MAX_PRICE:-}" ] || return 0
    awk -v c="$RP_MAX_PRICE" 'BEGIN { exit !(c + 0 > 0) }' || { echo "rp-run: RP_MAX_PRICE takes dollars per hour above 0, not '$RP_MAX_PRICE'" >&2; exit 2; }
    awk -F'|' -v c="$RP_MAX_PRICE" '$2 + 0 > c + 0 { printf "rp-run: dropped %s %s $%s/h: over RP_MAX_PRICE $%s/h\n", $3, $1, $2, c }' <<< "$OFFERS"
    OFFERS=$(awk -F'|' -v c="$RP_MAX_PRICE" '$2 + 0 <= c + 0' <<< "$OFFERS")
}

# The offers, one per line "KIND|PRICE|GPU id": a run takes community (or another provider's
# offer) for every type before secure; a dev pod takes the types in order, community before secure
# for each. A type thunder:CARD[:MODE] is Thunder's (both modes, cheaper first, when MODE is not given).
OFFERS=""
[ "$GPU" != cpu ] || { echo "rp-run: work without a GPU goes to GitHub Actions: bench/runpod/gha-run" >&2; exit 2; }
if :; then
    r=$(gql 'query { gpuTypes { id displayName memoryInGb securePrice communityPrice } }')
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: price query failed: $(body_of "$r" | head -c 300)" >&2; exit 1; }
    prices=$(body_of "$r")
    if [ "$GPU" = auto ]; then
        [ -f "$TABLE" ] || { echo "rp-run: GPU_TYPE auto needs the benchmark table $TABLE" >&2; exit 2; }
        metric="vpd4l bf16 s32 tok/s"
        (( ${RP_MIN_VRAM_GB:-0} > 24 )) && metric="qwen3 bf16 s8 tok/s"
        others=$(provider_offers | jq -Rsc 'split("\n") | map(select(length > 0) | split("|") | {k: .[0], c: 0, p: (.[1] | tonumber), g: .[2], mem: (.[3] | tonumber)})')
        AUTO=1
        rank_auto >&2
        [ -n "$OFFERS" ] || { echo "rp-run: no card has ${RP_MIN_VRAM_GB:-0} GB${RP_MAX_PRICE:+ at or under RP_MAX_PRICE \$$RP_MAX_PRICE/h}" >&2; exit 2; }
        GPU=$(cut -d'|' -f3 <<< "$OFFERS" | awk '!seen[$0]++' | paste -sd, -)
    else
    rows=()
    secure_kind=SECURE:no-community-stock
    [ "$MODE" = dev ] && secure_kind=SECURE:dev
    IFS=, read -r -a types <<< "$GPU"
    for g in "${types[@]}"; do
        g=$(sed 's/^ *//; s/ *$//' <<< "$g")
        if [[ $g == thunder:* || $g == nebius:* ]]; then
            [ -n "${others+x}" ] || others=$(provider_offers)
            row=$(awk -F'|' -v g="$g" '$3 == g || index($3, g ":") == 1 { printf "%s{\"k\": \"%s\", \"p\": %s, \"g\": \"%s\", \"c\": 0}", (n++ ? "," : ""), $1, $2, $3 }' <<< "$others")
            [ -n "$row" ] || { echo "rp-run: no offer of $g under the ceilings (Thunder $THUNDER_CEILING, Nebius $NEBIUS_CEILING; each needs its key in the Keychain); offers: $(cut -d'|' -f2,3 <<< "${others:-none}" | paste -sd ' ' -)" >&2; exit 2; }
            rows+=("[$row]")
            continue
        fi
        row=$(jq -c --arg g "$g" --arg sk "$secure_kind" '[.data.gpuTypes[] | select(.id == $g or .displayName == $g)][0] // empty
            | [{k: "COMMUNITY", p: .communityPrice, c: 0, g: .id}, {k: $sk, p: .securePrice, c: 1, g: .id}]' <<< "$prices")
        [ -n "$row" ] || { echo "rp-run: unknown GPU type '$g'; known: $(jq -r '[.data.gpuTypes[].displayName] | join(", ")' <<< "$prices"), thunder:CARD[:MODE], nebius:PLATFORM" >&2; exit 2; }
        rows+=("$row")
    done
    OFFERS=$(printf '%s\n' "${rows[@]}" | jq -rs --arg mode "$MODE" '
        [to_entries[] | .key as $i | .value[] | select((.p // 0) > 0) | . + {i: $i}]
        | (if $mode == "dev" then sort_by([.i, .c, .p]) else sort_by([.c, .i, .p]) end)
        | .[] | "\(.k)|\(.p)|\(.g)"')
    cap_offers >&2
    [ -n "$OFFERS" ] || { echo "rp-run: no provider offers any of $GPU${RP_MAX_PRICE:+ at or under RP_MAX_PRICE \$$RP_MAX_PRICE/h}" >&2; exit 2; }
    fi
fi

PRICE_MAX=$(awk -F'|' '$2 > m { m = $2 } END { print m }' <<< "$OFFERS")

ESTIMATE=$(awk -v p="$PRICE_MAX" -v h="$HOURS" 'BEGIN { printf "%.2f", p * h }')

# The small-run rule (the lead's, 2026-10-05), which approves a run APPROVED.txt does not list and
# lets any run start beside others without RP_PARALLEL=1: the run's estimate (its dearest offer
# times HOURS) at most AUTO_RUN; its owner's (RP_OWNER) spend over the last 24 h, plus that
# estimate, at most AUTO_OWNER_DAY; and the account's spend rate now (every running pod, ours and
# others', and our other providers' pods) plus the run's price at most AUTO_RATE $/h. The owner's
# spend counts the ledger's pods of that owner deleted in the last 24 h, the whole cap of each of
# the owner's pods still running, and the estimates of the owner's runs approved in the last 24 h
# that have no pod yet (APPROVALS, under a lock, so runs started together see each other). Prints
# the reason when the rule fails.
AUTO_RUN=3 AUTO_OWNER_DAY=8 AUTO_RATE=4
APPROVALS=$MAC_DATA/runpod/approvals.tsv
# Launches logged in APPROVALS whose pod does not exist yet: "PID OWNER ESTIMATE PRICE" for each whose
# runner still lives and holds neither a pod record nor a place on another run's pod.
pending_launches() {
    local now
    now=$(date +%s)
    cat "$APPROVALS" 2> /dev/null | awk -F'\t' -v t=$(( now - 86400 )) 'NR > 1 && $2 + 0 >= t { print $6, $4, $5, ($8 == "" ? 0 : $8) }' |
        while read -r pid o est price; do
            kill -0 "$pid" 2> /dev/null || continue
            grep -lqs "^[^ ]* [^ ]* [^ ]* [^ ]* [^ ]* $pid " "$ACTIVE"/* && continue
            grep -qsx "$pid" "$ACTIVE"/.*.guests/* && continue
            echo "$pid $o $est $price"
        done
}

small_run() {
    local owner=${RP_OWNER:-} day rate now rec pod o pending
    now=$(date +%s)
    [ -n "$owner" ] && [ "$owner" != - ] || { echo "no owner (RP_OWNER=AGENT names whose spend it is)"; return 1; }
    awk -v e="$ESTIMATE" -v c="$AUTO_RUN" 'BEGIN { exit !(e <= c) }' || { echo "its estimate \$$ESTIMATE is over \$$AUTO_RUN"; return 1; }
    day=$(awk -F'\t' -v o="$owner" -v t="$(date -r $(( now - 86400 )) '+%F %T')" '
        NR == 1 { for (i = 1; i <= NF; i++) { if ($i == "owner") oc = i; if ($i == "dollars") dc = i }; next }
        oc && $oc == o && $1 >= t { s += $dc } END { printf "%.4f", s }' "$LEDGER" 2> /dev/null || echo 0)
    for rec in "$ACTIVE"/*; do
        [ -f "$rec" ] || continue
        pod=${rec##*/}
        [ "$(cat "$ACTIVE/.$pod.owner" 2> /dev/null)" = "$owner" ] || continue
        read -r _ _ _ p c _ < "$rec"
        day=$(awk -v d="$day" -v p="$p" -v a="$c" -v b="$(cat "$ACTIVE/.$pod.deadline" 2> /dev/null || echo "$now")" 'BEGIN { printf "%.4f", d + p * (b - a) / 3600 }')
    done
    # Launched (logged in APPROVALS), still running, and no pod yet: its estimate, and its price below.
    pending=$(pending_launches)
    day=$(awk -v o="$owner" -v d="$day" '$2 == o { d += $3 } END { printf "%.4f", d }' <<< "$pending")
    awk -v d="$day" -v e="$ESTIMATE" -v c="$AUTO_OWNER_DAY" 'BEGIN { exit !(d + e <= c) }' ||
        { echo "$owner's spend over the last 24 h, \$$day, plus its estimate \$$ESTIMATE is over \$$AUTO_OWNER_DAY"; return 1; }
    rate=$(gql 'query { myself { currentSpendPerHr } }' | sed '$d' | jq -r '.data.myself.currentSpendPerHr // empty' 2> /dev/null)
    [ -n "$rate" ] || { echo "the account's spend rate could not be read"; return 1; }
    for rec in "$ACTIVE"/thunder-* "$ACTIVE"/nebius-*; do
        [ -f "$rec" ] || continue
        read -r _ _ _ p _ < "$rec"
        rate=$(awk -v a="$rate" -v p="$p" 'BEGIN { print a + p }')
    done
    # Pods launched together see each other: each launch not yet a pod counts at its price.
    rate=$(awk -v r="$rate" '{ r += $4 } END { printf "%.3f", r }' <<< "$pending")
    awk -v r="$rate" -v p="$PRICE_MAX" -v c="$AUTO_RATE" 'BEGIN { exit !(r + p <= c) }' ||
        { echo "the account's \$$rate/h now plus its \$$PRICE_MAX/h is over \$$AUTO_RATE/h"; return 1; }
    echo "estimate \$$ESTIMATE, $owner's 24 h \$$day, account \$$rate/h + \$$PRICE_MAX/h"
}
SMALL="" SMALL_WHY=""
if SMALL_WHY=$(small_run); then SMALL=1; fi
if [ "$APPROVAL" = auto ] && [ -z "$SMALL" ]; then
    echo "rp-run: $NAME is not approved: APPROVED.txt (lead-only) does not list it, and it is not a small run: $SMALL_WHY" >&2
    exit 3
fi
if [ -z "${RP_ESTIMATE_ONLY:-}" ] && [ -z "${RP_DRY:-}" ]; then
    # Every launch, listed or automatic, is logged under a lock with its estimate and price, so a run
    # started at the same time counts this one (pending_launches) until its pod exists.
    until mkdir "$RP/.approvals.lock" 2> /dev/null; do
        (( $(date +%s) - $(stat -f %m "$RP/.approvals.lock" 2> /dev/null || date +%s) > 120 )) && rmdir "$RP/.approvals.lock" 2> /dev/null
        sleep 1
    done
    SMALL=""
    if SMALL_WHY=$(small_run); then SMALL=1; fi
    if [ "$APPROVAL" = auto ] && [ -z "$SMALL" ]; then
        rmdir "$RP/.approvals.lock"
        echo "rp-run: $NAME is not approved: APPROVED.txt (lead-only) does not list it, and it is not a small run: $SMALL_WHY" >&2
        exit 3
    fi
    [ -f "$APPROVALS" ] || printf 'date\tepoch\tname\towner\testimate\tpid\twhy\tprice\tapproval\n' > "$APPROVALS"
    head -n 1 "$APPROVALS" | grep -q $'\tprice' || sed -i '' '1s/$/\tprice\tapproval/' "$APPROVALS"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$(date +%s)" "$NAME" "${RP_OWNER:--}" "$ESTIMATE" "$$" "$SMALL_WHY" "$PRICE_MAX" "$APPROVAL" >> "$APPROVALS"
    rmdir "$RP/.approvals.lock"
    [ "$APPROVAL" = listed ] || echo "rp-run: $NAME approved automatically as a small run ($SMALL_WHY)" >&2
fi

# Runs left by a process that is gone (its watcher killed too) are reaped; live runs counted.
live=()
for rec in "$ACTIVE"/*; do
    [ -f "$rec" ] || continue
    read -r _ _ _ _ _ owner _ mode < "$rec" || true
    if [ -n "${owner:-}" ] && kill -0 "$owner" 2> /dev/null; then
        [ "${mode:-run}" = run ] && live+=("${rec##*/}")
    else
        echo "rp-run: ${rec##*/} was left by a run that is gone; deleting it unless a run packed onto it still uses it" >&2
        reap "${rec##*/}" || exit 1
    fi
done
if [ "$MODE" = run ] && [ ${#live[@]} -gt 0 ] && [ -z "${RP_PARALLEL:-}" ] && [ -z "$SMALL" ]; then
    echo "rp-run: pod ${live[*]} is running for another rp-run, and this run is not small ($SMALL_WHY); RP_PARALLEL=1 to run beside it" >&2
    exit 2
fi

# The commit.
C=""
if :; then
    git -C "$MAC_GAM" fetch -q origin main
    C=$(git -C "$MAC_GAM" rev-parse "${RP_REF:-origin/main}^{commit}")
    git -C "$MAC_GAM" merge-base --is-ancestor "$C" origin/main || { echo "rp-run: ${C:0:12} is not on origin/main; push it or set RP_REF to a published commit" >&2; exit 2; }
fi

# `cargo run [...] --example X [...] -- ARGS` -> X ARGS
if [ "$MODE" = run ] && [ "$1" = cargo ] && [ "${2:-}" = run ]; then
    ex="" rest=()
    while [ $# -gt 0 ]; do
        case $1 in
            --example) ex=$2; shift 2 ;;
            --example=*) ex=${1#--example=}; shift ;;
            --) shift; rest=("$@"); break ;;
            *) shift ;;
        esac
    done
    [ -n "$ex" ] || { echo "rp-run: only 'cargo run --example X' is translated" >&2; exit 2; }
    set -- "target/release/examples/$ex" "${rest[@]}"
fi
NEED_RUST=0
[ "$MODE" = dev ] && NEED_RUST=1
if [ "$MODE" = run ] && [ "$1" = cargo ]; then
    echo "rp-run: a GPU pod does not compile: name test binaries in RP_TESTS=PACKAGE:TEST and run \$MPD_BIN/test-TEST" >&2
    exit 2
fi
# Test binaries the command runs through $MPD_BIN (test-NAME), built like the examples.
read -r -a tests <<< "${RP_TESTS:-}"
for x in "${tests[@]}"; do [[ $x =~ ^[A-Za-z0-9_-]+:[A-Za-z0-9_]+$ ]] || { echo "rp-run: RP_TESTS takes PACKAGE:TEST words, not $x" >&2; exit 2; }; done

uploads=() hf=() srcpaths=() examples=() words=() fineweb=() pile=()
DATA_HAVE=$(published_data)
# Whether each of the files NAME... that mpd-data/DIR holds is published (a missing one is not needed).
all_published_any() {  # DIR NAME...
    local d=$1 x
    shift
    for x; do [ ! -e "$MAC_DATA/$d/$x" ] || all_published "$d/$x" || return 1; done
}
# Whether every file under mpd-data/REL is published.
all_published() {  # REL
    local f
    while IFS= read -r f; do
        [ -n "$(asset_for "$(sha_of "${f#"$MAC_DATA"/}")")" ] || return 1
    done < <(find -L "$MAC_DATA/$1" -type f ! -name '.*')
}
[ -z "$C" ] || ! git -C "$MAC_GAM" cat-file -e "$C:bench/runpod" 2> /dev/null || srcpaths+=(bench/runpod)
# The FineWeb release's contents (per shard: source file and every file's sha256), remade when the
# release changes.
CONTENTS=$MAC_DATA/qwen3_fineweb/release/CONTENTS.json
if [ -f "${CONTENTS%/*}/SHA256SUMS" ] && { [ ! -f "$CONTENTS" ] || [ "${CONTENTS%/*}/SHA256SUMS" -nt "$CONTENTS" ]; }; then
    /usr/bin/python3 "${SELF%/*}/fineweb_contents.py" > /dev/null || { echo "rp-run: could not read the FineWeb release" >&2; exit 1; }
fi
first=1
[ "$MODE" = run ] || first=0
for a in "$@"; do
    if [ $first = 1 ]; then
        case $a in
            "$MAC_GAM"/target/*/examples/*|target/*/examples/*|./target/*/examples/*) examples+=("${a##*/}"); a="$WS/bin/${a##*/}" ;;
            python|python3|"$MAC_DATA"/venv/bin/python*) a=python3 ;;
        esac
        first=0
    fi
    while read -r p; do
        [ -n "$p" ] || continue
        case $p in "$MAC_DATA"/runpod/*|"$MAC_DATA"/venv*) continue ;; esac
        rel=${p#"$MAC_DATA"/}
        rel=${rel%/}
        # Data with a public source is built on the pod: a FineWeb release shard (or its Mac copy
        # train, heldout), and a vpd4l export extended with Pile training rows (its base export,
        # which holds the target's weights, goes up instead).
        # A FineWeb shard the Mac holds and has published is downloaded with the files beside it
        # (meta.json, documents.u32, offsets.u64) instead of tokenized on the pod.
        if [[ $rel =~ ^qwen3_fineweb/([^/]+)(/([^/]+))?$ ]] && [ -e "$p" ] && all_published "$rel" &&
           all_published_any "qwen3_fineweb/${BASH_REMATCH[1]}" meta.json documents.u32 offsets.u64; then
            uploads+=("$rel")
            for x in meta.json documents.u32 offsets.u64; do
                [ -e "$MAC_DATA/qwen3_fineweb/${BASH_REMATCH[1]}/$x" ] && uploads+=("qwen3_fineweb/${BASH_REMATCH[1]}/$x")
            done
        elif [[ $rel =~ ^qwen3_fineweb/([^/]+)(/([^/]+))?$ ]] && [ -f "$CONTENTS" ] && jq -e --arg d "${BASH_REMATCH[1]}" 'has($d)' "$CONTENTS" > /dev/null; then
            fineweb+=("${BASH_REMATCH[1]} ${BASH_REMATCH[3]:-}")
        elif [[ $rel =~ ^engine/([^/]+) ]] && jq -e '.source.extends.export' "$MAC_DATA/engine/${BASH_REMATCH[1]}/export.json" > /dev/null 2>&1 &&
             ! all_published "engine/${BASH_REMATCH[1]}"; then
            pile+=("${BASH_REMATCH[1]}")
        elif [ -e "$p" ]; then
            uploads+=("$rel")
        fi
    done < <(grep -oE "$MAC_DATA/[^ :,;=\"']+" <<< "$a" || true)
    while read -r p; do
        [ -n "$p" ] && hf+=("$p")
    done < <(grep -oE "$HF_HUB/models--[^/ ]+--[^/ ]+/snapshots/[0-9a-f]+" <<< "$a" || true)
    # A binary the command names anywhere, as an argument too (a script's argument), is fetched like
    # the command's own: every target/*/examples/X it names becomes an example the run needs.
    while read -r x; do
        [ -n "$x" ] && examples+=("${x##*/}")
    done < <(grep -oE "(^|[ =:,\"'])(\./)?($MAC_GAM/)?target/[a-z-]+/examples/[A-Za-z0-9_-]+" <<< " $a" | sed -E 's/^[ =:,"'"'"']//' || true)
    a=$(sed -E "s#(^|[ =:,])(\./)?target/[a-z-]+/examples/#\1$WS/bin/#g" <<< "$a")
    while read -r p; do
        [ -n "$p" ] || continue
        rel=${p#"$MAC_GAM"/}
        rel=${rel%/}
        case $rel in target/*) continue ;; esac
        git -C "$MAC_GAM" cat-file -e "$C:$rel" 2> /dev/null && srcpaths+=("$rel")
    done < <(grep -oE "$MAC_GAM/[^ :,;=\"']+" <<< "$a" || true)
    # A path relative to the repository (the command runs in WS/src) that the commit holds.
    while read -r p; do
        p=${p#./} p=${p%/}
        [ -n "$p" ] && [[ $p != target/* ]] && git -C "$MAC_GAM" cat-file -e "$C:$p" 2> /dev/null && srcpaths+=("$p")
    done < <(grep -oE "(^|[ =:,\"'])(\./)?[A-Za-z0-9_][A-Za-z0-9_.-]*/[^ :,;=\"']*" <<< " $a" | sed -E 's/^[ =:,"'"'"']//' || true)
    a=${a//$MAC_GAM\/target\/release\/examples\//$WS/bin/}
    a=${a//$MAC_GAM\//$WS/src/}
    a=${a//$MAC_DATA\//$WS/mpd-data/}
    if [[ $a =~ $HF_HUB/models--([^/ ]+)--([^/ ]+)/snapshots/([0-9a-f]+) ]]; then
        a=${a//"${BASH_REMATCH[0]}"/"$WS/hf/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"}
    fi
    words+=("$a")
done
for x in ${RP_EXAMPLES:-}; do examples+=("$x"); done
[ ${#examples[@]} -gt 0 ] && examples=($(printf '%s\n' "${examples[@]}" | sort -u))

# Each example's package, from the commit's tree.
declare -A package_of
for x in "${examples[@]}"; do
    f=$(git -C "$MAC_GAM" ls-tree -r --name-only "$C" -- crates | grep -E "^crates/[^/]+/examples/$x(\.rs|/main\.rs)$" | head -n 1 || true)
    [ -n "$f" ] || { echo "rp-run: no example $x in crates/*/examples at ${C:0:12}" >&2; exit 2; }
    crate=${f#crates/}
    crate=${crate%%/*}
    package_of[$x]=$(git -C "$MAC_GAM" show "$C:crates/$crate/Cargo.toml" | sed -nE 's/^name = "([^"]+)"/\1/p' | head -n 1)
done
# FineWeb shards to build: "DIR|FILE_INDEX|DOCUMENTS|CONTEXTS|SHA256SUM-LINES" (the files the
# command names, documents.u32 and offsets.u64; every window length when it names the directory).
# A shard whose files (with meta.json) are assets of rp-run-data under the release's sha256s is
# downloaded instead ("SHA256 REL SHA256" in fw_fetched, sizes in fetch_size); a shard built on the
# pod is also built whole on a free GitHub Actions runner and published there (fw_publish, below).
fw_plan=() pile_plan=() data_kb=0 fw_fetched=() fw_publish=()
declare -A fetch_size
if [ ${#fineweb[@]} -gt 0 ]; then
    git -C "$MAC_GAM" cat-file -e "$C:bench/mpd_qwen3_fineweb_2951.py" 2> /dev/null || { echo "rp-run: ${C:0:12} has no bench/mpd_qwen3_fineweb_2951.py to build FineWeb shards with" >&2; exit 2; }
    srcpaths+=(bench/mpd_qwen3_fineweb_2951.py)
    for d in $(for e in "${fineweb[@]}"; do echo "${e%% *}"; done | sort -u); do
        entry=$(jq -c --arg d "$d" '.[$d]' "$CONTENTS")
        all=$(jq -r '.files | keys[] | capture("^windows_T(?<t>[0-9]+)[.]u32$").t' <<< "$entry" | sort -n | tr '\n' ' ')
        ts=""
        for e in "${fineweb[@]}"; do
            [ "${e%% *}" = "$d" ] || continue
            f=${e#* }
            case $f in
                "") ts+="$all" ;;
                windows_T*.u32) t=${f#windows_T}; ts+="${t%.u32} " ;;
                documents.u32|offsets.u64|meta.json) ;;
                *) echo "rp-run: qwen3_fineweb/$d/$f is not a file of the FineWeb release" >&2; exit 2 ;;
            esac
        done
        [ -n "$ts" ] || ts=${all%% *}
        ts=$(tr ' ' '\n' <<< "$ts" | sed '/^$/d' | sort -nu | tr '\n' ',' | sed 's/,$//')
        check="documents.u32 offsets.u64 $(tr ',' '\n' <<< "$ts" | sed 's/.*/windows_T&.u32/' | tr '\n' ' ')"
        have_all=1
        for f in $check meta.json; do
            sha=$(jq -r --arg f "$f" '.files[$f] // empty' <<< "$entry")
            [ -n "$sha" ] && grep -qx "$sha" <<< "$DATA_HAVE" || { have_all=0; break; }
        done
        if (( have_all )); then
            for f in $check meta.json; do
                sha=$(jq -r --arg f "$f" '.files[$f]' <<< "$entry")
                fw_fetched+=("$sha qwen3_fineweb/$d/$f $sha")
                fetch_size["qwen3_fineweb/$d/$f"]=$(jq -r --arg f "$f" '.sizes[$f]' <<< "$entry")
                data_kb=$(( data_kb + ${fetch_size["qwen3_fineweb/$d/$f"]} / 1024 ))
            done
            continue
        fi
        fw_publish+=("$d|$(jq -r '.file_index' <<< "$entry")|$(jq -r '.documents' <<< "$entry")|${all% }|$(jq -r '.files | to_entries[] | "\(.value)  \(.key)"' <<< "$entry" | tr '\n' ';')")
        sums=""
        for f in $check; do
            sha=$(jq -r --arg f "$f" '.files[$f] // empty' <<< "$entry")
            [ -n "$sha" ] || { echo "rp-run: qwen3_fineweb/$d has no $f in the release" >&2; exit 2; }
            sums+="$sha  $f;"
            data_kb=$(( data_kb + $(jq -r --arg f "$f" '.sizes[$f]' <<< "$entry") / 1024 ))
        done
        fw_plan+=("$d|$(jq -r '.file_index' <<< "$entry")|$(jq -r '.documents' <<< "$entry")|$ts|$sums")
    done
    # The largest source file is on the pod's disk while its shard is built.
    [ ${#fw_plan[@]} -eq 0 ] || data_kb=$(( data_kb + $(curl -sS -X POST -H 'Content-Type: application/json' --max-time 60 \
        -d "$(jq -c '{paths: [.[] | .source_file] | unique}' "$CONTENTS")" \
        https://huggingface.co/api/datasets/HuggingFaceFW/fineweb/paths-info/9bb295ddab0e05d785b879661af7260fed5140fc |
        jq '[.[].size] | max' ) / 1024 ))
fi
# Pile-extended vpd4l exports to build: "EXPORT BASE MIN_TRAIN_ROWS" (the base export uploaded).
if [ ${#pile[@]} -gt 0 ]; then
    git -C "$MAC_GAM" cat-file -e "$C:bench/vpd_2951/vpd_engine_export_pile.py" 2> /dev/null || { echo "rp-run: ${C:0:12} has no bench/vpd_2951/vpd_engine_export_pile.py to build Pile exports with" >&2; exit 2; }
    srcpaths+=(bench/vpd_2951/vpd_engine_export_pile.py)
    for x in $(printf '%s\n' "${pile[@]}" | sort -u); do
        record_json=$MAC_DATA/engine/$x/export.json
        base=$(jq -r '.source.extends.export' "$record_json")
        [[ $base == "$MAC_DATA"/* ]] && [ -f "$base/export.json" ] || { echo "rp-run: engine/$x extends $base, which is not an export under $MAC_DATA" >&2; exit 2; }
        uploads+=("${base#"$MAC_DATA"/}")
        pile_plan+=("$x ${base#"$MAC_DATA"/} $(jq '[.source.data[1:][] | .rows[1] - .rows[0]] | add' "$record_json")")
        # The export's tensors as its export.json records them (the Mac need not hold them), and the
        # Pile files it is built from (smaller than their float64 rows).
        data_kb=$(( data_kb + 2 * $(jq '[.files[].shape | reduce .[] as $n (8; . * $n)] | add / 1024 | floor' "$record_json") ))
    done
fi
KEY="" CACHE="" CHANNEL=""
if [ -n "$C" ]; then
    # Binaries built from the same Rust sources in the same image are the same binaries.
    KEY=$( { git -C "$MAC_GAM" rev-parse "$C:crates" "$C:Cargo.lock" "$C:Cargo.toml" "$C:rust-toolchain.toml"; echo "$IMAGE"; } | shasum | cut -c1-16)
    CACHE=$RP/_bin/$KEY
    CHANNEL=$(git -C "$MAC_GAM" show "$C:rust-toolchain.toml" | sed -nE 's/^channel = "([^"]+)"/\1/p')
fi

envp=()
[ -n "${RUST_LOG:-}" ] && envp+=("RUST_LOG=$RUST_LOG")
[ -n "${RP_ENV:-}" ] && read -r -a extra <<< "$RP_ENV" && envp+=("${extra[@]}")
cmd=""
[ ${#words[@]} -gt 0 ] && cmd=$(printf '%q ' "${words[@]}")
[ ${#envp[@]} -gt 0 ] && cmd="env $(printf '%q ' "${envp[@]}")$cmd"

# The input files, with their sizes, relative to mpd-data.
files=()
upload_kb=0
if [ ${#uploads[@]} -gt 0 ]; then
    while IFS= read -r f; do files+=("$f"); done < <(cd "$MAC_DATA" && find -L "${uploads[@]}" -type f ! -name '*.pem' ! -name '*.key' ! -name .env ! -name .DS_Store | sort -u)
    upload_kb=$(cd "$MAC_DATA" && du -skL "${uploads[@]}" | awk '{ s += $1 } END { print s }')
fi
# A Mac binary among the inputs cannot run on the pod: refused before any pod exists.
for f in "${files[@]}"; do
    case $(file -b "$MAC_DATA/$f") in
        Mach-O*) echo "rp-run: $MAC_DATA/$f is a Mac binary, which cannot run on a Linux pod; name the example as target/release/examples/${f##*/} (built on GitHub Actions)" >&2; exit 2 ;;
    esac
done
# Published inputs ("SHA256 REL") are downloaded by the pod; the rest go up from the Mac, at most
# UPLOAD_MAX_MB of them.
fetched=() unpublished_kb=0 FETCH_BYTES=0
if [ ${#files[@]} -gt 0 ]; then
    kept=()
    for f in "${files[@]}"; do
        sha=$(sha_of "$f")
        asset=$(asset_for "$sha")
        if [ -n "$asset" ]; then
            fetched+=("$asset $f $sha")
        else
            kept+=("$f")
            unpublished_kb=$(( unpublished_kb + $(stat -L -f %z "$MAC_DATA/$f") / 1024 ))
        fi
    done
    files=("${kept[@]}")
    # What the pod downloads: a u16 asset is a quarter of its float64 file, an f32 one half.
    FETCH_BYTES=$(for e in "${fetched[@]}"; do read -r a f _ <<< "$e"; z=$(stat -L -f %z "$MAC_DATA/$f"); case $a in *.u16) echo $(( z / 4 )) ;; *.f32) echo $(( z / 2 )) ;; *) echo "$z" ;; esac; done | awk '{ s += $1 } END { print s + 0 }')
    if (( unpublished_kb > UPLOAD_MAX_MB * 1024 )); then
        # A Pile export is published whole (the pod then downloads it instead of building it).
        echo "rp-run: $(( unpublished_kb / 1024 )) MB of inputs would go up from the Mac (at most $UPLOAD_MAX_MB MB); publish them once (public inputs only), then launch: rp-run publish $(printf "$MAC_DATA/%s " "${uploads[@]}" $(printf 'engine/%s\n' "${pile[@]}" | sort -u))" >&2
        exit 2
    fi
fi
for e in "${fw_fetched[@]}"; do
    fetched+=("$e")
    read -r _ f _ <<< "$e"
    FETCH_BYTES=$(( FETCH_BYTES + fetch_size[$f] ))
done
# Each shard the pod tokenizes is tokenized once more, whole (every window length), on a free GitHub
# Actions runner at the same commit, checked against the release's sha256s and published to
# rp-run-data by gha-run.yml's data step, so later runs download it. One dispatch per shard in 6 h
# ($RP/fineweb_publish/SHARD's time); the dispatch runs in the background. The runner's pip (22.0 on
# ubuntu-22.04) fails to resolve the set, so a current pip is installed first.
if [ ${#fw_publish[@]} -gt 0 ] && [ -z "${RP_DRY:-}" ] && [ -z "${RP_ESTIMATE_ONLY:-}" ]; then
    mkdir -p "$RP/fineweb_publish"
    for e in "${fw_publish[@]}"; do
        IFS='|' read -r d k n ts sums <<< "$e"
        m=$RP/fineweb_publish/$d
        [ -f "$m" ] && (( $(date +%s) - $(stat -f %m "$m") < 21600 )) && continue
        touch "$m"
        lines=$(tr ';' '\n' <<< "$sums" | sed '/^$/d' | sed "s/.*/'&'/" | tr '\n' ' ')
        cmd="python3 -m pip install -q --user --upgrade pip && python3 -m pip install -q --user 'numpy>=2' pyarrow huggingface_hub tokenizers && python3 bench/mpd_qwen3_fineweb_2951.py --file $k --documents $n --context ${ts//,/ } --out \$OUT/shard --workers 4 && cd \$OUT/shard && printf '%s\\n' $lines| sha256sum -c --quiet && mkdir -p \$OUT/rp-run-data && for f in *; do mv \"\$f\" \"\$OUT/rp-run-data/\$(sha256sum \"\$f\" | cut -c1-64)\"; done"
        ( GHA_REF=$C "${SELF%/*}/gha-run" "fineweb-publish-$d" -- "$cmd" >> "$RP/fineweb_publish/dispatch.log" 2>&1 & )
    done
fi
hf_kb=0
for p in "${hf[@]}"; do
    [ -e "$p" ] || { echo "rp-run: $p is not on this Mac (the pod fetches the files the Mac's snapshot holds)" >&2; exit 2; }
    hf_kb=$(( hf_kb + $(du -skL "$p" | cut -f1) ))
done
# The container disk: the toolchain and a release build of the workspace (measured under 20 GB;
# a dev pod also builds the test profile, a second target directory), with room for the inputs,
# the models fetched and the outputs (as large again as the inputs).
# A Python environment (RP_PYENV=NAME: the pinned set bench/runpod/pyenv/NAME.txt at the commit,
# whose first line states its installed size, measured) and Hugging Face models the pod fetches by
# name (RP_HF_MODELS="ORG/NAME[@REVISION] ...", their sizes from Hugging Face's listing).
pyenv_kb=0 models_kb=0 PYENV_REQS="" PYENV_DIR=""
if [ -n "${RP_PYENV:-}" ]; then
    [[ $RP_PYENV =~ ^[A-Za-z0-9._-]+$ ]] || { echo "rp-run: RP_PYENV names a file under bench/runpod/pyenv/" >&2; exit 2; }
    PYENV_REQS=$(git -C "$MAC_GAM" show "$C:bench/runpod/pyenv/$RP_PYENV.txt" 2> /dev/null) || { echo "rp-run: no bench/runpod/pyenv/$RP_PYENV.txt at ${C:0:12}" >&2; exit 2; }
    gb=$(sed -nE '1s/^# installed size: ([0-9]+) GB.*/\1/p' <<< "$PYENV_REQS")
    [ -n "$gb" ] || { echo "rp-run: bench/runpod/pyenv/$RP_PYENV.txt must state its installed size on its first line (# installed size: N GB)" >&2; exit 2; }
    pyenv_kb=$(( gb * 1048576 ))
    # A set whose torch is built for a newer CUDA than the image's takes only hosts whose driver
    # supports that CUDA ("# cuda: X.Y" in its first lines).
    need=$(sed -nE '1,5s/^# cuda: ([0-9]+[.][0-9]+).*/\1/p' <<< "$PYENV_REQS")
    [ -z "$need" ] || CUDA_OK=$(jq -c --arg t "$need" 'map(select((split(".") | map(tonumber)) >= ($t | split(".") | map(tonumber))))' <<< "$CUDA_OK")
    # One environment per pinned set, shared by the runs on a pod.
    PYENV_DIR=/workspace/pyenv/$(shasum <<< "$PYENV_REQS" | cut -c1-12)
fi
for m in ${RP_HF_MODELS:-}; do
    repo=${m%@*} rev=main
    [[ $m == *@* ]] && rev=${m#*@}
    b=$(curl -fsS --max-time 30 "https://huggingface.co/api/models/$repo/revision/$rev?blobs=true" | jq -e '[.siblings[].size // 0] | add') ||
        { echo "rp-run: Hugging Face lists no model $repo at $rev" >&2; exit 2; }
    models_kb=$(( models_kb + b / 1024 ))
done
base=30
[ "$MODE" = dev ] && base=60
DISK=$(( base + (2 * (upload_kb + hf_kb) + data_kb + pyenv_kb + models_kb + 1048575) / 1048576 ))
# A command whose outputs outgrow that (a fit's checkpoints and kept targets) states its own.
if [ -n "${RP_DISK_GB:-}" ]; then
    [[ $RP_DISK_GB =~ ^[0-9]+$ ]] && (( RP_DISK_GB >= DISK )) || { echo "rp-run: RP_DISK_GB must be a whole number of GB, at least $DISK" >&2; exit 2; }
    DISK=$RP_DISK_GB
fi
# Thunder's and Nebius's offers repriced for that disk (the estimate follows).
if grep -qE '^(THUNDER|NEBIUS)\|' <<< "$OFFERS"; then
    others=$(provider_offers "$DISK")
    OFFERS=$(awk -F'|' 'NR == FNR { p[$3] = $2; next } $1 == "THUNDER" || $1 == "NEBIUS" { if (!($3 in p)) next; $2 = p[$3] } { print }' OFS='|' <(printf '%s\n' "$others") - <<< "$OFFERS")
    [ -n "$OFFERS" ] || { echo "rp-run: no offer passes the ceilings with $DISK GB of disk" >&2; exit 2; }
    PRICE_MAX=$(awk -F'|' '$2 > m { m = $2 } END { print m }' <<< "$OFFERS")
    ESTIMATE=$(awk -v p="$PRICE_MAX" -v h="$HOURS" 'BEGIN { printf "%.2f", p * h }')
fi

# The pod deletes itself at the run's deadline by its own clock, then starts as the image would.
create_body() {  # CLOUD GPU_ID SECONDS_LEFT PUBLIC_KEYS
    local start="(echo \$BASHPID > /rp-watchdog.pid; sleep $3; runpodctl remove pod \"\$RUNPOD_POD_ID\" || runpodctl pod delete \"\$RUNPOD_POD_ID\") > /rp-watchdog.log 2>&1 & exec /start.sh"
    # Rust builds and the host half of a step want more than the default 2 vCPUs and 8 GB per GPU.
    jq -nc --arg name "mpd2951-$NAME" --arg image "$IMAGE" --arg gpu "$2" --arg cloud "${1%%:*}" \
        --arg keys "$4" --argjson disk "$DISK" --arg start "$start" --argjson cuda "$CUDA_OK" --argjson ram "${RP_MIN_RAM_GB:-32}" \
        '{name: $name, imageName: $image, computeType: "GPU", gpuTypeIds: [$gpu], gpuCount: 1, cloudType: $cloud,
          containerDiskInGb: $disk, volumeInGb: 0, ports: ["22/tcp"], supportPublicIp: true,
          env: {PUBLIC_KEY: $keys}, dockerStartCmd: ["bash", "-c", $start], allowedCudaVersions: $cuda,
          minVCPUPerGPU: 8, minRAMPerGPU: $ram}'
}

# A batch prices its runs first (RP_ESTIMATE_ONLY) and checks the budget once for all of them; its
# runs (RP_BATCH) skip the check.
if [ -n "${RP_ESTIMATE_ONLY:-}" ]; then
    echo "$ESTIMATE"
    exit 0
fi
[ -n "${RP_BATCH:-}" ] || budget "$ESTIMATE" "this $MODE's estimate for $HOURS h"
echo "rp-run: $MODE $NAME; offers $(awk -F'|' '{ printf "%s%s %s $%s/h", (NR > 1 ? ", " : ""), $3, $1, $2 }' <<< "$OFFERS"); estimate \$$ESTIMATE for $HOURS h" >&2
if [ -n "${RP_DRY:-}" ]; then
    echo "commit:   ${C:-none}"
    echo "uploads:  ${uploads[*]:-none}: ${#fetched[@]} files published (the pod downloads them), ${#files[@]} files ($(( unpublished_kb / 1024 )) MB) from the Mac"
    echo "hf:       ${hf[*]:-none}"
    built=$( for e in "${fw_plan[@]}"; do IFS='|' read -r d k n ts _ <<< "$e"; printf 'qwen3_fineweb/%s (FineWeb file %s, %s documents, contexts %s) ' "$d" "$k" "$n" "$ts"; done
             for e in "${pile_plan[@]}"; do read -r x b m <<< "$e"; printf 'engine/%s (from %s and %s Pile train rows) ' "$x" "$b" "$m"; done )
    echo "built:    ${built:-none}"
    echo "publish:  $( for e in "${fw_publish[@]}"; do printf 'qwen3_fineweb/%s ' "${e%%|*}"; done )(tokenized whole on GitHub Actions and published to rp-run-data, once per 6 h)"
    if (( NEED_RUST )); then
        echo "source:   crates Cargo.toml Cargo.lock rust-toolchain.toml src build.rs bench/cargo_benches docs/rust-library-surface.md ${srcpaths[*]:-} (from GitHub)"
    else
        echo "source:   ${srcpaths[*]:-none} (from the Mac; the whole commit from GitHub only if the pod must compile)"
    fi
    need=$(unbuilt | tr '\n' ' ')
    [ -n "$need" ] && need="to build on GitHub Actions: $need" || need="all built"
    echo "binaries: $need (examples ${examples[*]:-none}, tests ${tests[*]:-none}, key $KEY)"
    echo "approval: $APPROVAL${SMALL:+ (a small run: $SMALL_WHY)}"
    echo "command:  ${cmd:-none}"
    echo "request:  $(IFS='|' read -r k p g <<< "$(head -n 1 <<< "$OFFERS")"; if [[ $g == thunder:* ]]; then thunder_body "$g" '<run key>'; elif [[ $g == nebius:* ]]; then nebius_request "${g#nebius:}" '<preset>' '<project>' '<subnet>' '<pricing policy>' '<run key>' "mpd2951-$NAME"; else create_body "$k" "$g" "$CAP_SECONDS" '<run key> <~/.ssh/runpod_ed25519.pub>'; fi)"
    exit 0
fi

mkdir -p "$OUT"
LOG=$OUT/run.log
: > "$LOG"
rm -f "$OUT/data.log"
say() { echo "rp-run: $*" >&2; echo "$(date '+%F %T') $*" >> "$OUT/rp-run.log"; }
TMP=$(mktemp -d /tmp/rp-run.XXXXXX)
ssh-keygen -q -t ed25519 -N '' -C "rp-run $NAME" -f "$TMP/key"
chmod 600 "$TMP/key"
KEYS="$( [ -f "$TMP/key.pub" ] && cat "$TMP/key.pub")"$'\n'"$(cat ~/.ssh/runpod_ed25519.pub)"
POD="" IP="" PORT="" VCPU="" ATTEMPTED=0 DEADLINE="" SYNC="" PRICE="" CREATED="" THUNDER_UNSURE=0 NEBIUS_UNSURE=0 GUEST=0 EARLY_FETCH="" EARLY_PYENV="" EARLY_RSYNC="" EARLY_BINS="" PROBE_A="" MED_RATE="" POD_HOST=""
POD_DC="" ATTEMPT_GPU="" ATTEMPT_KIND="" ATTEMPT_DONE=1 RUN_STARTED=0 REACH_WHY="" REACH_DC=""
SSH=(ssh -F none -i "$TMP/key" -o IdentitiesOnly=yes -o BatchMode=yes -o ForwardAgent=no -o ForwardX11=no
     -o UserKnownHostsFile="$TMP/known_hosts" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=20
     -o ServerAliveInterval=30 -o ServerAliveCountMax=4 -o LogLevel=ERROR)
# One shared connection for the control steps; the uploads open their own, in parallel.
# RunPod pods log in as root; Thunder instances as ubuntu (with sudo).
SSH_USER=root
on_pod() { "${SSH[@]}" -o ControlMaster=auto -o ControlPath="$TMP/cm-%C" -o ControlPersist=600 -p "$PORT" "$SSH_USER@$IP" "$@"; }
new_conn() { "${SSH[@]}" -o ControlPath=none -p "$PORT" "$SSH_USER@$IP" "$@"; }

finish() {
    local rc=$?
    trap - EXIT INT TERM HUP
    set +e
    [ -n "$SYNC" ] && kill $SYNC 2> /dev/null
    # The log stream, the idle check and other helpers end with the run.
    kill $(jobs -p) 2> /dev/null
    if (( RUN_STARTED )); then attempt_end worked "command ran"; else attempt_end ended "runner ended before the command (status $rc)"; fi
    if [ -n "$POD" ] && [ ! -f "$ACTIVE/.$POD.end" ] && (( ! GUEST )); then
        if [ -f "$OUT/STOP" ]; then echo stopped; elif [ -n "${RC:-}" ]; then echo "exit $RC"; else echo "exit $rc"; fi > "$ACTIVE/.$POD.end"
    fi
    # A pod another run still uses stays up: this run's command, if still running, is stopped.
    if [ -n "$IP" ] && [ -n "$(holders "$POD")" ]; then
        on_pod "p=\$(cat $WS/run.pid 2> /dev/null) && kill -TERM -- -\$p" < /dev/null > /dev/null 2>&1
    fi
    (( ! GUEST )) || rm -f "$ACTIVE/.$POD.guests/$NAME"
    if [ -n "$IP" ]; then on_pod -O exit > /dev/null 2>&1; fi
    if [ -z "$POD" ] && (( ATTEMPTED )); then
        # A create whose answer was lost (a timeout) may still have made a pod. Its id never reached
        # the registry, so the runner does not touch it: it is named for a person to check.
        local r id
        r=$(api GET "$REST/pods")
        while read -r id; do
            [ -n "$id" ] && ! registered "$id" || continue
            say "POD $id is named mpd2951-$NAME but its creation was not recorded; check it at https://console.runpod.io/pods"
            rc=1
        done < <(jq -r --arg n "mpd2951-$NAME" '.[]? | select(.name == $n) | select(.desiredStatus == "RUNNING") | .id' <<< "$(body_of "$r")" 2> /dev/null)
    fi
    if (( THUNDER_UNSURE )); then
        # Thunder instances carry no name, so every one the registry lacks is named.
        local st
        while read -r id st; do
            [ -n "$id" ] && ! registered "thunder-$id" || continue
            say "Thunder instance $id ($st) is not in the registry; if a create of this run made it, delete it at https://console.thundercompute.com"
            rc=1
        done < <(thunder_instances)
    fi
    if (( NEBIUS_UNSURE )); then
        local st nm
        while read -r id st nm; do
            [ -n "$id" ] && [[ $nm == mpd2951-$(nebius_name)-* ]] && ! registered "nebius-$id" || continue
            say "Nebius instance $id ($nm, $st) is not in the registry; if a create of this run made it, delete it at https://console.nebius.com"
            rc=1
        done < <(nebius_instances)
    fi
    if [ -n "$POD" ]; then
        # The watcher sees this process end and finds nothing left to reap.
        reap "$POD" || rc=1
        # Any other pod this runner made that is still there.
        local r
        r=$(api GET "$REST/pods")
        if [ "$(status_of "$r")" = 200 ]; then
            while read -r id pname st; do
                if [ -f "$ACTIVE/$id" ]; then
                    say "pod $id ($pname, $st) belongs to a run in progress"
                elif registered "$id"; then
                    say "POD $id ($pname, $st) is ours, REMAINS, and no run of this Mac holds it"
                    rc=1
                fi
            done < <(jq -r '.[] | select(.name | startswith("mpd2951-")) | select(.desiredStatus == "RUNNING") | "\(.id) \(.name) \(.desiredStatus)"' <<< "$(body_of "$r")")
        else
            say "could not list pods to confirm none remain"
            rc=1
        fi
        while read -r id st; do
            [ -n "$id" ] && registered "thunder-$id" && [ ! -f "$ACTIVE/thunder-$id" ] || continue
            say "POD thunder-$id ($st) is ours, REMAINS, and no run of this Mac holds it"
            rc=1
        done < <(thunder_instances)
        while read -r id st _; do
            [ -n "$id" ] && registered "nebius-$id" && [ ! -f "$ACTIVE/nebius-$id" ] || continue
            say "POD nebius-$id ($st) is ours, REMAINS, and no run of this Mac holds it"
            rc=1
        done < <(nebius_instances)
    fi
    rm -rf "$TMP"
    rm -f "$OUT/ssh" "$OUT/rsh" "$OUT/host" "$OUT/STOP" "$OUT/EXTEND"
    say "$NAME ended with status $rc; log $LOG"
    exit $rc
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# The end of POD's attempt, once (ATTEMPTS): OUTCOME, DETAIL (a third argument, "dc" when the data
# center's network is the likely cause, is read by no one now; the row's data center column is the
# record unit_risk weighs). A run sharing another run's pod writes none.
attempt_end() {  # OUTCOME DETAIL [dc]
    [ -n "$POD" ] && [ -z "$ATTEMPT_DONE" ] && (( ! GUEST )) || return 0
    ATTEMPT_DONE=1
    [ -f "$ATTEMPTS" ] || printf 'date\trun\tpod\tgpu\tcloud\thost\tdatacenter\tprice\tseconds\toutcome\tdetail\n' > "$ATTEMPTS"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$NAME" "$POD" "$ATTEMPT_GPU" "${ATTEMPT_KIND%%:*}" \
        "${POD_HOST:--}" "${POD_DC:--}" "${PRICE:--}" "$(( $(date +%s) - ${CREATED:-$(date +%s)} ))" "$1" "${2:-}" >> "$ATTEMPTS"
}

# The offer tried after KIND|GPU in OFFERS that this launch has not spent, as KIND|PRICE|GPU, or
# nothing when it is the last.
next_offer() {  # KIND GPU
    local k p g seen=0
    while IFS='|' read -r k p g; do
        if (( seen )); then
            [ -n "${spent[$k|$g]:-}" ] || { echo "$k|$p|$g"; return 0; }
        elif [ "$k|$g" = "$1|$2" ]; then
            seen=1
        fi
    done <<< "$OFFERS"
}

# Whether a new pod on HOST in data center DC costs more per token in expectation than the next
# offer, by the statistics rank_auto ranks offers with: over ATTEMPTS (outcomes other than ended and
# discarded, and not the old blocklist's own discards), a host with n attempts and m failures losing
# w seconds fails with probability f = (m + 2 F) / (n + 2) and costs W = (w + V) / (m + 1) seconds a
# failure, F = (M + 1) / (N + 2) and V = (U + W0) / (M + 1) its cloud's over all cards; a data center
# alike; the pod takes the larger f of the two with its W. Its expected cost per token is
# c (1 + f / (1 - f) W / L) (c its offer's dollars per scored token from the ranking, or its price
# when the run names its cards; L = HOURS in seconds), the next offer's the same with its own offer
# statistics. One failure in a data center with successes no longer bans it (12:19 10-06: one
# missing SSH address put CA-MTL-1, 4 successes before, on a permanent list and 10 pods were
# rejected). Prints the reason to discard the pod, or nothing (the last offer is always kept).
unit_risk() {  # HOST DC KIND PRICE GPU
    local next c cn
    next=$(next_offer "$3" "$5")
    [ -n "$next" ] || return 0
    c=$(awk -F'|' -v o="$3|$5" '$1 "|" $2 == o && $3 != "-" { print $3 }' <<< "${OFFER_PER:-}")
    cn=$(awk -F'|' -v o="$(cut -d'|' -f1,3 <<< "$next")" '$1 "|" $2 == o && $3 != "-" { print $3 }' <<< "${OFFER_PER:-}")
    [ -n "$c" ] && [ -n "$cn" ] || { c=$4; cn=$(cut -d'|' -f2 <<< "$next"); }
    awk -F'\t' -v h="$1" -v d="$2" -v cl="${3%%:*}" -v c="$c" -v cn="$cn" -v nx="$next" -v w0="$(ssh_wait)" -v L="$CAP_SECONDS" '
        NR > 1 && $10 != "" && $10 != "ended" && $10 != "discarded" && $11 != "host failed before" && $11 != "data center failed before" {
            fail = ($10 != "worked"); N[$5]++; M[$5] += fail; U[$5] += fail * $9
            if (h != "" && $6 == h) { nh++; mh += fail; wh += fail * $9 }
            if (d != "" && d != "-" && $7 == d) { nd++; md += fail; wd += fail * $9 }
            o = $4 "|" $5; no[o]++; mo[o] += fail; wo[o] += fail * $9
        }
        END {
            F = (M[cl] + 1) / (N[cl] + 2); V = (U[cl] + w0) / (M[cl] + 1)
            fh = (mh + 2 * F) / (nh + 2); fd = (md + 2 * F) / (nd + 2)
            if (fh >= fd) { f = fh; W = (wh + V) / (mh + 1) } else { f = fd; W = (wd + V) / (md + 1) }
            split(nx, q, "|"); k = q[1]; sub(/:.*/, "", k); on = q[3] "|" k
            Fn = (M[k] + 1) / (N[k] + 2); Vn = (U[k] + w0) / (M[k] + 1)
            fn = (mo[on] + 2 * Fn) / (no[on] + 2); Wn = (wo[on] + Vn) / (mo[on] + 1)
            this = c * (1 + f / (1 - f) * W / L); other = cn * (1 + fn / (1 - fn) * Wn / L)
            if (this > other) printf "failure probability %.2f (host %d of %d attempts failed, data center %d of %d) makes it cost %.4f against %.4f for the next offer, %s %s", f, mh, nh, md, nd, this, other, q[3], q[1]
        }' "$ATTEMPTS"
}

# Records POD in active/ (name gpu cloud price created owner estimate mode) and starts its watcher.
record() {  # GPU_ID KIND
    printf '%s\t%s\t%s\n' "$POD" "$NAME" "$(date '+%F %T')" >> "$REGISTRY"
    printf '%s %s %s %s %s %s %s %s\n' "$NAME" "${1// /_}" "$2" "$PRICE" "$CREATED" "$$" "$ESTIMATE" "$MODE" > "$ACTIVE/$POD"
    echo "${RP_OWNER:--}" > "$ACTIVE/.$POD.owner"
    echo "$APPROVAL" > "$ACTIVE/.$POD.approval"
    echo "$DEADLINE" > "$ACTIVE/.$POD.deadline"
    nohup "$SELF" --watch "$POD" "$$" "$DEADLINE" >> "$OUT/watch.log" 2>&1 &
}

# Whether POD was deleted (the API no longer knows it, or records a termination) rather than lost
# by its host (exited by RunPod, or running but unreachable).
deleted() { [ "$(pod_state "$1")" = GONE ]; }

# Waits for SSH to POD (sets IP PORT VCPU) as long as a new pod may take (ssh_wait).
reach() {
    local r b st limit
    limit=$(ssh_wait)
    until [ -n "$IP" ]; do
        (( $(date +%s) - CREATED < limit )) || { say "no public SSH address after $limit s (the slowest pod measured plus the median)"; REACH_WHY="no public SSH address" REACH_DC=dc; return 1; }
        if [ "$(provider_of "$POD")" = thunder ]; then
            r=$(tapi GET /instances/list)
            if [ "$(status_of "$r")" = 200 ]; then
                b=$(jq -c --arg id "${POD#thunder-}" '.[$id] // empty' <<< "$(body_of "$r")")
                if [ -n "$b" ] && [ "$(jq -r '.status // "" | ascii_upcase' <<< "$b")" = RUNNING ]; then
                    IP=$(jq -r '.ip // empty' <<< "$b")
                    PORT=$(jq -r '.port // 22' <<< "$b")
                    VCPU=$(jq -r '.cpuCores // empty' <<< "$b")
                    [ -n "$IP" ] && jq -c . <<< "$b" >> "$OUT/pod.json"
                fi
            fi
            [ -n "$IP" ] || sleep 5
            continue
        fi
        if [ "$(provider_of "$POD")" = nebius ]; then
            r=$(napi GET "/compute/v1/instances/${POD#nebius-}")
            if [ "$(status_of "$r")" = 200 ]; then
                b=$(body_of "$r")
                st=$(jq -r '.status.state // ""' <<< "$b")
                case $st in STOPPING|STOPPED|ERROR|DELETING) say "VM is $st"; return 1 ;; esac
                if [ "$st" = RUNNING ]; then
                    IP=$(jq -r '(.status.networkInterfaces // [])[0].publicIpAddress.address // empty | sub("/.*"; "")' <<< "$b")
                    PORT=22
                    [ -n "$IP" ] && jq -c . <<< "$b" >> "$OUT/pod.json"
                fi
            fi
            [ -n "$IP" ] || sleep 5
            continue
        fi
        r=$(api GET "$REST/pods/$POD")
        if [ "$(status_of "$r")" = 200 ]; then
            b=$(body_of "$r")
            st=$(jq -r .desiredStatus <<< "$b")
            [ "$st" = RUNNING ] || { say "pod is $st ($(jq -r '.lastStatusChange // ""' <<< "$b"))"; REACH_WHY="pod $st" REACH_DC=""; return 1; }
            [ -n "$POD_DC" ] || POD_DC=$(jq -r '.machine.dataCenterId // empty' <<< "$b")
            IP=$(jq -r '.publicIp // empty' <<< "$b")
            PORT=$(jq -r '.portMappings["22"] // empty' <<< "$b")
            VCPU=$(jq -r '.vcpuCount // empty' <<< "$b")
            [ -n "$PORT" ] || IP=""
            [ -n "$IP" ] && jq 'del(.env)' <<< "$b" >> "$OUT/pod.json"
        fi
        # Every 2 s: the address appears 8-56 s after creation, and each second waited is paid.
        [ -n "$IP" ] || sleep 2
    done
    # An address whose pods never answered SSH (two hosts behind 80.15.7.37 each held a GPU for
    # 300 s) is left at once.
    if grep -qxF "$IP" "$BAD_IPS" 2> /dev/null; then
        say "SSH address $IP never answered before"
        REACH_WHY="SSH address failed before" REACH_DC=""
        return 1
    fi
    until on_pod true < /dev/null 2> /dev/null; do
        if (( $(date +%s) - CREATED >= limit )); then
            echo "$IP" >> "$BAD_IPS"
            say "SSH to $IP:$PORT not answering after $limit s (the slowest pod measured plus the median); $IP recorded"
            REACH_WHY="SSH not answering" REACH_DC=dc
            return 1
        fi
        sleep 2
    done
    printf '%s\t%s\t%s\n' "$(date '+%F %T')" "${POD_HOST:-}" "$(( $(date +%s) - CREATED ))" >> "$SSH_UP"
    say "ssh $SSH_USER@$IP -p $PORT up after $(( $(date +%s) - CREATED )) s"
    # The published inputs start downloading now, while the pod's checks run (setup waits for them;
    # a pod the checks discard takes its partial download with it). A Thunder or Nebius machine's
    # login is not root: /workspace is made for it first.
    [ "$(provider_of "$POD")" = runpod ] || on_pod 'sudo mkdir -p /workspace && sudo chown "$(id -u):$(id -g)" /workspace' < /dev/null > /dev/null 2>&1
    if [ ${#fetched[@]} -gt 0 ] && [ -z "$EARLY_FETCH" ]; then
        fetch_published & EARLY_FETCH=$!
    fi
    # So do the published binaries (planned before the first pod).
    if (( BIN_PLANNED )) && [ ${#BIN_ASSETS[@]} -gt 0 ] && [ -z "$EARLY_BINS" ]; then
        fetch_binaries & EARLY_BINS=$!
    fi
    # So do the Python environment and the models (19-106 s), which need nothing from the checks,
    # rsync (for syncing outputs; apt-get takes about 5 s), and gpu_in_use's five samples (5 s).
    if { [ -n "$PYENV_DIR" ] || [ -n "${RP_HF_MODELS:-}" ]; } && [ -z "$EARLY_PYENV" ]; then
        python_env & EARLY_PYENV=$!
    fi
    on_pod 'S=$(command -v sudo || true); command -v rsync > /dev/null || { $S apt-get update -qq && $S apt-get install -y -qq rsync; } > /dev/null 2>&1' < /dev/null & EARLY_RSYNC=$!
    on_pod "mkdir -p $WS && for i in 1 2 3 4 5; do nvidia-smi --query-gpu=utilization.gpu,memory.free,power.limit,power.default_limit,memory.total --format=csv,noheader,nounits | head -n 1; sleep 1; done > $WS/.gpu-probe.part; mv $WS/.gpu-probe.part $WS/.gpu-probe" < /dev/null > /dev/null 2>&1 &
    # The first sample of the host's receive rate (fetch_too_slow takes the next after the checks).
    PROBE_A=""
    [ -z "$EARLY_FETCH" ] || PROBE_A=$(probe_bytes) || PROBE_A=""
}

# The pod's own cap. A RunPod pod's timer starts with its container (dockerStartCmd: runpodctl with
# the pod's own key deletes it); this checks it runs. A Thunder or Nebius machine gets no key, so it
# is told to shut down at the deadline, and its /workspace is made (RunPod's image has one).
own_timer() {
    if [ "$(provider_of "$POD")" = runpod ]; then
        on_pod 'kill -0 "$(cat /rp-watchdog.pid)" && command -v runpodctl > /dev/null' < /dev/null
    else
        on_pod 'sudo mkdir -p /workspace && sudo chown "$(id -u):$(id -g)" /workspace' < /dev/null > /dev/null 2>&1 && arm $(( DEADLINE - $(date +%s) ))
    fi
}

# A Thunder instance's request (GPU thunder:CARD:MODE): one GPU, the vCPUs THUNDER_CORES picks, the
# run's disk (at least Thunder's least), the CUDA 12.8 template, the run's public KEY.
thunder_body() {  # GPU KEY
    local card mode spec
    IFS=: read -r _ card mode <<< "$1"
    spec=$(curl -sS --max-time 30 "$THUNDER/specs" | jq -c --arg k "${card}_x1_$mode" '.specs[$k] // empty')
    [ -n "$spec" ] || { echo "rp-run: Thunder lists no spec ${card}_x1_$mode" >&2; return 1; }
    jq -nc --arg mode "$mode" --arg gpu "$card" --arg key "$2" --argjson spec "$spec" --argjson disk "$DISK" --argjson ram "${RP_MIN_RAM_GB:-32}" "$THUNDER_CORES"'
        {gpu_type: $gpu, mode: $mode, num_gpus: 1, cpu_cores: cores($spec; $ram),
         disk_size_gb: ([$disk, ($spec.storageGB.min // 100)] | max), template: "cuda12-8", public_key: $key}'
}

# Nebius: creates a VM of PLATFORM for this run (preset, subnet and pricing policy looked up now);
# sets POD, VCPU, NEBIUS_OP (the create's operation), NEBIUS_CODE, CREATED, DEADLINE, and r.
nebius_name() { tr 'A-Z' 'a-z' <<< "$NAME" | tr -c 'a-z0-9-\n' '-'; }
nebius_create() {  # PLATFORM
    local project subnet policy preset vcpu
    NEBIUS_CODE=000 NEBIUS_OP=""
    project=$(nebius_project) || return 0
    subnet=$(nebius_subnet "$project") || { r="no subnet in project $project"$'\n'"000"; return 0; }
    policy=$(nebius_policy "$project" "$1") || { r="no pricing policy"$'\n'"000"; return 0; }
    r=$(napi GET "/compute/v1/platforms/get-by-name?parentId=$project&name=$1")
    read -r preset vcpu < <(jq -r --argjson ram "${RP_MIN_RAM_GB:-32}" "$NEBIUS_PRESET"'preset(.; $ram) | "\(.name) \(.resources.vcpuCount)"' <<< "$(body_of "$r")" 2> /dev/null) || true
    [ -n "$preset" ] || { r="no one-GPU preset of $1 with ${RP_MIN_RAM_GB:-32} GiB"$'\n'"000"; return 0; }
    r=$(napi POST /compute/v1/instances "$(nebius_request "$1" "$preset" "$project" "$subnet" "$policy" "$(cat "$TMP/key.pub")" "mpd2951-$(nebius_name)-$(date +%s)")")
    NEBIUS_CODE=$(status_of "$r")
    if [[ $NEBIUS_CODE == 2* ]] && [ -n "$(jq -r '.resourceId // empty' <<< "$(body_of "$r")")" ]; then
        CREATED=$(date +%s)
        DEADLINE=${DEADLINE:-$(( CREATED + CAP_SECONDS ))}
        POD=nebius-$(jq -r '.resourceId' <<< "$(body_of "$r")")
        NEBIUS_OP=$(jq -r '.id' <<< "$(body_of "$r")")
        VCPU=$vcpu
    fi
}
# Waits for a Nebius operation to finish; true when it succeeded.
nebius_settled() {  # OPERATION
    local r b
    while :; do
        r=$(napi GET "/compute/v1/instances/operations/$1")
        if [ "$(status_of "$r")" = 200 ]; then
            b=$(body_of "$r")
            if [ -n "$(jq -r '.finishedAt // empty' <<< "$b")" ]; then
                [ "$(jq -r '.status.code // 0' <<< "$b")" = 0 ] && return 0
                say "Nebius refused the VM: $(jq -r '.status.message // ""' <<< "$b" | head -c 200)"
                return 1
            fi
        fi
        (( $(date +%s) - CREATED < 300 )) || { say "the VM's creation had not finished after 5 minutes"; return 1; }
        sleep 5
    done
}

# Packing: a run that states the GPU memory it needs (RP_MIN_VRAM_GB) runs on a pod of ours that is
# already up, instead of a new one, when that pod's GPU is one the run takes (its listed types; under
# auto, any card the ranking offers), averaged under 20% over the last 5 minutes (the idle line), has
# RP_MIN_VRAM_GB of GPU memory and the run's disk free, and has the run's HOURS left before its cap.
# Of those, the least busy GPU. RP_PACK=0 always takes a pod of its own. Prints the pod, or nothing.
PACK_GPU=20 PACK_WINDOW=300

# Whether a new pod's GPU is in use by something else or held below its power: over 5 one-second
# samples before anything of ours runs on it, mean utilization at or above the idle line (PACK_GPU),
# a power limit below the card's default (a host found at 153 W of 450 W ran 5x slower), or more
# than 1 GiB of its memory in use (total less free; an idle card's driver holds 0.5-0.6 GiB: 484 MiB
# of a 4090's 24564, 610 of an A40's 46068). The card's size is the offers' (RP_MIN_VRAM_GB against
# its nominal memoryInGb): comparing free MiB with RP_MIN_VRAM_GB x 1024 failed every idle 24 GB
# 4090 (24080 MiB free) and 48 GB L40S or A40 (45458) and recorded its host as failing. Prints the
# reason, or nothing.
gpu_in_use() {
    on_pod "timeout 30 sh -c 'until [ -f $WS/.gpu-probe ]; do sleep 0.2; done' && cat $WS/.gpu-probe" < /dev/null 2> /dev/null |
        awk -F', *' -v idle="$PACK_GPU" -v need="${RP_MIN_VRAM_GB:-0}" '
            { u += $1; n++; free = $2; lim = $3; def = $4; total = $5 }
            END {
                if (!n) exit
                if (u / n >= idle) printf "utilization %d%% with no run of ours; ", u / n
                if (lim ~ /^[0-9.]+$/ && def ~ /^[0-9.]+$/ && lim + 0 < def + 0) printf "power limit %s W of its default %s W; ", lim, def
                if (total ~ /^[0-9.]+$/ && free ~ /^[0-9.]+$/ && total - free > 1024) printf "%d MiB of its %d MiB in use with no run of ours; ", total - free, total
            }' | sed 's/; $//'
}
find_host() {
    local rec pod g dl ip port tmp user util free disk best="" bestu="" now
    [ "$MODE" = run ] && [ -n "${RP_MIN_VRAM_GB:-}" ] && [ "${RP_PACK:-1}" != 0 ] || return 0
    now=$(date +%s)
    for rec in "$ACTIVE"/*; do
        [ -f "$rec" ] || continue
        pod=${rec##*/}
        [ -f "$ACTIVE/.$pod.ssh" ] && [ -f "$ACTIVE/.$pod.deadline" ] && [ -n "$(holders "$pod")" ] || continue
        read -r _ g _ < "$rec"
        cut -d'|' -f3 <<< "$OFFERS" | grep -qxF "${g//_/ }" || continue
        dl=$(cat "$ACTIVE/.$pod.deadline")
        (( dl - now >= CAP_SECONDS )) || continue
        read -r ip port tmp user < "$ACTIVE/.$pod.ssh"
        [ -f "$tmp/key" ] || continue
        read -r util free disk < <(ssh -F none -i "$tmp/key" -o IdentitiesOnly=yes -o BatchMode=yes -o UserKnownHostsFile="$tmp/known_hosts" \
            -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8 -o LogLevel=ERROR -p "$port" "${user:-root}@$ip" \
            "awk -v t=\$(( \$(date +%s) - $PACK_WINDOW )) '\$1 >= t && NF == 2 { s += \$2; n++ } END { printf \"%d \", (n ? s / n : 100) }' /workspace/gpu-util.log;
             nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits | head -n 1 | tr '\n' ' ';
             df -BG --output=avail /workspace | tail -n 1 | tr -dc 0-9" < /dev/null 2> /dev/null) || continue
        [ -n "$disk" ] || continue
        (( util < PACK_GPU && free >= RP_MIN_VRAM_GB * 1024 && disk >= DISK )) || continue
        if [ -z "$bestu" ] || (( util < bestu )); then best=$pod bestu=$util; fi
    done
    echo "$best"
}
# Runs this run on POD beside the run that holds it: authorizes the run's key there (through the
# holder's), records the run as a guest of the pod, and starts its watcher at its own HOURS.
attach() {  # POD
    local ip port tmp user holder
    read -r ip port tmp user < "$ACTIVE/.$1.ssh"
    read -r holder _ < "$ACTIVE/$1"
    ssh -F none -i "$tmp/key" -o IdentitiesOnly=yes -o BatchMode=yes -o UserKnownHostsFile="$tmp/known_hosts" -o StrictHostKeyChecking=accept-new \
        -o ConnectTimeout=10 -o LogLevel=ERROR -p "$port" "${user:-root}@$ip" 'cat >> ~/.ssh/authorized_keys' < "$TMP/key.pub" 2> /dev/null || return 1
    POD=$1 IP=$ip PORT=$port SSH_USER=${user:-root} GUEST=1
    on_pod true < /dev/null 2> /dev/null || { POD="" IP="" GUEST=0; return 1; }
    CREATED=$(date +%s)
    DEADLINE=$(( CREATED + CAP_SECONDS ))
    mkdir -p "$ACTIVE/.$POD.guests"
    echo "$$" > "$ACTIVE/.$POD.guests/$NAME"
    nohup "$SELF" --watch "$POD" "$$" "$DEADLINE" "$NAME" >> "$OUT/watch.log" 2>&1 &
    VCPU=$(on_pod nproc < /dev/null 2> /dev/null || true)
    say "packed onto pod $POD (run $holder's), GPU under $PACK_GPU% for the last $(( PACK_WINDOW / 60 )) minutes; this run adds no pod and no cost; it ends by $(date -r "$DEADLINE" '+%F %T')"
    echo "$POD shared with $holder" >> "$OUT/pod.txt"
}

# A pod in stock on a host that works: reachable by SSH, its own deletion timer armed, and CUDA
# initializing (a host whose CUDA does not start fails every program; one did, with PyTorch too). A
# pod on a host or data center whose record in ATTEMPTS makes it cost more per token in expectation
# than the next offer (unit_risk), or that fails now, is deleted and the next offer tried; every
# attempt's end is recorded there. Sets POD IP PORT VCPU PRICE.
# Signals wait while a pod is created, so none can end the run between its creation and its record.
launch() {
    local kind price gpu r code left host
    # Offers whose pod landed on a host, data center or address that failed before: RunPod's stock of
    # that offer is that machine for now (frontier-gn-n32768-line6 got host l5bnouhrol1e three times
    # running), so this launch does not ask for it again, and such a discard, which costs seconds,
    # does not count against DISCARDS.
    local -A spent=()
    # A listed run relaunches only while still listed; a small run's approval covers its whole cap.
    [ "$APPROVAL" = auto ] || approved "$NAME" || { say "approval for $NAME withdrawn; not launching a pod"; exit 3; }
    POD="" IP="" PORT="" EARLY_FETCH="" EARLY_PYENV="" EARLY_RSYNC="" EARLY_BINS="" PROBE_A=""
    POD_DC="" REACH_WHY="" REACH_DC="" RUN_STARTED=0
    rm -f "$TMP/upload_s" "$TMP/data_s" "$TMP/refused"
    host=$(find_host)
    if [ -n "$host" ] && attach "$host"; then
        return 0
    fi
    POD="" IP="" PORT="" GUEST=0
    # The first pod must be in stock now; a replacement waits for stock while time remains.
    API_FAILED=0
    until [ -n "$POD" ]; do
    while IFS='|' read -r kind price gpu <&3; do
        [ -z "${spent[$kind|$gpu]:-}" ] || continue
        left=$(( ${DEADLINE:-$(( $(date +%s) + CAP_SECONDS ))} - $(date +%s) ))
        (( left > 0 )) || { say "no time left under the HOURS cap"; exit 1; }
        trap '' INT TERM HUP
        ATTEMPTED=$(date +%s)
        host=""
        if [[ $gpu == nebius:* ]]; then
            nebius_create "${gpu#nebius:}"
            code=${NEBIUS_CODE:-000}
            if [ -n "$POD" ]; then
                PRICE=$price
                record "$gpu" "$kind"
                # The create's operation: a VM refused (no capacity, the bid under the market) is deleted.
                if ! nebius_settled "$NEBIUS_OP"; then
                    echo create-failed > "$ACTIVE/.$POD.end"
                    reap "$POD" || exit 1
                    POD=""
                fi
            elif [[ $code != 4* ]]; then
                NEBIUS_UNSURE=1
            fi
        elif [[ $gpu == thunder:* ]]; then
            r=$(tapi POST /instances/create "$(thunder_body "$gpu" "$(cat "$TMP/key.pub")")")
            code=$(status_of "$r")
            if [[ $code == 2* ]] && [ -n "$(jq -r '.identifier // empty' <<< "$(body_of "$r")")" ]; then
                CREATED=$(date +%s)
                DEADLINE=${DEADLINE:-$(( CREATED + CAP_SECONDS ))}
                POD=thunder-$(jq -r '.identifier' <<< "$(body_of "$r")")
                PRICE=$price
                record "$gpu" "$kind"
            elif [[ $code != 4* ]]; then
                # No answer, or one without an id: an instance may exist that the registry lacks.
                THUNDER_UNSURE=1
            fi
        else
            r=$(api POST "$REST/pods" "$(create_body "$kind" "$gpu" "$left" "$KEYS")")
            code=$(status_of "$r")
            if [[ $code == 2* ]]; then
                CREATED=$(date +%s)
                DEADLINE=${DEADLINE:-$(( CREATED + CAP_SECONDS ))}
                POD=$(jq -r .id <<< "$(body_of "$r")")
                PRICE=$(jq -r '.costPerHr // .adjustedCostPerHr // empty' <<< "$(body_of "$r")")
                PRICE=${PRICE:-$price}
                host=$(jq -r '.machineId // empty' <<< "$(body_of "$r")")
                POD_DC=$(jq -r '.machine.dataCenterId // empty' <<< "$(body_of "$r")")
                record "$gpu" "$kind"
            fi
        fi
        trap 'exit 130' INT
        trap 'exit 143' TERM
        trap 'exit 129' HUP
        if [ -z "$POD" ]; then
            # A server error that is not a stock answer may pass (RunPod's "Something went wrong").
            if [[ $code == 5* ]] && ! grep -qE 'no instances currently available|does not have the resources' <<< "$(body_of "$r")"; then API_FAILED=1; fi
            say "no $gpu on ${kind%%:*} ($code): $(body_of "$r" | head -c 200)"
            continue
        fi
        say "pod $POD: ${gpu#thunder:}, $kind at \$$PRICE/h, host ${host:-?}${POD_DC:+, data center $POD_DC}"
        ATTEMPT_GPU=$gpu ATTEMPT_KIND=$kind ATTEMPT_DONE="" RUN_STARTED=0
        SSH_USER=root
        [ "$(provider_of "$POD")" = runpod ] || SSH_USER=ubuntu
        POD_HOST=$host
        why=()
        if risk=$(unit_risk "$host" "$POD_DC" "$kind" "$price" "$gpu") && [ -n "$risk" ]; then
            say "host ${host:-?}${POD_DC:+ in $POD_DC}: $risk; deleting pod $POD"
            why=("discarded" "riskier than the next offer: $risk")
        elif slow_host "$host"; then
            why=("dead network" "host slow before")
            say "host $host was slow before (download $(awk -F'\t' -v h="$host" '$2 == h { r = $3 } END { print r }' "$RP/host_rates.tsv" 2> /dev/null) MB/s, Python install $(awk -F'\t' -v h="$host" '$2 == h { r = $3 } END { print r }' "$RP/host_installs.tsv" 2> /dev/null) s): another pod costs less; deleting pod $POD"
        elif ! reach; then
            say "host $host failed to come up; deleting pod $POD"
            why=("setup failed" "${REACH_WHY:-no SSH}" $REACH_DC)
        elif ! own_timer; then
            say "the pod's own cap is not armed; deleting pod $POD"
            why=("setup failed" "own cap not armed")
        elif ! on_pod 'python3 -c "import ctypes; c = ctypes.CDLL(\"libcuda.so.1\"); n = ctypes.c_int(); assert c.cuInit(0) == 0 and c.cuDeviceGetCount(ctypes.byref(n)) == 0 and n.value > 0"' < /dev/null > /dev/null 2>&1; then
            say "CUDA does not initialize on host ${host:-?} ($(on_pod 'nvidia-smi --query-gpu=driver_version --format=csv,noheader' < /dev/null 2> /dev/null)); deleting pod $POD"
            why=("broken driver" "CUDA does not initialize")
        elif ! on_pod 'ls /usr/local/cuda/lib64/libnvrtc.so* > /dev/null 2>&1 || ldconfig -p | grep -q libnvrtc' < /dev/null; then
            # The device code compiles through NVRTC at run time: an image without it cannot run it.
            say "the machine has no NVRTC (libnvrtc); deleting pod $POD"
            why=("broken driver" "no NVRTC")
        elif busy=$(gpu_in_use); [ -n "$busy" ]; then
            say "the GPU on host ${host:-?} is not free before the run ($busy); deleting pod $POD"
            why=("broken driver" "GPU not free: $busy")
        elif fetch_too_slow; then
            say "deleting pod $POD"
            why=("dead network" "inputs too slow")
        else
            break
        fi
        attempt_end "${why[@]}"
        [ -z "$IP" ] || on_pod -O exit > /dev/null 2>&1 || true
        [ -z "$EARLY_FETCH" ] || { kill "$EARLY_FETCH" 2> /dev/null || true; wait "$EARLY_FETCH" 2> /dev/null || true; EARLY_FETCH=""; }
        [ -z "$EARLY_PYENV" ] || { kill "$EARLY_PYENV" 2> /dev/null || true; wait "$EARLY_PYENV" 2> /dev/null || true; EARLY_PYENV=""; }
        [ -z "$EARLY_RSYNC" ] || { kill "$EARLY_RSYNC" 2> /dev/null || true; wait "$EARLY_RSYNC" 2> /dev/null || true; EARLY_RSYNC=""; }
        [ -z "$EARLY_BINS" ] || { kill "$EARLY_BINS" 2> /dev/null || true; wait "$EARLY_BINS" 2> /dev/null || true; EARLY_BINS=""; }
        rm -f "$TMP/upload_s" "$TMP/data_s" "$TMP/refused"
        echo discarded > "$ACTIVE/.$POD.end"
        reap "$POD" || exit 1
        POD="" IP="" PORT=""
        case ${why[1]} in
            "riskier than the next offer"*|"host slow before"|"SSH address failed before") spent[$kind|$gpu]=1 ;;
            *)  DISCARDED=$(( ${DISCARDED:-0} + 1 ))
                (( DISCARDED <= DISCARDS )) || { say "$DISCARDS pods discarded on failing hosts; giving up"; exit 1; } ;;
        esac
        # The failed host (or data center) is now skipped: the offers are ranked again with this
        # attempt's record and tried from the best, so a community card that failed on one host is
        # tried on another while it stays cheaper in expectation than a secure one.
        RESTART=1
        break
    done 3<<< "$OFFERS"
    if [ -n "${RESTART:-}" ]; then
        RESTART=""
        (( ! AUTO )) || rank_auto > /dev/null
        continue
    fi
    if [ -z "$POD" ]; then
        # The first pod: offers RunPod refused with an error rather than a stock answer are asked
        # again, at most three times, 10 s apart (frontier-gn-n128-ab2-trust-s1 ended on one while
        # its batch's other nine pods started).
        if [ -z "$DEADLINE" ] && (( API_FAILED && ${API_RETRIES:=0} < 3 )); then
            API_RETRIES=$(( API_RETRIES + 1 )) API_FAILED=0
            say "RunPod answered with an error, not a stock answer; asking again in 10 s ($API_RETRIES of 3)"
            sleep 10
            continue
        fi
        [ -n "$DEADLINE" ] || { say "none of $GPU in stock on a working host"; exit 1; }
        (( $(date +%s) + 600 < DEADLINE )) || { say "none of $GPU in stock and less than 10 minutes left"; exit 1; }
        sleep 60
    fi
    done
    # How status and the idle check reach the pod.
    echo "$IP $PORT $TMP $SSH_USER" > "$ACTIVE/.$POD.ssh"
    on_pod 'nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader; nvidia-smi | grep -o "CUDA Version: [0-9.]*"' < /dev/null | paste -sd ' ' - | sed "s/^/$POD /; s/\$/, $VCPU vCPUs/" | tee -a "$OUT/pod.txt" >&2
    # The GPU's utilization every 10 s ("seconds percent"), for status and the idle check.
    on_pod 'setsid nohup bash -c "while :; do echo \"\$(date +%s) \$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | head -n 1)\"; sleep 10; done" >> /workspace/gpu-util.log 2>&1 < /dev/null &' < /dev/null || true
}

# (Re)arms the pod's own deletion timer: the pod deletes itself SECONDS from now. The old timer's
# shell is killed outright first: killing only its sleep would let it go on to the deletion.
arm() {  # SECONDS
    if [ "$(provider_of "$POD")" != runpod ]; then
        on_pod "sudo shutdown -c > /dev/null 2>&1; sudo shutdown -h +$(( ($1 + 59) / 60 ))" < /dev/null > /dev/null 2>&1
        return
    fi
    on_pod 'cat > /rp-arm.sh && bash /rp-arm.sh '"$1" <<'ARM'
old=$(cat /rp-watchdog.pid 2> /dev/null || true)
[ -z "$old" ] || kill -9 "$old" 2> /dev/null || true
eval "$(tr '\0' '\n' < /proc/1/environ | grep -E '^RUNPOD_(API_KEY|POD_ID)=' | sed 's/^/export /')"
setsid nohup bash -c 'echo $$ > /rp-watchdog.pid; sleep "$0"; runpodctl remove pod "$RUNPOD_POD_ID" || runpodctl pod delete "$RUNPOD_POD_ID"' "$1" > /rp-watchdog.log 2>&1 < /dev/null &
for i in $(seq 50); do [ "$(cat /rp-watchdog.pid 2> /dev/null)" != "$old" ] && break; sleep 0.1; done
kill -0 "$(cat /rp-watchdog.pid)" && command -v runpodctl > /dev/null
ARM
}

# The files under mpd-data that COMMAND reads, in parallel streams over separate connections (one
# connection's rate falls short of the Mac's uplink on distant pods). Files go into streams by size,
# largest first; a file larger than a stream's even share goes up in byte ranges of that share, so
# the streams finish together. A float64 file whose every value is a float32 (an engine export's
# weights, widened from the checkpoint's f32, and its token ids) goes up as float32, half the
# bytes, and is widened on the pod and checked against the Mac file's sha256.
NARROW_CHECK='import hashlib, sys
import numpy as np
for path in sys.argv[2:]:
    raw = open(path, "rb").read()
    if raw and len(raw) % 8 == 0:
        wide = np.frombuffer(raw, dtype="<f8")
        if wide.astype("<f4").astype("<f8").tobytes() == raw:
            print(hashlib.sha256(raw).hexdigest() + "  " + path[len(sys.argv[1]):])'
NARROW='import sys
import numpy as np
f = open(sys.argv[1], "rb")
f.seek(int(sys.argv[2]))
n = int(sys.argv[3])
sys.stdout.buffer.write(np.frombuffer(f.read(n) if n >= 0 else f.read(), dtype="<f8").astype("<f4").tobytes())'
WIDEN='import sys
import numpy as np
offset = int(sys.argv[2])
f = open(sys.argv[1], "wb" if offset < 0 else "r+b")
f.seek(max(offset, 0))
f.write(np.frombuffer(sys.stdin.buffer.read(), dtype="<f4").astype("<f8").tobytes())'
upload_inputs() {
    [ ${#files[@]} -gt 0 ] || return 0
    local streams=8 started=$(date +%s) share f size i k piece best total=0 parts=() narrow="" saved=0 py=$MAC_DATA/venv/bin/python
    # Under SMALL_UPLOAD bytes in all: one tar over the shared connection. Eight new connections
    # took 4 s to send two files of 0 MB (fitperf-phases-n2048); the Mac sends 1.5-3 MB/s on one
    # connection, so below 8 MB one stream finishes within that.
    for f in "${files[@]}"; do total=$(( total + $(stat -L -f %z "$MAC_DATA/$f") )); done
    if (( total < SMALL_UPLOAD )); then
        COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata -C "$MAC_DATA" -chf - "${files[@]}" | gzip -1 |
            on_pod "mkdir -p $WS/mpd-data && gzip -dc | tar -x -C $WS/mpd-data" || return 1
        echo $(( $(date +%s) - started )) >> "$TMP/upload_s"
        say "uploaded ${#files[@]} files, $(( total >> 10 )) KB, in $(( $(date +%s) - started )) s over the shared connection"
        return 0
    fi
    total=0
    # The float64 files that go up as float32, with their sha256s.
    if [ -x "$py" ]; then
        narrow=$(cd "$MAC_DATA" && printf '%s\n' "${files[@]}" | grep '[.]f64$' | xargs "$py" -c "$NARROW_CHECK" "" 2> /dev/null || true)
    fi
    for f in "${files[@]}"; do total=$(( total + $(stat -L -f %z "$MAC_DATA/$f") )); done
    # Each stream's even share, in whole MiB (the unit of the byte ranges), at least one.
    share=$(( (total / streams + 1048575) / 1048576 ))
    share=$(( (share > 0 ? share : 1) * 1048576 ))
    for f in "${files[@]}"; do dirname "$f"; done | sort -u | on_pod "mkdir -p $WS/mpd-data && cd $WS/mpd-data && xargs -d '\\n' mkdir -p" || return 1
    for f in "${files[@]}"; do
        size=$(stat -L -f %z "$MAC_DATA/$f")
        if (( size > share )); then
            on_pod "truncate -s $size $WS/mpd-data/$(printf %q "$f")" || return 1
            for (( k = 0; k * share < size; k++ )); do parts+=("$size $f $k"); done
        else
            parts+=("$size $f -")
        fi
    done
    # Greedy: each piece, largest first, to the stream with the least so far.
    local -a load=() lists=()
    for (( i = 0; i < streams; i++ )); do load[i]=0; lists[i]=""; done
    while read -r size f k; do
        best=0
        for (( i = 1; i < streams; i++ )); do (( load[i] < load[best] )) && best=$i; done
        if [ "$k" = - ]; then piece=$size; else piece=$share; fi
        lists[best]+="$f $k"$'\n'
        load[best]=$(( load[best] + piece ))
    done < <(printf '%s\n' "${parts[@]}" | sort -rn)
    local pids=()
    for (( i = 0; i < streams; i++ )); do
        [ -n "${lists[i]}" ] || continue
        (
            # One piece, sent again (up to three times) when its connection fails: sshd refuses
            # connections beyond its limit of ten unauthenticated at once.
            send() {
                local f=$1 k=$2 q try
                q=$(printf %q "$f")
                for try in 1 2 3; do
                    send_once "$f" "$k" "$q" 2>> "$TMP/upload.err" && return 0
                    sleep $(( 2 * try ))
                done
                return 1
            }
            send_once() {
                local f=$1 k=$2 q=$3
                if grep -q "  $f\$" <<< "$narrow"; then
                    if [ "$k" = - ]; then
                        "$py" -c "$NARROW" "$MAC_DATA/$f" 0 -1 | gzip -1 | new_conn "gzip -dc | python3 -c $(printf %q "$WIDEN") $WS/mpd-data/$q -1" || return 1
                    else
                        "$py" -c "$NARROW" "$MAC_DATA/$f" $(( k * share )) "$share" | gzip -1 |
                            new_conn "gzip -dc | python3 -c $(printf %q "$WIDEN") $WS/mpd-data/$q $(( k * share ))" || return 1
                    fi
                elif [ "$k" = - ]; then
                    gzip -1 -c "$MAC_DATA/$f" | new_conn "gzip -dc > $WS/mpd-data/$q" || return 1
                else
                    dd if="$MAC_DATA/$f" bs=1048576 skip=$(( k * share / 1048576 )) count=$(( share / 1048576 )) 2> /dev/null |
                        gzip -1 | new_conn "gzip -dc | dd of=$WS/mpd-data/$q bs=1048576 seek=$(( k * share / 1048576 )) conv=notrunc 2> /dev/null" || return 1
                fi
            }
            while read -r f k; do
                [ -n "$f" ] || continue
                send "$f" "$k" || exit 1
            done <<< "${lists[i]}"
        ) &
        pids+=($!)
    done
    local failed=0 took
    for i in "${pids[@]}"; do wait "$i" || failed=1; done
    (( ! failed )) || { say "upload failed: $(tail -n 3 "$TMP/upload.err" 2> /dev/null | tr '\n' ' ')"; return 1; }
    if [ -n "$narrow" ]; then
        new_conn "cd $WS/mpd-data && sha256sum -c --quiet" <<< "$narrow" || { say "a float64 file widened on the pod differs from the Mac's"; return 1; }
        saved=$(cd "$MAC_DATA" && awk '{ print $2 }' <<< "$narrow" | xargs stat -f %z | awk '{ s += $1 / 2 } END { printf "%d", s / 1048576 }')
    fi
    took=$(( $(date +%s) - started ))
    echo "$took" >> "$TMP/upload_s"
    say "uploaded ${#files[@]} files, $(( total >> 20 )) MB ($saved MB fewer: $(grep -c . <<< "$narrow") float64 files as float32, widened on the pod, sha256s equal), in $took s ($(awk -v k="$(( total >> 10 ))" -v s="$saved" -v t="$took" 'BEGIN { printf "%.1f", (k / 1024 - s) / (t > 0 ? t : 1) }') MB/s sent, $streams streams)"
}

# The Hugging Face snapshots COMMAND names, downloaded by the pod at their revisions.
# The published inputs, from rp-run-data on GitHub, checked against their sha256s: sixteen requests
# at a time, a file over FETCH_PIECE bytes in byte ranges of that size written in place. From a
# datacenter (a GitHub Actions runner) one connection fetched a 2.0 GB asset in 25 s, eight ranges
# written in place in 6.5 to 8.7 s.
FETCH_PIECE=$(( 128 << 20 )) SMALL_UPLOAD=$(( 8 << 20 ))
fetch_published() {
    [ ${#fetched[@]} -gt 0 ] || return 0
    local started=$(date +%s) sums asset sha f to size k jobs="" total=0 widen=""
    sums=$(printf '%s\n' "${fetched[@]}" | awk '{ print $3 "  " $2 }')
    for e in "${fetched[@]}"; do
        read -r asset f sha <<< "$e"
        size=${fetch_size[$f]:-$(stat -L -f %z "$MAC_DATA/$f")} to=$f
        # An encoded asset lands beside its file and is widened into it.
        case $asset in
            *.u16) size=$(( size / 4 )) to=$f.u16 widen+="$f.u16 $f <u2"$'\n' ;;
            *.f32) size=$(( size / 2 )) to=$f.f32 widen+="$f.f32 $f <f4"$'\n' ;;
        esac
        total=$(( total + size ))
        if (( size > FETCH_PIECE )); then
            for (( k = 0; k * FETCH_PIECE < size; k++ )); do jobs+="$asset $to $(( k * FETCH_PIECE )) $(( (k + 1) * FETCH_PIECE - 1 )) $size"$'\n'; done
        else
            jobs+="$asset $to - - $size"$'\n'
        fi
    done
    printf '%s' "$jobs" | on_pod "mkdir -p $WS/mpd-data && cd $WS/mpd-data && tee .fetch.jobs | while read -r sha rel a b size; do mkdir -p \"\$(dirname \"\$rel\")\"; [ \"\$a\" = - ] || truncate -s \$size \"\$rel\"; done &&
        xargs -P 16 -L 1 sh -c 'if [ \"\$2\" = - ]; then curl -fsSL --retry 3 -o \"\$1\" $DATA_ASSETS/\$0; else curl -fsSL --retry 3 -r \$2-\$3 $DATA_ASSETS/\$0 | dd of=\"\$1\" bs=4M iflag=fullblock oflag=seek_bytes seek=\$2 conv=notrunc status=none; fi' < .fetch.jobs && rm -f .fetch.jobs" || return 1
    if [ -n "$widen" ]; then
        printf '%s' "$widen" | on_pod "cd $WS/mpd-data && python3 -c $(printf %q 'import os, sys
import numpy as np
for line in sys.stdin:
    src, dst, dtype = line.split()
    np.fromfile(src, dtype=dtype).astype("<f8").tofile(dst)
    os.remove(src)')" || { say "widening the downloaded inputs failed; refusing to run"; touch "$TMP/refused"; return 1; }
    fi
    on_pod "cd $WS/mpd-data && sha256sum -c --quiet" <<< "$sums" || { say "a downloaded input differs from its sha256; refusing to run"; touch "$TMP/refused"; return 1; }
    echo $(( $(date +%s) - started )) >> "$TMP/upload_s"
    say "downloaded ${#fetched[@]} published inputs, $(( total >> 20 )) MB, in $(( $(date +%s) - started )) s"
    # The host's download rate (MB/s), for slow_host; only downloads large enough to measure it.
    if [ -n "$POD_HOST" ] && (( total > FETCH_PIECE )); then
        printf '%s\t%s\t%s\n' "$(date '+%F %T')" "$POD_HOST" "$(awk -v b="$total" -v t="$(( $(date +%s) - started ))" 'BEGIN { printf "%.1f", b / 1048576 / (t > 0 ? t : 1) }')" >> "$RP/host_rates.tsv"
    fi
}

# Whether HOST would cost this run more than another pod. A run with a Python environment: the host's
# last fresh install took longer than DISCARD_S plus the median install of every host measured (at
# least three). Its inputs
# (FETCH_BYTES) at HOST's last measured rate take longer than DISCARD_S (a new pod's boot and
# checks, measured 23-34 s to SSH plus about 10 s of checks) plus the same inputs at the median rate
# of every host measured (at least three).
DISCARD_S=40
slow_host() {  # HOST
    local mine med
    # A run with a Python environment: the host's last fresh install against the median install.
    if [ -n "$1" ] && [ -n "$PYENV_DIR" ] && [ -f "$RP/host_installs.tsv" ]; then
        mine=$(awk -F'\t' -v h="$1" '$2 == h { r = $3 } END { print r }' "$RP/host_installs.tsv")
        med=$(cut -f3 "$RP/host_installs.tsv" | sort -n | awk '{ a[NR] = $1 } END { if (NR >= 3) print a[int((NR + 1) / 2)] }')
        [ -n "$mine" ] && [ -n "$med" ] && (( mine > DISCARD_S + med )) && return 0
    fi
    [ -n "$1" ] && (( FETCH_BYTES > FETCH_PIECE )) && [ -f "$RP/host_rates.tsv" ] || return 1
    mine=$(awk -F'\t' -v h="$1" '$2 == h { r = $3 } END { print r }' "$RP/host_rates.tsv")
    [ -n "$mine" ] || return 1
    med=$(cut -f3 "$RP/host_rates.tsv" | sort -n | awk '{ a[NR] = $1 } END { if (NR >= 3) print a[int((NR + 1) / 2)] }')
    [ -n "$med" ] || return 1
    awk -v b="$FETCH_BYTES" -v r="$mine" -v m="$med" -v d="$DISCARD_S" 'BEGIN { mb = b / 1048576; exit !(mb / r > d + mb / m) }'
}

# Whether the inputs still downloading on this new pod would take longer to finish than a new pod
# takes to boot and fetch them all (slow_host's rule, at the rate measured now). The rate is the
# bytes the pod received from SSH (reach's sample, taken as the download starts) through the
# checks; it counts the download's start-up, so it understates the rate, and a host it clears is
# cleared. A host it does not clear is measured again over PROBE_S seconds of the running download
# and judged on that. The bytes still to come are the inputs less all the pod received since SSH
# (not the files' sizes on disk: a range download truncates its file to full size first, and
# frontier-gn-n128-ab2-full-s1's host, 259 MB at 3.2 MB/s, counted it as done). The rate judged is
# recorded for slow_host. vpd-pricing-n2048's host fetched 2.8 GB at 8.4 MB/s (329 s) where the
# median host took 55 s.
PROBE_S=3
# The pod's bytes received on every interface but lo (the host's download rate, which a Python
# environment installing at the same time shares) and its clock (s).
probe_bytes() {
    on_pod "date +%s.%N; cat /proc/net/dev" < /dev/null |
        awk 'NR == 1 { t = $1; next } /:/ { sub(/^ +/, ""); split($0, a, /: */); split(a[2], f, / +/); if (a[1] != "lo") s += f[1] } END { printf "%.0f %.3f\n", s, t }'
}
# Exit 0 when samples A and B (probe_bytes lines) show the inputs left would take longer than a new
# pod; prints the rate (MB/s) and the MB still to come.
too_slow() {  # A B
    awk -v a="$1" -v b="$2" -v z="$PROBE_A" -v total="$FETCH_BYTES" -v m="$MED_RATE" -v d="$DISCARD_S" 'BEGIN {
        split(a, x, " "); split(b, y, " "); split(z, o, " ")
        r = (y[2] > x[2] && y[1] > x[1]) ? (y[1] - x[1]) / 1048576 / (y[2] - x[2]) : 0
        mb = total / 1048576; rest = mb - (y[1] - o[1]) / 1048576
        printf "%.1f %d\n", r, (rest > 0 ? rest : 0)
        exit !(r > 0 && rest > 0 && rest / r > d + mb / m) }'
}
fetch_too_slow() {
    local b c rate
    [ -n "$EARLY_FETCH" ] && kill -0 "$EARLY_FETCH" 2> /dev/null && (( FETCH_BYTES > FETCH_PIECE )) && [ -n "$PROBE_A" ] || return 1
    MED_RATE=$(cut -f3 "$RP/host_rates.tsv" 2> /dev/null | sort -n | awk '{ a[NR] = $1 } END { if (NR >= 3) print a[int((NR + 1) / 2)] }')
    [ -n "$MED_RATE" ] || return 1
    b=$(probe_bytes) || return 1
    rate=$(too_slow "$PROBE_A" "$b") || { say "host ${POD_HOST:-?} received ${rate% *} MB/s from SSH through the checks, ${rate#* } MB of inputs to come: kept"; return 1; }
    sleep "$PROBE_S"
    kill -0 "$EARLY_FETCH" 2> /dev/null || return 1
    c=$(probe_bytes) || return 1
    rate=$(too_slow "$b" "$c") || { say "host ${POD_HOST:-?} receives ${rate% *} MB/s, ${rate#* } MB of inputs to come: kept"; return 1; }
    [ -z "$POD_HOST" ] || printf '%s\t%s\t%s\n' "$(date '+%F %T')" "$POD_HOST" "${rate% *}" >> "$RP/host_rates.tsv"
    say "host ${POD_HOST:-?} receives ${rate% *} MB/s: the ${rate#* } MB of inputs still to come would take longer than a new pod ($DISCARD_S s) plus all $(( FETCH_BYTES >> 20 )) MB at the median host's $MED_RATE MB/s; recorded"
}

fetch_models() {
    local p repo rev list
    for p in "${hf[@]}"; do
        [[ $p =~ models--([^/]+)--([^/]+)/snapshots/([0-9a-f]+)$ ]]
        repo=${BASH_REMATCH[1]}/${BASH_REMATCH[2]} rev=${BASH_REMATCH[3]}
        list=$(cd "$p" && find . -type f -o -type l | sed 's|^\./||' | tr '\n' ' ')
        # The files in parallel (a model's weight shards are several GB each).
        new_conn "set -e; d=$WS/hf/$repo/$rev; for f in $list; do mkdir -p \"\$d/\$(dirname \$f)\"; done
            printf '%s\\n' $list | xargs -P 8 -I{} curl -fsSL --retry 3 -o \"\$d/{}\" https://huggingface.co/$repo/resolve/$rev/{}" || return 1
        say "fetched $repo@${rev:0:12} on the pod"
    done
}

# The Python packages the data builds use, installed once per pod (either build may ask first).
# NumPy 2, as the release was built with: under NumPy 1 an unsigned offset plus an int is a float,
# which the FineWeb script cannot slice with.
# A login that is not root (Thunder's ubuntu) installs pip through sudo and the packages for itself.
pydeps() {
    on_pod 'flock /workspace/.pydeps.lock sh -c "[ -f /workspace/.pydeps ] || {
        S=\$(command -v sudo || true); U=; [ \$(id -u) = 0 ] || U=--user
        { python3 -m pip --version || { \$S apt-get update -qq && \$S apt-get install -y -qq python3-pip; }; } > /workspace/pydeps.log 2>&1 &&
        PIP_BREAK_SYSTEM_PACKAGES=1 python3 -m pip install -q \$U \"numpy>=2\" pyarrow huggingface_hub tokenizers >> /workspace/pydeps.log 2>&1 && touch /workspace/.pydeps; }"'
}

# The Python environment and the named models, built on the pod while the inputs upload: uv (pod-wide)
# installs the pinned set into PYENV_DIR once per pod (other runs with the same set wait, then use
# it); the models download in parallel into the pod-wide Hugging Face cache (/workspace/hf-home,
# HF_HOME for COMMAND) by Hugging Face's own client at its high-performance setting. Measured on a
# GitHub Actions runner: the oracle set resolves in 3 s and installs in 52 s (10 GB); Qwen3-1.7B
# (3.9 GB) downloads in 26 s. A failure other than a lost connection refuses the run.
python_env() {
    local started=$(date +%s) m repo rev pids=() p failed=0
    [ -n "$PYENV_DIR" ] || [ -n "${RP_HF_MODELS:-}" ] || return 0
    # Over the shared connection: the uploads hold the separate ones sshd allows.
    local STEP_CONN=on_pod
    # The pinned set goes up from the Mac: this starts at SSH, before the source is on the pod.
    on_pod "mkdir -p $WS && cat > $WS/pyenv-reqs.txt" <<< "$PYENV_REQS" || return 1
    data_step "installing uv" 'command -v uv > /dev/null || [ -x ~/.local/bin/uv ] || curl -LsSf https://astral.sh/uv/install.sh | sh > /dev/null 2>&1' || return 1
    for m in ${RP_HF_MODELS:-}; do
        repo=${m%@*} rev=main
        [[ $m == *@* ]] && rev=${m#*@}
        data_step "downloading $repo@$rev" "export PATH=\$HOME/.local/bin:\$PATH UV_CACHE_DIR=/workspace/.uv-cache HF_HOME=/workspace/hf-home HF_XET_HIGH_PERFORMANCE=1
            uvx -q --from huggingface_hub hf download $repo --revision $rev > $WS/model-${repo//\//--}.log 2>&1" & pids+=($!)
    done
    if [ -n "$PYENV_DIR" ]; then
        local t0=$(date +%s)
        data_step "installing the Python environment $RP_PYENV ($WS/pyenv.log)" "export PATH=\$HOME/.local/bin:\$PATH UV_CACHE_DIR=/workspace/.uv-cache
            mkdir -p /workspace/pyenv && flock /workspace/pyenv/.lock bash -c '[ -f $PYENV_DIR/.complete ] || {
                rm -rf $PYENV_DIR && uv venv -q --python 3.12 $PYENV_DIR && uv pip install -q --python $PYENV_DIR/bin/python -r $WS/pyenv-reqs.txt && touch $PYENV_DIR/.complete $WS/pyenv.fresh; }' > $WS/pyenv.log 2>&1" || failed=1
        # A fresh install's time on this host, for slow_host.
        if (( ! failed )) && [ -n "$POD_HOST" ] && on_pod "test -f $WS/pyenv.fresh" < /dev/null 2> /dev/null; then
            printf '%s\t%s\t%s\n' "$(date '+%F %T')" "$POD_HOST" "$(( $(date +%s) - t0 ))" >> "$RP/host_installs.tsv"
        fi
    fi
    for p in "${pids[@]}"; do wait "$p" || failed=1; done
    (( ! failed )) || return 1
    echo $(( $(date +%s) - started )) >> "$TMP/data_s"
    say "Python environment ${RP_PYENV:-none} and models ${RP_HF_MODELS:-none} ready in $(( $(date +%s) - started )) s"
}

# A build on the pod: a lost connection (ssh's 255) loses the pod; any other failure, or files
# that differ from their recorded sha256s, refuses the run (TMP/refused).
data_step() {  # WHAT COMMAND...
    local what=$1 rc
    shift
    ${STEP_CONN:-new_conn} "$@"
    rc=$?
    (( rc == 0 )) && return 0
    (( rc == 255 )) || { say "$what failed; refusing to run"; touch "$TMP/refused"; }
    return 1
}

# The FineWeb shards the command names, tokenized on the pod by the commit's script from the
# FineWeb source file, each file checked against the release's sha256 (CONTENTS.json, made from the
# tarballs SHA256SUMS lists). The shards build at once, the vCPUs shared among them, so one shard's
# download overlaps another's tokenizing; each source file is deleted once its shard is built.
build_fineweb() {
    [ ${#fw_plan[@]} -gt 0 ] || return 0
    local started=$(date +%s) e workers pids=() failed=0 p
    pydeps || { touch "$TMP/refused"; say "the Python packages for the data builds did not install (/workspace/pydeps.log)"; return 1; }
    workers=$(( ${VCPU:-${#fw_plan[@]}} / ${#fw_plan[@]} ))
    (( workers > 0 )) || workers=1
    for e in "${fw_plan[@]}"; do
        (
            IFS='|' read -r d k n ts sums <<< "$e"
            data_step "building qwen3_fineweb/$d ($WS/data-$d.log)" "cd $WS/src && python3 bench/mpd_qwen3_fineweb_2951.py --file $k --documents $n --context ${ts//,/ } --out $WS/mpd-data/qwen3_fineweb/$d --workers $workers > $WS/data-$d.log 2>&1 && rm -rf ~/.cache/huggingface/hub/datasets--HuggingFaceFW--fineweb/blobs/\$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"source\"][\"sha256\"])' $WS/mpd-data/qwen3_fineweb/$d/meta.json)" || exit 1
            tr ';' '\n' <<< "$sums" | sed '/^$/d' | data_step "checking qwen3_fineweb/$d against the release's sha256s" "cd $WS/mpd-data/qwen3_fineweb/$d && sha256sum -c --quiet" || exit 1
            say "built qwen3_fineweb/$d on the pod (FineWeb file $k, $n documents, contexts $ts); its files match the release"
        ) &
        pids+=($!)
    done
    for p in "${pids[@]}"; do wait "$p" || failed=1; done
    (( ! failed )) || return 1
    echo $(( $(date +%s) - started )) >> "$TMP/data_s"
}

# The Pile-extended vpd4l exports the command names, built on the pod by the commit's script from
# the uploaded base export and the Pile files, every tensor checked against the Mac's export.json,
# which then replaces the pod's (they differ only in the base export's path), so the export is the
# Mac's byte for byte.
build_pile() {
    [ ${#pile_plan[@]} -gt 0 ] || return 0
    local started=$(date +%s) e x base min
    pydeps || { touch "$TMP/refused"; say "the Python packages for the data builds did not install (/workspace/pydeps.log)"; return 1; }
    for e in "${pile_plan[@]}"; do
        read -r x base min <<< "$e"
        data_step "building engine/$x ($WS/data-$x.log)" "cd $WS/src && python3 bench/vpd_2951/vpd_engine_export_pile.py $WS/mpd-data/$base $WS/mpd-data/engine/$x $min > $WS/data-$x.log 2>&1 && rm -rf ~/mpd-data/hf" || return 1
        jq -r '.files | to_entries[] | "\(.value.sha256)  \(.key).f64"' "$MAC_DATA/engine/$x/export.json" |
            data_step "checking engine/$x against the Mac's export.json" "cd $WS/mpd-data/engine/$x && sha256sum -c --quiet" || return 1
        data_step "installing engine/$x's export.json" "cat > $WS/mpd-data/engine/$x/export.json" < "$MAC_DATA/engine/$x/export.json" || return 1
        say "built engine/$x on the pod ($min Pile train rows after $base's); its tensors match the Mac's export.json"
    done
    echo $(( $(date +%s) - started )) >> "$TMP/data_s"
}

# The pod's upload, data-build and waiting seconds, into its record for the ledger.
note_times() {
    local up data rec=$ACTIVE/$POD n g k p c o e m
    # A packed run's times are its own (rp-run.log); the record is the pod's run's.
    [ -f "$rec" ] && (( ! GUEST )) || return 0
    up=$(awk '{ s += $1 } END { print s + 0 }' "$TMP/upload_s" 2> /dev/null || echo 0)
    data=$(awk '{ s += $1 } END { print s + 0 }' "$TMP/data_s" 2> /dev/null || echo 0)
    read -r n g k p c o e m _ < "$rec"
    printf '%s %s %s %s %s %s %s %s %s %s %s\n' "$n" "$g" "$k" "$p" "$c" "$o" "$e" "$m" "$up" "$data" "$(( $(date +%s) - CREATED ))" > "$rec"
}

# Builds examples and test binaries ("test:PACKAGE:NAME") on the current pod from /workspace/src,
# into /workspace/bin (a test as test-NAME) and the cache. A build error ends the run; a lost
# connection returns 1.
compile_on_pod() {
    local x pkg flags name ex=() ts=() made=()
    for x; do case $x in test:*) ts+=("${x#test:}") ;; *) ex+=("$x") ;; esac; done
    for pkg in $(for x in "${ex[@]}"; do echo "${package_of[$x]}"; done | sort -u); do
        flags=""
        for x in "${ex[@]}"; do [ "${package_of[$x]}" = "$pkg" ] && flags+=" --example $x"; done
        say "building$flags (-p $pkg) at ${C:0:12} with ${VCPU:-all} jobs"
        on_pod "source ~/.cargo/env && cd $WS/src && cargo build -q --release ${VCPU:+-j $VCPU} -p $pkg$flags" 2>&1 | tee -a "$OUT/build.log" >&2
        case ${PIPESTATUS[0]} in
            0) ;;
            255) return 1 ;;
            *) say "the build failed (build.log)"; exit 1 ;;
        esac
    done
    if [ ${#ex[@]} -gt 0 ]; then
        on_pod "cd $WS/src/target/release/examples && cp ${ex[*]} $WS/bin/" || return 1
        made+=("${ex[@]}")
    fi
    for x in "${ts[@]}"; do
        pkg=${x%%:*} name=${x#*:}
        say "building test $name (-p $pkg) at ${C:0:12}"
        # The test executable cargo reports for the target, copied as test-NAME (NAME lib: the
        # package's library unit tests, whose target is the package's name with - as _).
        sel="--test $name" target=$name
        [ "$name" != lib ] || { sel=--lib target=${pkg//-/_}; }
        on_pod "source ~/.cargo/env && cd $WS/src && cargo test -q -p $pkg $sel --no-run --message-format=json ${VCPU:+-j $VCPU} 2>> $WS/build.log |
            python3 -c 'import json, sys; [print(m[\"executable\"]) for m in map(json.loads, sys.stdin) if m.get(\"reason\") == \"compiler-artifact\" and m.get(\"executable\") and m[\"target\"][\"name\"] == sys.argv[1]]' $target |
            tail -n 1 | xargs -r -I{} cp {} $WS/bin/test-$name && [ -x $WS/bin/test-$name ]"
        case $? in
            0) made+=("test-$name") ;;
            255) return 1 ;;
            *) on_pod "tail -n 30 $WS/build.log" >> "$OUT/build.log" 2>&1; say "the test build failed (build.log)"; exit 1 ;;
        esac
    done
    mkdir -p "$CACHE"
    on_pod "tar -C $WS/bin -cf - ${made[*]} | gzip -1" | gzip -dc | tar -x -C "$CACHE" || return 1
    say "built and cached ${made[*]} ($KEY)"
}

# Before any pod exists, what the run needs and nobody has built is built on GitHub Actions
# (gha-run bins: a free runner, published as rp-run-bin assets). One build per set of sources at a
# time: a run that finds another building them waits for it, before renting anything. When Actions
# fails, the run ends before any pod exists.
build_binaries() {
    local need x holder ex=() ts=()
    need=$(unbuilt)
    [ -n "$need" ] || return 0
    mkdir -p "$RP/_bin"
    until mkdir "$CACHE.lock" 2> /dev/null; do
        holder=$(cat "$CACHE.lock/pid" 2> /dev/null || echo 0)
        if ! kill -0 "$holder" 2> /dev/null; then rm -rf "$CACHE.lock"; continue; fi
        # Another run's build of other binaries need not hold this run: its own may be published.
        [ -n "$(unbuilt)" ] || return 0
        say "waiting for run $(cat "$CACHE.lock/name" 2> /dev/null) to finish building $KEY's binaries"
        sleep 30
    done
    echo $$ > "$CACHE.lock/pid"
    echo "$NAME" > "$CACHE.lock/name"
    need=$(unbuilt)
    if [ -z "$need" ]; then
        rm -rf "$CACHE.lock"
        return 0
    fi
    for x in $need; do
        case $x in test:*) ts+=("${x#test:}") ;; *) ex+=("${package_of[$x]}:$x") ;; esac
    done
    say "building $(echo $need) on GitHub Actions"
    if "${SELF%/*}/gha-run" bins "$KEY" "$C" "${ex[@]}" -- "${ts[@]}" 2>> "$OUT/rp-run.log" && [ -z "$(unbuilt)" ]; then
        say "built on GitHub Actions"
        rm -rf "$CACHE.lock"
    else
        # No pod is rented to build: a commit Actions cannot build would not build on the pod either
        # (frontier-gn-n32768's pod idled through such a build of a commit that did not compile).
        rm -rf "$CACHE.lock"
        say "GitHub Actions did not build $(echo $need) at ${C:0:12} (its errors: gha-run status, then gh run view RUN --log-failed); no pod is rented"
        grep -o 'https://github.com/[^ )]*/actions/runs/[0-9]*' "$OUT/rp-run.log" | tail -n 1 | sed 's/^/rp-run: /' >&2
        exit 1
    fi
}

# Where each binary comes from: BIN_ASSETS from rp-run-bin (the pod downloads them), BIN_CACHED
# from the Mac's cache, BIN_BUILD compiled on the pod (only when GitHub Actions has failed). Planned
# once, before the first pod: build_binaries saw every binary published or cached, so a listing
# that lacks one is GitHub's API failing for the moment (published_assets prints nothing then),
# asked again before the run is refused.
BIN_PLANNED=0 BIN_ASSETS=() BIN_CACHED=() BIN_BUILD=()
plan_binaries() {
    local have="" x try
    (( ! BIN_PLANNED )) || return 0
    BIN_ASSETS=() BIN_CACHED=() BIN_BUILD=()
    for try in 1 2 3 4 5; do
        [ ${#examples[@]} -eq 0 ] && [ ${#tests[@]} -eq 0 ] || have=$(published_assets)
        [ -z "$(unbuilt_in "$have")" ] && break
        sleep $(( 2 * try ))
    done
    for x in "${examples[@]}"; do
        if grep -qx "$KEY.$x" <<< "$have"; then BIN_ASSETS+=("$x"); elif [ -x "$CACHE/$x" ]; then BIN_CACHED+=("$x"); else BIN_BUILD+=("$x"); fi
    done
    for x in "${tests[@]}"; do
        if grep -qx "$KEY.test-${x#*:}" <<< "$have"; then BIN_ASSETS+=("test-${x#*:}"); elif [ -x "$CACHE/test-${x#*:}" ]; then BIN_CACHED+=("test-${x#*:}"); else BIN_BUILD+=("test:$x"); fi
    done
    BIN_PLANNED=1
}
# The published binaries, downloaded by the pod all at once (parity-q-968cd0d756's four 86 MB test
# binaries took 26 s one after another).
fetch_binaries() {
    on_pod "mkdir -p $WS/bin && cd $WS/bin && printf '%s\n' ${BIN_ASSETS[*]} | xargs -P 8 -I{} sh -c 'curl -fsSL --retry 3 -o {} $ASSETS/$KEY.{} && chmod +x {}'" < /dev/null || return 1
    say "${BIN_ASSETS[*]} from rp-run-bin ($KEY), downloaded by the pod"
}

# The source, binaries, inputs, data, models and the outputs synced so far, on the current pod.
# A run's extensions (rp-run extend NAME HOURS) while its pod lives, moved as hold() moves a held
# pod's: the pod's own deletion timer (arm), the watcher's deadline (active/.POD.deadline) and the
# run's estimate in its record. A background loop, since the runner waits on the command; the
# runner reads the moved deadline back before it relaunches.
extend_loop() {
    local h d now n g k p c o e m rest
    while [ -f "$ACTIVE/$POD" ]; do
        if [ -f "$OUT/EXTEND" ]; then
            h=$(cat "$OUT/EXTEND") now=$(date +%s)
            d=$(( $(cat "$ACTIVE/.$POD.deadline") + $(awk -v h="$h" 'BEGIN { printf "%d", h * 3600 }') ))
            if arm $(( d - now )); then
                read -r n g k p c o e m rest < "$ACTIVE/$POD"
                e=$(awk -v e="$e" -v p="$PRICE" -v h="$h" 'BEGIN { printf "%.2f", e + p * h }')
                printf '%s %s %s %s %s %s %s %s %s\n' "$n" "$g" "$k" "$p" "$c" "$o" "$e" "$m" "${rest:-}" > "$ACTIVE/$POD"
                echo "$d" > "$ACTIVE/.$POD.deadline"
                say "extended by $h h: the run's cap is now $(date -r "$d" '+%F %T')"
            else
                say "could not move the pod's own deletion timer; the cap stays at $(date -r "$(cat "$ACTIVE/.$POD.deadline")" '+%F %T')"
            fi
            rm -f "$OUT/EXTEND"
        fi
        sleep 2
    done
}

setup() {
    local started=$(date +%s) x pkg flags build=() cached=() jobs=()
    if [ "$MODE" = run ] && (( ! GUEST )); then rm -f "$OUT/EXTEND"; extend_loop & fi
    # Every step checks its own status: `set -e` does not act inside the condition this runs in. A
    # step that fails on the connection (ssh's 255) loses the pod; any other failure ends the run.
    # The published inputs need nothing else: they start at once (at SSH, in reach).
    if [ -n "$EARLY_FETCH" ]; then jobs+=("$EARLY_FETCH"); else fetch_published & jobs+=($!); fi
    plan_binaries
    for x in "${BIN_BUILD[@]}"; do build+=("$x"); done
    for x in "${BIN_CACHED[@]}"; do cached+=("$x"); done
    if [ ${#build[@]} -gt 0 ] && [ "$MODE" = run ] && [ -z "${FALLBACK_BUILD:-}" ]; then
        say "${build[*]} not built: a GPU pod compiles only when GitHub Actions has failed"
        exit 1
    fi
    if [ -n "$EARLY_BINS" ]; then jobs+=("$EARLY_BINS"); elif [ ${#BIN_ASSETS[@]} -gt 0 ]; then fetch_binaries & jobs+=($!); fi
    # The source. A run that compiles nothing needs only the paths COMMAND, the data builds and the
    # Python environment name (srcpaths: about 0.2 MB), sent from the Mac; a compile takes the whole
    # commit from GitHub at datacenter speed (141 MB), the Mac's archive if that fails.
    local members slim=""
    if (( ! NEED_RUST )) && [ ${#build[@]} -eq 0 ]; then
        slim=1
        if [ ${#srcpaths[@]} -gt 0 ]; then
            git -C "$MAC_GAM" archive "$C" "${srcpaths[@]}" | gzip -1 > "$TMP/src.tgz" &&
                (( $(stat -f %z "$TMP/src.tgz") <= UPLOAD_MAX_MB << 20 )) || slim=""
        fi
    fi
    if [ -n "$slim" ]; then
        if [ ${#srcpaths[@]} -gt 0 ]; then
            on_pod "mkdir -p $WS/src $WS/bin $WS/mpd-data/runpod/$NAME && gzip -dc | tar -x -C $WS/src" < "$TMP/src.tgz" || return 1
            say "source ${C:0:12}: ${srcpaths[*]} ($(( $(stat -f %z "$TMP/src.tgz") >> 10 )) KB) from the Mac"
        else
            on_pod "mkdir -p $WS/src $WS/bin $WS/mpd-data/runpod/$NAME" < /dev/null || return 1
        fi
    else
    members=$(printf "gam-$C/%s " crates Cargo.toml Cargo.lock rust-toolchain.toml src build.rs bench/cargo_benches docs/rust-library-surface.md "${srcpaths[@]}")
    if on_pod "mkdir -p $WS/src $WS/bin $WS/mpd-data/runpod/$NAME && curl -fsSL --retry 3 https://codeload.github.com/SauersML/gam/tar.gz/$C |
            tar -xz --strip-components=1 -C $WS/src $members" < /dev/null 2> /dev/null; then
        say "source ${C:0:12} from GitHub"
    else
    git -C "$MAC_GAM" archive "$C" crates Cargo.toml Cargo.lock rust-toolchain.toml src build.rs bench/cargo_benches docs/rust-library-surface.md "${srcpaths[@]}" |
        gzip -1 | on_pod "mkdir -p $WS/src $WS/bin $WS/mpd-data/runpod/$NAME && gzip -dc | tar -x -C $WS/src" || return 1
    fi
    fi
    # Inputs, data, models and rsync (for syncing outputs) arrive while the toolchain and builds do.
    { upload_inputs && build_pile; } & jobs+=($!)
    build_fineweb & jobs+=($!)
    fetch_models & jobs+=($!)
    if [ -n "$EARLY_PYENV" ]; then jobs+=("$EARLY_PYENV"); else python_env & jobs+=($!); fi
    if [ -n "$EARLY_RSYNC" ]; then jobs+=("$EARLY_RSYNC"); else
    on_pod 'S=$(command -v sudo || true); command -v rsync > /dev/null || { $S apt-get update -qq && $S apt-get install -y -qq rsync; } > /dev/null 2>&1' & jobs+=($!)
    fi
    if (( NEED_RUST )) || [ ${#build[@]} -gt 0 ]; then
        on_pod "[ -x ~/.cargo/bin/cargo ] || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y -q --profile minimal --default-toolchain $CHANNEL" > /dev/null || return 1
    fi
    if [ ${#cached[@]} -gt 0 ]; then
        COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata -C "$CACHE" -cf - "${cached[@]}" | gzip -1 | on_pod "gzip -dc | tar -x -C $WS/bin" || return 1
        say "${cached[*]} from the cache ($KEY)"
    fi
    if [ ${#build[@]} -gt 0 ]; then
        compile_on_pod "${build[@]}" || return 1
        [ -z "${FALLBACK_BUILD:-}" ] || { rm -rf "$CACHE.lock"; FALLBACK_BUILD=""; }
    fi
    local failed=0
    for x in "${jobs[@]}"; do wait "$x" || failed=1; done
    if [ -f "$TMP/refused" ]; then
        note_times
        on_pod "tail -n 40 /workspace/pydeps.log $WS/data-*.log 2> /dev/null" > "$OUT/data.log" 2>&1
        say "the data builds' logs are in $OUT/data.log"
        exit 1
    fi
    if (( failed )); then
        # A pod that still answers was not lost: another pod would fail the same way.
        if on_pod true < /dev/null 2> /dev/null; then
            say "an input, data, model or rsync did not arrive, and the pod still answers; stopping"
            exit 1
        fi
        say "an input, data, model or rsync did not arrive: the pod no longer answers"
        return 1
    fi
    # What an earlier pod of this run (or an earlier run of NAME) wrote, so the command can resume
    # from it, when sending it up takes less time than the work it holds: the time from the command's
    # first start (else the oldest output) to the newest output, against its size at the slowest
    # upload rate measured from the Mac (1.5 MB/s; an 18 GB checkpoint takes over 3 h). Otherwise
    # the command starts over.
    if [ "$MODE" = run ] && [ -n "$(find "$OUT" -mindepth 1 $(printf '! -name %s ' "${OWN[@]}") -print -quit)" ]; then
        local kb times send work
        kb=$(cd "$OUT" && find . -type f $(printf '! -name %s ' "${OWN[@]}") ! -name '*.partial' ! -path '*.targets/*' -exec stat -f %z {} + | awk '{ s += $1 } END { printf "%d", s / 1024 }')
        times=$(cd "$OUT" && find . -type f $(printf '! -name %s ' "${OWN[@]}") -exec stat -f %m {} + | sort -n)
        send=$(( kb / 1536 ))
        work=$(( $(tail -n 1 <<< "$times") - ${FIRST_START:-$(head -n 1 <<< "$times")} ))
        if (( kb == 0 )); then
            :
        elif (( send < work )); then
            rsync -a "${RSYNC_EXCLUDE[@]}" -e "${SSH[*]} -o ControlPath=none -p $PORT" "$OUT/" "$SSH_USER@$IP:$WS/mpd-data/runpod/$NAME/" || return 1
            say "restored the outputs synced so far ($(( kb / 1024 )) MB, about $send s up, against $work s of work)"
        else
            say "not restoring the outputs: $(( kb / 1024 )) MB would take about $send s to send up, more than the $work s of work they hold; the command starts over"
        fi
    fi
    note_times
    say "set up in $(( $(date +%s) - started )) s (pod waited $(( $(date +%s) - CREATED )) s since its creation)"
    # The GPU idles, paid, from the pod's creation to the command's start: over SETUP_FAIL seconds is
    # a failure to fix (logged in setup_failures.tsv; the run goes on).
    if (( $(date +%s) - CREATED > SETUP_FAIL )); then
        say "SETUP FAILURE: $(( $(date +%s) - CREATED )) s from the pod's creation to the command (over $SETUP_FAIL s); see rp-run.log for the slow steps"
        printf '%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$NAME" "$(( $(date +%s) - CREATED ))" "$POD" >> "$RP/setup_failures.tsv"
    fi
}

# The outputs, copied to the Mac while the command runs, in two loops (sync_loop): checkpoints
# (CKPT, rewritten whole every epoch and renamed into place: library_mdl's is 18 GB on Qwen3-0.6B),
# each as soon as the last copy ends, so the newest checkpoint comes back once and no copy restarts;
# and everything else a minute after each copy ends, so a checkpoint's copy never holds up the rest.
# A large file (BIG bytes or more, or any checkpoint) comes in PULL_STREAMS byte ranges over
# separate connections, from a hard link that pins the version being copied (a newer one renamed
# over it does not change it), into a temporary file renamed into place when complete, with the
# pod's modification time, so the Mac keeps only the latest complete copy. Measured from a pod: one
# connection 19.5 MB/s, 4 connections 62 MB/s, 8 connections 91 MB/s. Smaller files go by rsync.
# A copy of 100 MB or more is logged with its rate.
CKPT=checkpoint.bin PULL_STREAMS=8 BIG=$(( 128 << 20 ))
POD_OUT=""
pull() {  # REL (one file of the pod's outputs)
    local rel=$1 snap size mtime share k tmp pids=() p failed=0 started
    snap="$POD_OUT/$rel.rp-pull" tmp="$OUT/$rel.rp-pull"
    read -r size mtime < <(on_pod "ln -f $(printf %q "$POD_OUT/$rel") $(printf %q "$snap") && stat -c '%s %Y' $(printf %q "$snap")" < /dev/null) || return 1
    started=$(date +%s)
    mkdir -p "$(dirname "$tmp")"
    : > "$tmp"
    share=$(( (size / PULL_STREAMS + 1048575) / 1048576 ))
    share=$(( share > 0 ? share : 1 ))
    for (( k = 0; k * share * 1048576 < size; k++ )); do
        new_conn "dd if=$(printf %q "$snap") bs=1048576 skip=$(( k * share )) count=$share 2> /dev/null" < /dev/null |
            dd of="$tmp" bs=1048576 seek=$(( k * share )) conv=notrunc 2> /dev/null &
        pids+=($!)
    done
    for p in "${pids[@]}"; do wait "$p" || failed=1; done
    on_pod "rm -f $(printf %q "$snap")" < /dev/null || true
    if (( failed )) || [ "$(stat -f %z "$tmp")" != "$size" ]; then
        rm -f "$tmp"
        return 1
    fi
    touch -m -t "$(date -r "$mtime" '+%Y%m%d%H%M.%S')" "$tmp"
    mv "$tmp" "$OUT/$rel"
    echo "$size $(( $(date +%s) - started ))" >> "$TMP/download"
    (( size < 104857600 )) || say "copied $rel ($(awk -v b="$size" 'BEGIN { printf "%.2f", b / 2^30 }') GB) to the Mac in $(( $(date +%s) - started )) s, $(awk -v b="$size" -v t="$(( $(date +%s) - started ))" 'BEGIN { printf "%.0f", b / 2^20 / (t > 0 ? t : 1) }') MB/s over $k connections"
}
sync_outputs() {  # checkpoints | rest | all
    local what=${1:-all} rel size mtime mac
    POD_OUT=$WS/mpd-data/runpod/$NAME
    if [ "$what" != checkpoints ]; then
        rsync -a -W "${RSYNC_EXCLUDE[@]}" --exclude="$CKPT" --max-size=$(( BIG - 1 )) -e "${SSH[*]} -o ControlPath=none -p $PORT" \
            "$SSH_USER@$IP:$POD_OUT/" "$OUT/" 2> /dev/null || return 1
    fi
    # The large files and checkpoints that differ from the Mac's copies (size or modification time).
    while IFS=$'\t' read -r rel size mtime; do
        [ -n "$rel" ] || continue
        case /$rel in */*.partial|*/*.rp-pull|*.targets/*) continue ;; esac
        [[ $rel == */* ]] || ! printf '%s\n' "${OWN[@]}" | grep -qx "$rel" || continue
        if [ "${rel##*/}" = "$CKPT" ]; then
            [ "$what" != rest ] || continue
        else
            [ "$what" != checkpoints ] && (( size >= BIG )) || continue
        fi
        mac=$OUT/$rel
        [ -f "$mac" ] && [ "$(stat -f '%z %m' "$mac")" = "$size ${mtime%.*}" ] && continue
        pull "$rel" || return 1
    done < <(on_pod "cd $POD_OUT 2> /dev/null && find . -type f -printf '%P\t%s\t%T@\n'" < /dev/null)
}
sync_loop() {  # checkpoints | rest
    local pause=60 i
    [ "$1" = checkpoints ] && pause=10
    while :; do
        # A stop request ends the pause at once; a copy in hand runs to its end first.
        for (( i = 0; i < pause; i++ )); do
            [ ! -f "$TMP/stop-sync" ] && kill -0 $$ 2> /dev/null || return 0
            sleep 1
        done
        sync_outputs "$1" || true
    done
}

# The idle check: once the command has run 15 minutes, a GPU averaging under 20% over the last 15
# minutes (the pod's own samples, every 10 s) ends the run as idle-stopped: it pays for a GPU it does
# not use (CPU-only work goes to GitHub Actions: gha-run).
idle_check() {
    # From the pod's creation (or this run's packing onto it): setup is idle GPU too.
    local started=${CREATED:-$(date +%s)} mean i
    while :; do
        for (( i = 0; i < 12; i++ )); do
            [ ! -f "$TMP/stop-sync" ] && kill -0 $$ 2> /dev/null || return 0
            sleep 5
        done
        (( $(date +%s) - started >= 900 )) || continue
        mean=$(on_pod "awk -v t=\$(( \$(date +%s) - 900 )) '\$1 >= t && NF == 2 { s += \$2; n++ } END { if (n) printf \"%d\", s / n }' /workspace/gpu-util.log" < /dev/null 2> /dev/null || true)
        if [ -n "$mean" ] && (( mean < 20 )); then
            say "GPU at $mean% over the last 15 minutes: stopping the run as idle"
            (( GUEST )) || echo idle-stopped > "$ACTIVE/.$POD.end"
            touch "$OUT/STOP"
            kill -TERM $$
            return
        fi
    done
}

# The run's live profile while its command runs: each minute a row of OUT/live.tsv with the GPU's
# mean and lowest utilization over the minute (the pod's 10 s samples, /workspace/gpu-util.log), the
# GPU's and the host's memory, and what the command logged in the minute: its library_mdl steps
# ("library step E.B: ..., T s"), their mean seconds and their share of the minute, and its last
# other line. Two minutes in a row under LOW_GPU % alert the run's owner: a LOW GPU line in
# rp-run.log, a row of runpod/alerts.tsv (time, run, owner, utilization, last line) and OUT/LOWGPU,
# which status shows as LOW until the GPU is back over the line.
LOW_GPU=70
live_profile() {
    local tsv=$OUT/live.tsv offset size gpu chunk steps under=0 alerted=0 i u
    offset=$(wc -c < "$LOG" | tr -d ' ')
    [ -s "$tsv" ] || printf 'time\tgpu_util\tgpu_util_min\tgpu_mem_used_mib\tgpu_mem_total_mib\thost_mem_used_mib\thost_mem_total_mib\tsteps\tstep_s_mean\tstep_share\tlast_line\n' > "$tsv"
    while :; do
        for (( i = 0; i < 12; i++ )); do
            [ ! -f "$TMP/stop-sync" ] && kill -0 $$ 2> /dev/null || return 0
            sleep 5
        done
        gpu=$(on_pod "awk -v t=\$(( \$(date +%s) - 60 )) '\$1 >= t && NF == 2 { s += \$2; n++; if (n == 1 || \$2 < m) m = \$2 } END { if (n) printf \"%d %d\\n\", s / n, m; else print \"- -\" }' /workspace/gpu-util.log
            nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits | head -n 1 | tr -d ,
            free -m | awk '/^Mem:/ { print \$3, \$2 }'" < /dev/null 2> /dev/null | paste -sd ' ' -) || gpu=""
        read -r -a gpu <<< "${gpu:-- - - - - -}"
        size=$(wc -c < "$LOG" | tr -d ' ')
        (( size >= offset )) || offset=0
        chunk=""
        (( size <= offset )) || chunk=$(tail -c +$(( offset + 1 )) "$LOG" | head -c $(( size - offset )) || true)
        offset=$size
        steps=$(awk '/^library step [0-9]+\.[0-9]+:/ { n++; s += $(NF - 1); next } NF { last = substr($0, 1, 120) }
            END { gsub(/\t/, " ", last); if (n) printf "%d\t%.3f\t%.2f\t%s", n, s / n, s / 60, last; else printf "0\t-\t0\t%s", last }' <<< "$chunk")
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "${gpu[0]:--}" "${gpu[1]:--}" "${gpu[2]:--}" "${gpu[3]:--}" "${gpu[4]:--}" "${gpu[5]:--}" "$steps" >> "$tsv"
        u=${gpu[0]:--}
        [[ $u =~ ^[0-9]+$ ]] || continue
        if (( u < LOW_GPU )); then
            under=$(( under + 1 ))
            if (( under >= 2 && !alerted )); then
                alerted=1
                touch "$OUT/LOWGPU"
                say "LOW GPU: $u% over the last minute, under $LOW_GPU% for $under minutes (owner ${RP_OWNER:--}); live profile $tsv"
                printf '%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$NAME" "${RP_OWNER:--}" "$u" "$(tail -n 1 "$tsv" | cut -f11)" >> "$RP/alerts.tsv"
            fi
        else
            (( alerted )) && say "GPU back to $u% (over $LOW_GPU%)"
            under=0 alerted=0
            rm -f "$OUT/LOWGPU"
        fi
    done
}

# Starts COMMAND detached on the pod (a dropped connection does not end it) and streams its log.
# Sets RC to its exit status; returns 1 when the pod is lost first.
run_command() {
    {
        echo "export PATH=\$HOME/.cargo/bin:$WS/bin:/usr/local/cuda/bin:\$PATH"
        echo 'export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/nvidia/lib64:/usr/local/nvidia/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}'
        echo "export MPD_BIN=$WS/bin"
        [ -z "$PYENV_DIR" ] || echo "export VIRTUAL_ENV=$PYENV_DIR PATH=$PYENV_DIR/bin:\$PATH"
        [ -z "$PYENV_DIR" ] && [ -z "${RP_HF_MODELS:-}" ] || echo "export HF_HOME=/workspace/hf-home"
        echo 'echo "# $(nvidia-smi --query-gpu=name,driver_version --format=csv,noheader), $(nvidia-smi | grep -o "CUDA Version: [0-9.]*")"'
        echo "cd $WS/src"
        echo "$cmd"
    } | on_pod "cat > $WS/run.sh" || return 1
    # The detached shell writes its own pid, so `tail --pid` follows the command and not a launcher.
    on_pod "rm -f $WS/run.exit $WS/run.pid
        setsid nohup bash -c 'echo \$\$ > $WS/run.pid; bash $WS/run.sh > $WS/run.log 2>&1; echo \$? > $WS/run.exit' > /dev/null 2>&1 < /dev/null &
        until [ -s $WS/run.pid ]; do sleep 0.1; done" || return 1
    say "running: $cmd"
    RUN_STARTED=1
    FIRST_START=${FIRST_START:-$(date +%s)}
    sync_loop rest &
    SYNC=$!
    sync_loop checkpoints &
    SYNC="$SYNC $!"
    idle_check &
    SYNC="$SYNC $!"
    rm -f "$OUT/LOWGPU"
    live_profile &
    SYNC="$SYNC $!"
    local base misses=0 state r
    base=$(wc -c < "$LOG" | tr -d ' ')
    RC=""
    while :; do
        # In the background, waited for: a signal (rp-run stop, the idle check) ends the wait at once,
        # where a command in the foreground would hold it until the stream ends.
        on_pod "tail -c +$(( $(wc -c < "$LOG" | tr -d ' ') - base + 1 )) -f --pid=\$(cat $WS/run.pid) $WS/run.log" | tee -a "$LOG" &
        wait $! || true
        if state=$(on_pod "cat $WS/run.exit 2> /dev/null || { kill -0 \"\$(cat $WS/run.pid)\" 2> /dev/null && echo alive; } || echo vanished"); then
            misses=0
            case $state in
                alive) continue ;;
                vanished) say "the command's shell ended without an exit status"; RC=255; break ;;
                *) RC=$state; break ;;
            esac
        fi
        # The connection dropped, or the pod is gone: deleted (the run ends) or lost by its host
        # (the run relaunches).
        state=$(pod_state "$POD")
        if [ "$state" != RUNNING ] && [ "$state" != UNKNOWN ]; then
            say "pod $POD is $state"
            break
        fi
        misses=$(( misses + 1 ))
        (( misses <= 10 )) || { say "pod $POD unreachable"; break; }
        sleep 15
    done
    # The loops finish the copy in hand (the final copy would otherwise start it again), then stop.
    touch "$TMP/stop-sync"
    if [ -n "$RC" ]; then wait $SYNC 2> /dev/null; else kill $SYNC 2> /dev/null; wait $SYNC 2> /dev/null; fi
    rm -f "$TMP/stop-sync"
    SYNC=""
    [ -n "$RC" ]
}

# Login and copy commands for a held pod, in OUT/.
access() {
    local opts
    opts=$(printf '%q ' -F none -i "$TMP/key" -o IdentitiesOnly=yes -o ForwardAgent=no -o ForwardX11=no \
        -o UserKnownHostsFile="$TMP/known_hosts" -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -p "$PORT")
    printf '#!/bin/sh\n# Logs in to pod %s (%s); gone with the pod.\nexec ssh %s %s@%s "$@"\n' "$POD" "$NAME" "$opts" "$SSH_USER" "$IP" > "$OUT/ssh"
    printf '#!/bin/sh\n# ssh for rsync -e: the host comes from the rsync destination (see host).\nexec ssh %s "$@"\n' "$opts" > "$OUT/rsh"
    echo "$SSH_USER@$IP" > "$OUT/host"
    chmod +x "$OUT/ssh" "$OUT/rsh"
}

# Holds the pod until a stop request, the cap (moved by extensions) or a lost pod; returns 0 on a
# stop or the cap, 1 on a lost pod.
hold() {
    local h now next=0 r
    rm -f "$OUT/STOP" "$OUT/EXTEND"
    say "held until $(date -r "$DEADLINE" '+%F %T'): $OUT/ssh logs in; rp-run stop $NAME deletes it; rp-run extend $NAME HOURS extends it"
    while :; do
        now=$(date +%s)
        (( now < DEADLINE )) || { say "the HOURS cap is reached"; return 0; }
        if [ -f "$OUT/STOP" ]; then
            say "stop requested"
            return 0
        fi
        if [ -f "$OUT/EXTEND" ]; then
            h=$(cat "$OUT/EXTEND")
            DEADLINE=$(( DEADLINE + $(awk -v h="$h" 'BEGIN { printf "%d", h * 3600 }') ))
            ESTIMATE=$(awk -v e="$ESTIMATE" -v p="$PRICE" -v h="$h" 'BEGIN { printf "%.2f", e + p * h }')
            if arm $(( DEADLINE - now )); then
                read -r n g k p c o _ m rest < "$ACTIVE/$POD"
                printf '%s %s %s %s %s %s %s %s %s\n' "$n" "$g" "$k" "$p" "$c" "$o" "$ESTIMATE" "$m" "${rest:-}" > "$ACTIVE/$POD"
                echo "$DEADLINE" > "$ACTIVE/.$POD.deadline"
                say "extended by $h h: held until $(date -r "$DEADLINE" '+%F %T')"
            else
                DEADLINE=$(( DEADLINE - $(awk -v h="$h" 'BEGIN { printf "%d", h * 3600 }') ))
                say "could not move the pod's own deletion timer; the cap stays at $(date -r "$DEADLINE" '+%F %T')"
            fi
            rm -f "$OUT/EXTEND"
        fi
        if (( now >= next )); then
            r=$(pod_state "$POD")
            if [ "$r" = GONE ] || [ "$r" = OTHER ]; then
                say "pod $POD lost ($r)"
                return 1
            fi
            next=$(( now + 60 ))
        fi
        sleep 5
    done
}

case $MODE in
    run)
        build_binaries
        plan_binaries
        attempt=1
        until launch && setup && run_command; do
            [ ! -f "$OUT/STOP" ] || exit 1
            # An extension (extend_loop) moved the cap and the estimate in the lost pod's files.
            if [ -n "$POD" ] && [ -f "$ACTIVE/.$POD.deadline" ] && (( ! GUEST )); then
                DEADLINE=$(cat "$ACTIVE/.$POD.deadline")
                ESTIMATE=$(awk '{ print $7 }' "$ACTIVE/$POD" 2> /dev/null || echo "$ESTIMATE")
            fi
            # A pod deleted by anyone but this runner (an API delete, rp-run stop, its own cap) ends
            # the run; only a pod its host lost (exited by RunPod, or unreachable) is replaced.
            if [ -n "$POD" ] && deleted "$POD"; then
                attempt_end ended "deleted outside the runner"
                [ -f "$ACTIVE/.$POD.end" ] || (( GUEST )) || echo deleted-elsewhere > "$ACTIVE/.$POD.end"
                say "pod $POD was deleted outside this runner; the run ends"
                exit 1
            fi
            # The lost pod's shared connection is gone too: closing it fails, harmlessly.
            [ -z "$IP" ] || on_pod -O exit > /dev/null 2>&1 || true
            if [ -n "$POD" ] && (( GUEST )); then
                rm -f "$ACTIVE/.$POD.guests/$NAME"
                reap "$POD" || exit 1
            elif [ -n "$POD" ]; then
                if (( RUN_STARTED )); then attempt_end lost "during the command"; else attempt_end lost "during setup"; fi
                echo lost > "$ACTIVE/.$POD.end"
                reap "$POD" || exit 1
            fi
            POD="" IP="" GUEST=0
            attempt=$(( attempt + 1 ))
            if [ -n "$DEADLINE" ] && (( $(date +%s) + 600 > DEADLINE )); then
                say "less than 10 minutes left under the HOURS cap; not relaunching"
                exit 1
            fi
            (( attempt - 1 <= RELAUNCHES )) || { say "the run lost $RELAUNCHES pods already; giving up"; exit 1; }
            say "relaunch $(( attempt - 1 )) of at most $RELAUNCHES"
        done
        say "command exited $RC after $(( $(date +%s) - CREATED )) s on pod $POD"
        sync_outputs || on_pod "cd $WS/mpd-data/runpod/$NAME && tar -cf - . | gzip -1" | gzip -dc | tar -x -C "$OUT"
        say "outputs in $OUT"
        exit "$RC" ;;
    dev)
        launch && setup || exit 1
        # A git repository of the commit, so changes made on the pod show as a diff against it.
        on_pod "cd $WS/src && git init -q && echo /target/ > .git/info/exclude && git add -A && git -c user.name=rp-run -c user.email=rp-run@localhost commit -qm ${C:0:12}" ||
            { say "could not make the source a git repository"; exit 1; }
        # The dependencies compile while the developer starts: a release and a test build of gam-gpu.
        on_pod "cd $WS/src && setsid nohup bash -c 'source ~/.cargo/env; cargo build --release -p gam-gpu --example tensor_f32_speed ${VCPU:+-j $VCPU} && cargo test -p gam-gpu --no-run --test tensor_f32 --test tensor_posterior ${VCPU:+-j $VCPU}' > $WS/warm.log 2>&1 < /dev/null &" ||
            { say "could not start the warm build"; exit 1; }
        # The toolchain and CUDA for every shell, a command over SSH included (sourced before
        # .bashrc's early return for non-interactive shells); a login starts in the source.
        {
            echo "export PATH=\$HOME/.cargo/bin:$WS/bin:/usr/local/cuda/bin:\$PATH"
            echo 'export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/nvidia/lib64:/usr/local/nvidia/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}'
        } | on_pod "cat > $WS/env.sh && sed -i '1i . $WS/env.sh' ~/.bashrc && echo 'cd $WS/src' >> ~/.bashrc" || exit 1
        access
        say "dev pod $POD ready: $OUT/ssh; source $WS/src at ${C:0:12}; rust $CHANNEL; warm build in $WS/warm.log"
        hold || exit 1
        exit 0 ;;
esac
}
