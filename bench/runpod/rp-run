#!/usr/bin/env bash
# Rented RunPod GPUs for #2951, billed to the MATS team account.
#
#   rp-run NAME GPU_TYPE[,GPU_TYPE...] HOURS -- COMMAND...      run COMMAND on one pod
#   rp-run dev NAME [GPU_TYPE[,GPU_TYPE...] [HOURS]] [-- PATH...] a pod held for development
#   rp-run adopt NAME POD_ID HOURS SSH_KEY                        put a pod made elsewhere under the runner
#   rp-run extend NAME HOURS                                      extend a held pod's cap by HOURS
#   rp-run stop NAME                                              delete a held pod now
#
# GPU_TYPE is a RunPod GPU id ("NVIDIA RTX A5000") or its display name ("RTX A5000"); a list gives
# the types in order of preference. A run takes community cloud for every listed type before secure
# cloud, which it takes only when no community pod is in stock (RunPod no longer offers spot pods:
# "Spot pods are no longer offered", 2026-10-05). It runs COMMAND on the source of a published
# commit, the outputs come back, and the pod is deleted. HOURS (fractional) caps the run: the Mac
# deletes the pod HOURS after the first pod's creation (a watcher process that outlives this one),
# and each pod deletes itself when that time is up by its own clock (runpodctl with the pod's own
# key), so a Mac that sleeps, disconnects or dies still stops the bill.
#
# A pod lost before COMMAND ends (a host that fails, a pod deleted elsewhere) is replaced while time
# remains. The new pod gets the same source, binaries and inputs and the outputs synced so far, and
# runs COMMAND again, so a command that resumes from its own checkpoint under the outputs continues.
# Outputs are synced to the Mac (rsync) every minute while COMMAND runs, except files still being
# written (*.partial) and library_mdl's rebuildable target caches (*.targets).
#
# Source: `git archive` of origin/main, or of RP_REF=<commit> when it is published: the Rust
# workspace (crates/, the manifests, the toolchain pin), bench/runpod/ and every /Users/user/gam/...
# path COMMAND names, unpacked at /workspace/src, the command's working directory.
#
# Paths are translated as mats-run translates them:
#   target/release/examples/X, /Users/user/gam/target/release/examples/X and
#   `cargo run ... --example X -- ARGS`  -> the pod's X, built at the commit by
#       `cargo build --release -p PACKAGE --example X` (no target-cpu flags: the pod's CPU is
#       unknown), or taken from ~/mpd-data/runpod/_bin/ when the same Rust sources built it before;
#   /Users/user/gam/...       -> /workspace/src/...;
#   /Users/user/mpd-data/...  -> /workspace/mpd-data/...; every existing input COMMAND names,
#       outside mpd-data/runpod/, is uploaded first, symlinks as the files they name;
#   ~/.cache/huggingface/hub/models--ORG--NAME/snapshots/REV[/...] -> /workspace/hf/ORG/NAME/REV[/...],
#       fetched on the pod from huggingface.co at REV (public models; nothing is uploaded);
#   python, python3, the Mac venv's python -> the pod's python3.
# Data with a public source is built on the pod, not uploaded, and checked before COMMAND starts
# (a mismatch refuses the run; the builds' logs come back in data.log):
#   /Users/user/mpd-data/qwen3_fineweb/SHARD[/FILE], SHARD a shard of the FineWeb release
#       (train_shard00 .. train_shard07, heldout_f284, or the Mac's copies train and heldout), FILE
#       one of its files (windows_T{128,256,512,1024}.u32, documents.u32, offsets.u64): the shard is
#       tokenized from its FineWeb source file by bench/mpd_qwen3_fineweb_2951.py at the commit,
#       and every file built is checked against the release's sha256 (release/CONTENTS.json,
#       remade by fineweb_contents.py from the tarballs that release/SHA256SUMS lists);
#   /Users/user/mpd-data/engine/EXPORT, a vpd4l export extended with Pile training rows
#       (source.extends in its export.json): its base export, which holds the target's weights, is
#       uploaded, the export built from it and the Pile files by
#       bench/vpd_2951/vpd_engine_export_pile.py, and every tensor checked against the Mac's
#       export.json, which then replaces the pod's.
# Other cargo commands (`cargo test -p gam-gpu ...`) run as given in /workspace/src.
# RP_EXAMPLES="X Y" builds further examples for a script that runs them through $MPD_BIN;
# RP_DISK_GB=N sets the container disk (default: 30 GB, 60 for a dev pod, plus twice the inputs
# and models); RP_ENV="K=V ..." adds environment (RUST_LOG is forwarded when set); RP_MIN_RAM_GB=N
# asks for a pod with at least N GB of host memory (default 32), for a command whose host half
# needs more (a float64 reference of a large model).
#
# Write outputs under /Users/user/mpd-data/runpod/NAME/. They come back there, beside the runner's
# own files: run.log (the command's output, streamed while it runs), rp-run.log (the runner's
# steps, timed), pod.json and pod.txt (the pods), build.log, watch.log and cost.txt.
#
# Dev pods: one pod of the first listed type in stock (community, then secure; default RTX A5000,
# then RTX 4090; default cap 4 h), with the source of the commit at /workspace/src as a git
# repository of one commit, the pinned Rust toolchain, the CUDA 12.4 toolkit, rsync, the PATHs
# given (translated as above) and a release and test build of gam-gpu started in the background
# (/workspace/warm.log). The runner holds it until `rp-run stop NAME`, its cap, or an interrupt,
# then deletes it. ~/mpd-data/runpod/NAME/ssh [COMMAND] logs in; `rsync -e ~/mpd-data/runpod/NAME/rsh
# SRC "$(cat ~/mpd-data/runpod/NAME/host):DEST"` copies files. `rp-run extend NAME HOURS` moves both
# caps (only on request: the budget check runs again). `adopt` holds a pod made outside the runner
# the same way: the ledger counts it from its creation, and its own deletion timer is armed over SSH
# with SSH_KEY.
#
# Money. The API key is read from the macOS Keychain (service runpod-api-key) at each request and
# handed to curl on a file descriptor: never in argv, the environment, a file or a log. The $150 cap
# counts everything the team account has spent since the credit was $750 (750 minus
# myself.clientBalance), whoever spent it, plus what every pod running on the account may still
# cost (its price for the time left to its cap; 4 h for a pod made outside the runner, which every
# start names); a launch or extension whose estimate (the dearest offer x HOURS) would pass it is
# refused unless RP_ALLOW_OVER=1. Each pod appends (date, name, gpu, cloud, hours, dollars, pod) to
# ~/mpd-data/runpod/LEDGER.tsv, dollars = the pod's price per hour x hours from creation to
# deletion; cloud is COMMUNITY, SECURE:no-community-stock, SECURE:dev or ADOPTED; then the seconds
# the pod spent uploading inputs, building data, and from its creation to the command's start (the
# first two overlap each other and the Rust build, so the third is the paid waiting). One run at a time
# unless RP_PARALLEL=1 (held pods do not count). After deleting its pod the runner checks through
# the API that the pod is gone and lists any other pod it created that remains.
#
# SSH uses a key made for the run (deleted with it); ~/.ssh/runpod_ed25519.pub is also authorized,
# for a look by hand. RP_DRY=1 prints the translation, uploads, builds, offers and the pod request,
# and creates nothing.
# The whole script is one block, so bash has read all of it before it runs: replacing the file while
# a run is in progress cannot change what that run executes next.
{
set -Eeuo pipefail
REST=https://rest.runpod.io/v1 GRAPHQL=https://api.runpod.io/graphql
SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
MAC_GAM=/Users/user/gam MAC_DATA=/Users/user/mpd-data HF_HUB=/Users/user/.cache/huggingface/hub
RP=$MAC_DATA/runpod LEDGER=$MAC_DATA/runpod/LEDGER.tsv ACTIVE=$MAC_DATA/runpod/active
# CUDA 12.4 devel: NVRTC and the CUDA libraries the device code loads at run time.
IMAGE=runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
# Host drivers that run what a 12.4 NVRTC compiles.
CUDA_OK='["12.4","12.5","12.6","12.7","12.8","12.9","13.0"]'
# The budget: at most $150 of the team account's credit, which stood at $750 on 2026-10-05 11:10.
# A pod made outside the runner has no cap it knows; it is counted as running 4 h more, the default
# cap of a dev pod.
CAP_DOLLARS=150 START_BALANCE=750 UNCAPPED_HOURS=4
# The runner's own files in the outputs directory: never synced from or restored to a pod.
OWN=(run.log rp-run.log pod.json pod.txt build.log data.log watch.log cost.txt ssh rsh host STOP EXTEND)
# Never synced either: a file still being written (library_mdl writes NAME.partial, then renames it),
# and library_mdl's cache of M's targets beside its checkpoint (tens of GB on Qwen3, rebuilt when
# missing; moving it through the Mac's uplink would take longer than rebuilding it).
SKIP=('*.partial' '*.targets')
RSYNC_EXCLUDE=()
for o in "${OWN[@]}"; do RSYNC_EXCLUDE+=("--exclude=/$o"); done
for o in "${SKIP[@]}"; do RSYNC_EXCLUDE+=("--exclude=$o"); done
mkdir -p "$RP" "$ACTIVE"

# A RunPod API request: METHOD URL [JSON]. Prints the body, then the HTTP status on its own line.
api() {
    local args=(-sS -X "$1" --max-time 60 -w '\n%{http_code}' -H 'Content-Type: application/json')
    [ -n "${3:-}" ] && args+=(--data-binary "$3")
    curl "${args[@]}" -H @<(printf 'Authorization: Bearer %s\n' "$(security find-generic-password -s runpod-api-key -w)") "$2" || printf '\n000'
}
status_of() { printf '%s' "${1##*$'\n'}"; }
body_of() { printf '%s' "${1%$'\n'*}"; }
gql() { api POST "$GRAPHQL" "$(jq -nc --arg q "$1" '{query: $q}')"; }

# Delete POD (recorded in active/POD), confirm through the API that it is gone, and enter its
# cost in the ledger once. Safe to run twice at once (the run's exit and its watcher).
reap() {
    local pod=$1 rec=$ACTIVE/$1 r code tries=0 gone=0
    [ -f "$rec" ] || return 0
    local name gpu cloud price created ended upload_s data_s wait_s
    read -r name gpu cloud price created _ _ _ upload_s data_s wait_s < "$rec"
    gpu=${gpu//_/ }
    while (( tries < 20 )); do
        r=$(api DELETE "$REST/pods/$pod")
        r=$(api GET "$REST/pods/$pod")
        code=$(status_of "$r")
        if [ "$code" = 404 ]; then
            gone=1
        elif [ "$code" = 200 ]; then
            # A deleted pod reads back EXITED with "Terminated by ..." (or TERMINATED), then not at all.
            jq -e '(.desiredStatus == "TERMINATED") or ((.lastStatusChange // "") | startswith("Terminated"))' <<< "$(body_of "$r")" > /dev/null 2>&1 && gone=1
        fi
        if (( gone )); then
            r=$(api GET "$REST/pods")
            if [ "$(status_of "$r")" = 200 ] && jq -e --arg p "$pod" 'type == "array" and all(.[]; .id != $p or (.desiredStatus != "RUNNING" and ((.lastStatusChange // "") | startswith("Terminated"))))' <<< "$(body_of "$r")" > /dev/null 2>&1; then
                break
            fi
            gone=0
        fi
        tries=$(( tries + 1 ))
        sleep 6
    done
    ended=$(date +%s)
    if (( ! gone )); then
        echo "rp-run: POD $pod MAY STILL BE RUNNING: deletion not confirmed after $tries attempts; delete it at https://console.runpod.io/pods" >&2
        return 1
    fi
    # The ledger takes each pod once. A lock older than two minutes is a reaper that died holding it.
    until mkdir "$RP/.ledger.lock" 2> /dev/null; do
        (( $(date +%s) - $(stat -f %m "$RP/.ledger.lock" 2> /dev/null || date +%s) > 120 )) && rmdir "$RP/.ledger.lock" 2> /dev/null
        sleep 1
    done
    if [ -f "$rec" ]; then
        [ -f "$LEDGER" ] || printf 'date\tname\tgpu\tcloud\thours\tdollars\tpod\tupload_s\tdata_s\twait_s\n' > "$LEDGER"
        # Seconds the pod spent on the inputs' upload, on building data from public sources, and
        # from its creation to the command's start (the two overlap each other and the build).
        head -n 1 "$LEDGER" | grep -q wait_s || sed -i '' '1s/$/\tupload_s\tdata_s\twait_s/' "$LEDGER"
        local hours dollars total line
        hours=$(awk -v a="$created" -v b="$ended" 'BEGIN { printf "%.4f", (b - a) / 3600 }')
        dollars=$(awk -v h="$hours" -v p="$price" 'BEGIN { printf "%.4f", h * p }')
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$name" "$gpu" "$cloud" "$hours" "$dollars" "$pod" "${upload_s:--}" "${data_s:--}" "${wait_s:--}" >> "$LEDGER"
        total=$(awk -F'\t' 'NR > 1 { s += $6 } END { printf "%.2f", s }' "$LEDGER")
        line="pod $pod deleted (confirmed). $gpu ($cloud) at \$$price/h x $hours h = \$$dollars; ledger total \$$total"
        echo "rp-run: $line" >&2
        [ -d "$RP/$name" ] && echo "$(date '+%F %T') $line" >> "$RP/$name/cost.txt"
        rm -f "$rec" "$ACTIVE/.$pod.deadline"
    fi
    rmdir "$RP/.ledger.lock"
}

# The watcher: reaps POD when the run's process ends (any way, SIGKILL included) or at its deadline
# (DEADLINE, or a later one an extension wrote to active/.POD.deadline).
if [ "${1:-}" = --watch ]; then
    pod=$2 parent=$3 deadline=$4
    trap '' INT HUP
    due() { cat "$ACTIVE/.$pod.deadline" 2> /dev/null || echo "$deadline"; }
    while kill -0 "$parent" 2> /dev/null && [ -f "$ACTIVE/$pod" ] && (( $(date +%s) < $(due) )); do sleep 10; done
    (( $(date +%s) >= $(due) )) && echo "rp-run: $pod reached its HOURS cap; deleting it" >&2
    reap "$pod"
    exit
fi

usage() { sed -n '2,/^# The whole script is one block/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 2; }
hours_ok() { [[ $1 =~ ^[0-9]*\.?[0-9]+$ ]] && awk -v h="$1" 'BEGIN { exit !(h > 0 && h <= 72) }' || { echo "rp-run: HOURS must be in (0, 72]" >&2; exit 2; }; }
name_ok() { [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || { echo "rp-run: NAME must be [A-Za-z0-9._-]+" >&2; exit 2; }; }

# The budget, over the whole team account: what it has spent since the credit stood at
# START_BALANCE, plus what every pod running now may still cost: its price for the time left to its
# cap (the runner's deadline for a pod it holds; UNCAPPED_HOURS for a pod made elsewhere, which has
# no cap the runner knows), plus ESTIMATE. Every running pod the runner does not hold is named.
# Refuses when that passes CAP_DOLLARS unless RP_ALLOW_OVER=1; RP_DRY=1 only reports it.
budget() {  # ESTIMATE WHAT
    local r b balance spent pods running=0 id name price left now due rec created est
    r=$(gql 'query { myself { clientBalance currentSpendPerHr } }')
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: balance query failed: $(body_of "$r" | head -c 300)" >&2; exit 1; }
    b=$(body_of "$r")
    balance=$(jq -r '.data.myself.clientBalance' <<< "$b")
    spent=$(awk -v s="$START_BALANCE" -v b="$balance" 'BEGIN { printf "%.2f", s - b }')
    r=$(api GET "$REST/pods")
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: pod list failed: $(body_of "$r" | head -c 300)" >&2; exit 1; }
    pods=$(jq -r '.[] | select(.desiredStatus == "RUNNING") | "\(.id) \(.costPerHr // 0) \(.name)"' <<< "$(body_of "$r")")
    now=$(date +%s)
    while read -r id price name; do
        [ -n "$id" ] || continue
        rec=$ACTIVE/$id
        if [ -f "$ACTIVE/.$id.deadline" ]; then
            due=$(cat "$ACTIVE/.$id.deadline")
            left=$(( due - now ))
        elif [ -f "$rec" ]; then
            # Held by a runner from before deadlines were recorded: its estimate less what it has run.
            read -r _ _ _ _ created _ est _ < "$rec"
            left=$(awk -v e="$est" -v p="$price" -v t="$(( now - created ))" 'BEGIN { s = (p > 0 ? e / p * 3600 - t : 0); printf "%d", s }')
        else
            left=$(( UNCAPPED_HOURS * 3600 ))
            echo "rp-run: pod $id ($name, \$$price/h) is not under rp-run; counted as running $UNCAPPED_HOURS h more" >&2
        fi
        running=$(awk -v a="$running" -v p="$price" -v t="$left" 'BEGIN { printf "%.2f", a + (t > 0 ? p * t / 3600 : 0) }')
    done <<< "$pods"
    echo "rp-run: account spent \$$spent (balance \$$balance, \$$(jq -r '.data.myself.currentSpendPerHr' <<< "$b")/h now); running pods may add \$$running; $2 \$$1" >&2
    if awk -v s="$spent" -v r="$running" -v e="$1" -v c="$CAP_DOLLARS" 'BEGIN { exit !(s + r + e > c) }' && [ -z "${RP_ALLOW_OVER:-}" ] && [ -z "${RP_DRY:-}" ]; then
        echo "rp-run: \$$spent + \$$running + \$$1 exceeds \$$CAP_DOLLARS; RP_ALLOW_OVER=1 to spend it anyway" >&2
        exit 2
    fi
}

# The live record of a held pod NAME: prints "POD PRICE OWNER".
held() {
    local rec n price owner
    for rec in "$ACTIVE"/*; do
        [ -f "$rec" ] || continue
        read -r n _ _ price _ owner _ < "$rec" || true
        [ "$n" = "$1" ] && echo "${rec##*/} $price $owner" && return 0
    done
    return 1
}

MODE=run
case ${1:-} in
    stop)
        [ $# -eq 2 ] || usage
        h=$(held "$2") || { echo "rp-run: no pod held for $2" >&2; exit 2; }
        read -r pod _ owner <<< "$h"
        if kill -0 "$owner" 2> /dev/null; then
            touch "$RP/$2/STOP"
            while [ -f "$ACTIVE/$pod" ]; do sleep 2; done
        else
            reap "$pod"
        fi
        exit 0 ;;
    extend)
        [ $# -eq 3 ] || usage
        hours_ok "$3"
        h=$(held "$2") || { echo "rp-run: no pod held for $2" >&2; exit 2; }
        read -r pod price owner <<< "$h"
        kill -0 "$owner" 2> /dev/null || { echo "rp-run: the process holding $2 is gone" >&2; exit 2; }
        budget "$(awk -v p="$price" -v h="$3" 'BEGIN { printf "%.2f", p * h }')" "this extension"
        echo "$3" > "$RP/$2/EXTEND"
        while [ -f "$RP/$2/EXTEND" ]; do sleep 1; done
        echo "rp-run: $2 ($pod) now held until $(date -r "$(cat "$ACTIVE/.$pod.deadline")" '+%F %T')" >&2
        exit 0 ;;
    dev)
        MODE=dev
        shift
        [ $# -ge 1 ] || usage
        NAME=$1 GPU="RTX A5000,RTX 4090" HOURS=4
        shift
        [ $# -gt 0 ] && [ "$1" != -- ] && { GPU=$1; shift; }
        [ $# -gt 0 ] && [ "$1" != -- ] && { HOURS=$1; shift; }
        [ $# -eq 0 ] || { [ "$1" = -- ] || usage; shift; } ;;
    adopt)
        MODE=adopt
        [ $# -eq 5 ] || usage
        NAME=$2 ADOPT=$3 HOURS=$4 ADOPT_KEY=$5 GPU=""
        set -- ;;
    *)
        [ $# -ge 5 ] && [ "$4" = -- ] || usage
        NAME=$1 GPU=$2 HOURS=$3
        shift 4 ;;
esac
name_ok "$NAME"
hours_ok "$HOURS"
CAP_SECONDS=$(awk -v h="$HOURS" 'BEGIN { printf "%d", h * 3600 }')
OUT=$RP/$NAME

# The offers, one per line "KIND|PRICE|GPU id": a run takes community for every type before secure;
# a dev pod takes the types in order, community before secure for each.
OFFERS=""
if [ "$MODE" != adopt ]; then
    r=$(gql 'query { gpuTypes { id displayName securePrice communityPrice } }')
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: price query failed: $(body_of "$r" | head -c 300)" >&2; exit 1; }
    prices=$(body_of "$r")
    rows=()
    IFS=, read -r -a types <<< "$GPU"
    for g in "${types[@]}"; do
        g=$(sed 's/^ *//; s/ *$//' <<< "$g")
        row=$(jq -c --arg g "$g" '[.data.gpuTypes[] | select(.id == $g or .displayName == $g)][0] // empty' <<< "$prices")
        [ -n "$row" ] || { echo "rp-run: unknown GPU type '$g'; known: $(jq -r '[.data.gpuTypes[].displayName] | join(", ")' <<< "$prices")" >&2; exit 2; }
        rows+=("$row")
    done
    secure_kind=SECURE:no-community-stock
    [ "$MODE" = dev ] && secure_kind=SECURE:dev
    OFFERS=$(printf '%s\n' "${rows[@]}" | jq -rs --arg mode "$MODE" --arg sk "$secure_kind" '
        [to_entries[] | .key as $i | .value as $t
         | ({k: "COMMUNITY", p: $t.communityPrice, i: $i, c: 0}, {k: $sk, p: $t.securePrice, i: $i, c: 1})
         | select((.p // 0) > 0) | . + {g: $t.id}]
        | (if $mode == "dev" then sort_by([.i, .c]) else sort_by([.c, .i]) end)
        | .[] | "\(.k)|\(.p)|\(.g)"')
    [ -n "$OFFERS" ] || { echo "rp-run: RunPod offers none of $GPU" >&2; exit 2; }
fi

if [ "$MODE" = adopt ]; then
    r=$(api GET "$REST/pods/$ADOPT?includeMachine=true")
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: no pod $ADOPT: $(body_of "$r" | head -c 200)" >&2; exit 2; }
    ADOPTED=$(body_of "$r")
    [ "$(jq -r .desiredStatus <<< "$ADOPTED")" = RUNNING ] || { echo "rp-run: pod $ADOPT is not running" >&2; exit 2; }
    [ ! -f "$ACTIVE/$ADOPT" ] || { echo "rp-run: pod $ADOPT is already held" >&2; exit 2; }
    [ -r "$ADOPT_KEY" ] || { echo "rp-run: SSH_KEY $ADOPT_KEY is not readable" >&2; exit 2; }
    PRICE_MAX=$(jq -r '.costPerHr // .adjustedCostPerHr' <<< "$ADOPTED")
    GPU=$(jq -r '.machine.gpuTypeId // .gpu.id // "unknown"' <<< "$ADOPTED")
else
    PRICE_MAX=$(awk -F'|' '$2 > m { m = $2 } END { print m }' <<< "$OFFERS")
fi
ESTIMATE=$(awk -v p="$PRICE_MAX" -v h="$HOURS" 'BEGIN { printf "%.2f", p * h }')

# Runs left by a process that is gone (its watcher killed too) are reaped; live runs counted.
live=()
for rec in "$ACTIVE"/*; do
    [ -f "$rec" ] || continue
    read -r _ _ _ _ _ owner _ mode < "$rec" || true
    if [ -n "${owner:-}" ] && kill -0 "$owner" 2> /dev/null; then
        [ "${mode:-run}" = run ] && live+=("${rec##*/}")
    else
        echo "rp-run: reaping ${rec##*/}, left by a run that is gone" >&2
        reap "${rec##*/}" || exit 1
    fi
done
budget "$ESTIMATE" "this $MODE's estimate for $HOURS h"
if [ "$MODE" = run ] && [ ${#live[@]} -gt 0 ] && [ -z "${RP_PARALLEL:-}" ]; then
    echo "rp-run: pod ${live[*]} is running for another rp-run; RP_PARALLEL=1 to run beside it" >&2
    exit 2
fi

# The commit.
C=""
if [ "$MODE" != adopt ]; then
    git -C "$MAC_GAM" fetch -q origin main
    C=$(git -C "$MAC_GAM" rev-parse "${RP_REF:-origin/main}^{commit}")
    git -C "$MAC_GAM" merge-base --is-ancestor "$C" origin/main || { echo "rp-run: ${C:0:12} is not on origin/main; push it or set RP_REF to a published commit" >&2; exit 2; }
fi

# `cargo run [...] --example X [...] -- ARGS` -> X ARGS
if [ "$MODE" = run ] && [ "$1" = cargo ] && [ "${2:-}" = run ]; then
    ex="" rest=()
    while [ $# -gt 0 ]; do
        case $1 in
            --example) ex=$2; shift 2 ;;
            --example=*) ex=${1#--example=}; shift ;;
            --) shift; rest=("$@"); break ;;
            *) shift ;;
        esac
    done
    [ -n "$ex" ] || { echo "rp-run: only 'cargo run --example X' is translated" >&2; exit 2; }
    set -- "target/release/examples/$ex" "${rest[@]}"
fi
NEED_RUST=0
[ "$MODE" = dev ] && NEED_RUST=1
[ "$MODE" = run ] && [ "$1" = cargo ] && NEED_RUST=1

uploads=() hf=() srcpaths=() examples=() words=() fineweb=() pile=()
[ -z "$C" ] || ! git -C "$MAC_GAM" cat-file -e "$C:bench/runpod" 2> /dev/null || srcpaths+=(bench/runpod)
# The FineWeb release's contents (per shard: source file and every file's sha256), remade when the
# release changes.
CONTENTS=$MAC_DATA/qwen3_fineweb/release/CONTENTS.json
if [ -f "${CONTENTS%/*}/SHA256SUMS" ] && { [ ! -f "$CONTENTS" ] || [ "${CONTENTS%/*}/SHA256SUMS" -nt "$CONTENTS" ]; }; then
    /usr/bin/python3 "${SELF%/*}/fineweb_contents.py" > /dev/null || { echo "rp-run: could not read the FineWeb release" >&2; exit 1; }
fi
first=1
[ "$MODE" = run ] || first=0
for a in "$@"; do
    if [ $first = 1 ]; then
        case $a in
            "$MAC_GAM"/target/*/examples/*|target/*/examples/*|./target/*/examples/*) examples+=("${a##*/}"); a="/workspace/bin/${a##*/}" ;;
            python|python3|"$MAC_DATA"/venv/bin/python*) a=python3 ;;
        esac
        first=0
    fi
    while read -r p; do
        [ -n "$p" ] || continue
        case $p in "$MAC_DATA"/runpod/*|"$MAC_DATA"/venv*) continue ;; esac
        rel=${p#"$MAC_DATA"/}
        rel=${rel%/}
        # Data with a public source is built on the pod: a FineWeb release shard (or its Mac copy
        # train, heldout), and a vpd4l export extended with Pile training rows (its base export,
        # which holds the target's weights, goes up instead).
        if [[ $rel =~ ^qwen3_fineweb/([^/]+)(/([^/]+))?$ ]] && [ -f "$CONTENTS" ] && jq -e --arg d "${BASH_REMATCH[1]}" 'has($d)' "$CONTENTS" > /dev/null; then
            fineweb+=("${BASH_REMATCH[1]} ${BASH_REMATCH[3]:-}")
        elif [[ $rel =~ ^engine/([^/]+) ]] && jq -e '.source.extends.export' "$MAC_DATA/engine/${BASH_REMATCH[1]}/export.json" > /dev/null 2>&1; then
            pile+=("${BASH_REMATCH[1]}")
        elif [ -e "$p" ]; then
            uploads+=("$rel")
        fi
    done < <(grep -oE "$MAC_DATA/[^ :,;=\"']+" <<< "$a" || true)
    while read -r p; do
        [ -n "$p" ] && hf+=("$p")
    done < <(grep -oE "$HF_HUB/models--[^/ ]+--[^/ ]+/snapshots/[0-9a-f]+" <<< "$a" || true)
    while read -r p; do
        [ -n "$p" ] || continue
        rel=${p#"$MAC_GAM"/}
        rel=${rel%/}
        case $rel in target/*) continue ;; esac
        git -C "$MAC_GAM" cat-file -e "$C:$rel" 2> /dev/null && srcpaths+=("$rel")
    done < <(grep -oE "$MAC_GAM/[^ :,;=\"']+" <<< "$a" || true)
    a=${a//$MAC_GAM\/target\/release\/examples\//\/workspace\/bin\/}
    a=${a//$MAC_GAM\//\/workspace\/src\/}
    a=${a//$MAC_DATA\//\/workspace\/mpd-data\/}
    if [[ $a =~ $HF_HUB/models--([^/ ]+)--([^/ ]+)/snapshots/([0-9a-f]+) ]]; then
        a=${a//"${BASH_REMATCH[0]}"/"/workspace/hf/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"}
    fi
    words+=("$a")
done
for x in ${RP_EXAMPLES:-}; do examples+=("$x"); done
[ ${#examples[@]} -gt 0 ] && examples=($(printf '%s\n' "${examples[@]}" | sort -u))

# Each example's package, from the commit's tree.
declare -A package_of
for x in "${examples[@]}"; do
    f=$(git -C "$MAC_GAM" ls-tree -r --name-only "$C" -- crates | grep -E "^crates/[^/]+/examples/$x(\.rs|/main\.rs)$" | head -n 1 || true)
    [ -n "$f" ] || { echo "rp-run: no example $x in crates/*/examples at ${C:0:12}" >&2; exit 2; }
    crate=${f#crates/}
    crate=${crate%%/*}
    package_of[$x]=$(git -C "$MAC_GAM" show "$C:crates/$crate/Cargo.toml" | sed -nE 's/^name = "([^"]+)"/\1/p' | head -n 1)
done
# FineWeb shards to build: "DIR|FILE_INDEX|DOCUMENTS|CONTEXTS|SHA256SUM-LINES" (the files the
# command names, documents.u32 and offsets.u64; every window length when it names the directory).
fw_plan=() pile_plan=() data_kb=0
if [ ${#fineweb[@]} -gt 0 ]; then
    git -C "$MAC_GAM" cat-file -e "$C:bench/mpd_qwen3_fineweb_2951.py" 2> /dev/null || { echo "rp-run: ${C:0:12} has no bench/mpd_qwen3_fineweb_2951.py to build FineWeb shards with" >&2; exit 2; }
    srcpaths+=(bench/mpd_qwen3_fineweb_2951.py)
    for d in $(for e in "${fineweb[@]}"; do echo "${e%% *}"; done | sort -u); do
        entry=$(jq -c --arg d "$d" '.[$d]' "$CONTENTS")
        all=$(jq -r '.files | keys[] | capture("^windows_T(?<t>[0-9]+)[.]u32$").t' <<< "$entry" | sort -n | tr '\n' ' ')
        ts=""
        for e in "${fineweb[@]}"; do
            [ "${e%% *}" = "$d" ] || continue
            f=${e#* }
            case $f in
                "") ts+="$all" ;;
                windows_T*.u32) t=${f#windows_T}; ts+="${t%.u32} " ;;
                documents.u32|offsets.u64|meta.json) ;;
                *) echo "rp-run: qwen3_fineweb/$d/$f is not a file of the FineWeb release" >&2; exit 2 ;;
            esac
        done
        [ -n "$ts" ] || ts=${all%% *}
        ts=$(tr ' ' '\n' <<< "$ts" | sed '/^$/d' | sort -nu | tr '\n' ',' | sed 's/,$//')
        check="documents.u32 offsets.u64 $(tr ',' '\n' <<< "$ts" | sed 's/.*/windows_T&.u32/' | tr '\n' ' ')"
        sums=""
        for f in $check; do
            sha=$(jq -r --arg f "$f" '.files[$f] // empty' <<< "$entry")
            [ -n "$sha" ] || { echo "rp-run: qwen3_fineweb/$d has no $f in the release" >&2; exit 2; }
            sums+="$sha  $f;"
            data_kb=$(( data_kb + $(jq -r --arg f "$f" '.sizes[$f]' <<< "$entry") / 1024 ))
        done
        fw_plan+=("$d|$(jq -r '.file_index' <<< "$entry")|$(jq -r '.documents' <<< "$entry")|$ts|$sums")
    done
    # The largest source file is on the pod's disk while its shard is built.
    data_kb=$(( data_kb + $(curl -sS -X POST -H 'Content-Type: application/json' --max-time 60 \
        -d "$(jq -c '{paths: [.[] | .source_file] | unique}' "$CONTENTS")" \
        https://huggingface.co/api/datasets/HuggingFaceFW/fineweb/paths-info/9bb295ddab0e05d785b879661af7260fed5140fc |
        jq '[.[].size] | max' ) / 1024 ))
fi
# Pile-extended vpd4l exports to build: "EXPORT BASE MIN_TRAIN_ROWS" (the base export uploaded).
if [ ${#pile[@]} -gt 0 ]; then
    git -C "$MAC_GAM" cat-file -e "$C:bench/vpd_2951/vpd_engine_export_pile.py" 2> /dev/null || { echo "rp-run: ${C:0:12} has no bench/vpd_2951/vpd_engine_export_pile.py to build Pile exports with" >&2; exit 2; }
    srcpaths+=(bench/vpd_2951/vpd_engine_export_pile.py)
    for x in $(printf '%s\n' "${pile[@]}" | sort -u); do
        record_json=$MAC_DATA/engine/$x/export.json
        base=$(jq -r '.source.extends.export' "$record_json")
        [[ $base == "$MAC_DATA"/* ]] && [ -f "$base/export.json" ] || { echo "rp-run: engine/$x extends $base, which is not an export under $MAC_DATA" >&2; exit 2; }
        uploads+=("${base#"$MAC_DATA"/}")
        pile_plan+=("$x ${base#"$MAC_DATA"/} $(jq '[.source.data[1:][] | .rows[1] - .rows[0]] | add' "$record_json")")
        # The export's tensors as its export.json records them (the Mac need not hold them), and the
        # Pile files it is built from (smaller than their float64 rows).
        data_kb=$(( data_kb + 2 * $(jq '[.files[].shape | reduce .[] as $n (8; . * $n)] | add / 1024 | floor' "$record_json") ))
    done
fi
KEY="" CACHE="" CHANNEL=""
if [ -n "$C" ]; then
    # Binaries built from the same Rust sources in the same image are the same binaries.
    KEY=$( { git -C "$MAC_GAM" rev-parse "$C:crates" "$C:Cargo.lock" "$C:Cargo.toml" "$C:rust-toolchain.toml"; echo "$IMAGE"; } | shasum | cut -c1-16)
    CACHE=$RP/_bin/$KEY
    CHANNEL=$(git -C "$MAC_GAM" show "$C:rust-toolchain.toml" | sed -nE 's/^channel = "([^"]+)"/\1/p')
fi

envp=()
[ -n "${RUST_LOG:-}" ] && envp+=("RUST_LOG=$RUST_LOG")
[ -n "${RP_ENV:-}" ] && read -r -a extra <<< "$RP_ENV" && envp+=("${extra[@]}")
cmd=""
[ ${#words[@]} -gt 0 ] && cmd=$(printf '%q ' "${words[@]}")
[ ${#envp[@]} -gt 0 ] && cmd="env $(printf '%q ' "${envp[@]}")$cmd"

# The input files, with their sizes, relative to mpd-data.
files=()
upload_kb=0
if [ ${#uploads[@]} -gt 0 ]; then
    while IFS= read -r f; do files+=("$f"); done < <(cd "$MAC_DATA" && find -L "${uploads[@]}" -type f ! -name '*.pem' ! -name '*.key' ! -name .env ! -name .DS_Store | sort -u)
    upload_kb=$(cd "$MAC_DATA" && du -skL "${uploads[@]}" | awk '{ s += $1 } END { print s }')
fi
hf_kb=0
for p in "${hf[@]}"; do hf_kb=$(( hf_kb + $(du -skL "$p" | cut -f1) )); done
# The container disk: the toolchain and a release build of the workspace (measured under 20 GB;
# a dev pod also builds the test profile, a second target directory), with room for the inputs,
# the models fetched and the outputs (as large again as the inputs).
base=30
[ "$MODE" = dev ] && base=60
DISK=$(( base + (2 * (upload_kb + hf_kb) + data_kb + 1048575) / 1048576 ))
# A command whose outputs outgrow that (a fit's checkpoints and kept targets) states its own.
if [ -n "${RP_DISK_GB:-}" ]; then
    [[ $RP_DISK_GB =~ ^[0-9]+$ ]] && (( RP_DISK_GB >= DISK )) || { echo "rp-run: RP_DISK_GB must be a whole number of GB, at least $DISK" >&2; exit 2; }
    DISK=$RP_DISK_GB
fi

# The pod deletes itself at the run's deadline by its own clock, then starts as the image would.
create_body() {  # CLOUD GPU_ID SECONDS_LEFT PUBLIC_KEYS
    local start="(echo \$BASHPID > /rp-watchdog.pid; sleep $3; runpodctl remove pod \"\$RUNPOD_POD_ID\" || runpodctl pod delete \"\$RUNPOD_POD_ID\") > /rp-watchdog.log 2>&1 & exec /start.sh"
    # Rust builds and the host half of a step want more than the default 2 vCPUs and 8 GB per GPU.
    jq -nc --arg name "mpd2951-$NAME" --arg image "$IMAGE" --arg gpu "$2" --arg cloud "${1%%:*}" \
        --arg keys "$4" --argjson disk "$DISK" --arg start "$start" --argjson cuda "$CUDA_OK" --argjson ram "${RP_MIN_RAM_GB:-32}" \
        '{name: $name, imageName: $image, computeType: "GPU", gpuTypeIds: [$gpu], gpuCount: 1, cloudType: $cloud,
          containerDiskInGb: $disk, volumeInGb: 0, ports: ["22/tcp"], supportPublicIp: true,
          env: {PUBLIC_KEY: $keys}, dockerStartCmd: ["bash", "-c", $start], allowedCudaVersions: $cuda,
          minVCPUPerGPU: 8, minRAMPerGPU: $ram}'
}

[ "$MODE" = adopt ] || echo "rp-run: $MODE $NAME; offers $(awk -F'|' '{ printf "%s%s %s $%s/h", (NR > 1 ? ", " : ""), $3, $1, $2 }' <<< "$OFFERS"); estimate \$$ESTIMATE for $HOURS h" >&2
if [ -n "${RP_DRY:-}" ]; then
    echo "commit:   ${C:-none}"
    echo "uploads:  ${uploads[*]:-none} (${#files[@]} files, $(( upload_kb / 1024 )) MB)"
    echo "hf:       ${hf[*]:-none}"
    built=$( for e in "${fw_plan[@]}"; do IFS='|' read -r d k n ts _ <<< "$e"; printf 'qwen3_fineweb/%s (FineWeb file %s, %s documents, contexts %s) ' "$d" "$k" "$n" "$ts"; done
             for e in "${pile_plan[@]}"; do read -r x b m <<< "$e"; printf 'engine/%s (from %s and %s Pile train rows) ' "$x" "$b" "$m"; done )
    echo "built:    ${built:-none}"
    echo "source:   crates Cargo.toml Cargo.lock rust-toolchain.toml src build.rs bench/cargo_benches docs/rust-library-surface.md ${srcpaths[*]:-}"
    echo "examples: $(for x in "${examples[@]}"; do printf '%s (%s, %s) ' "$x" "${package_of[$x]}" "$( [ -x "$CACHE/$x" ] && echo cached || echo built)"; done) rust ${CHANNEL:-none}"
    echo "command:  ${cmd:-none}"
    [ "$MODE" = adopt ] || echo "request:  $(IFS='|' read -r k p g <<< "$(head -n 1 <<< "$OFFERS")"; create_body "$k" "$g" "$CAP_SECONDS" '<run key> <~/.ssh/runpod_ed25519.pub>')"
    exit 0
fi

mkdir -p "$OUT"
LOG=$OUT/run.log
: > "$LOG"
rm -f "$OUT/data.log"
say() { echo "rp-run: $*" >&2; echo "$(date '+%F %T') $*" >> "$OUT/rp-run.log"; }
TMP=$(mktemp -d /tmp/rp-run.XXXXXX)
if [ "$MODE" = adopt ]; then
    cp "$ADOPT_KEY" "$TMP/key"
else
    ssh-keygen -q -t ed25519 -N '' -C "rp-run $NAME" -f "$TMP/key"
fi
chmod 600 "$TMP/key"
KEYS="$( [ -f "$TMP/key.pub" ] && cat "$TMP/key.pub")"$'\n'"$(cat ~/.ssh/runpod_ed25519.pub)"
POD="" IP="" PORT="" VCPU="" ATTEMPTED=0 DEADLINE="" SYNC="" PRICE="" CREATED=""
SSH=(ssh -F none -i "$TMP/key" -o IdentitiesOnly=yes -o BatchMode=yes -o ForwardAgent=no -o ForwardX11=no
     -o UserKnownHostsFile="$TMP/known_hosts" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=20
     -o ServerAliveInterval=30 -o ServerAliveCountMax=4 -o LogLevel=ERROR)
# One shared connection for the control steps; the uploads open their own, in parallel.
on_pod() { "${SSH[@]}" -o ControlMaster=auto -o ControlPath="$TMP/cm-%C" -o ControlPersist=600 -p "$PORT" "root@$IP" "$@"; }
new_conn() { "${SSH[@]}" -o ControlPath=none -p "$PORT" "root@$IP" "$@"; }

finish() {
    local rc=$?
    trap - EXIT INT TERM HUP
    set +e
    [ -n "$SYNC" ] && kill "$SYNC" 2> /dev/null
    if [ -n "$IP" ]; then on_pod -O exit > /dev/null 2>&1; fi
    if [ -z "$POD" ] && (( ATTEMPTED )); then
        # A create that failed on the way back (a timeout) may still have made the pod.
        local r id
        r=$(api GET "$REST/pods")
        while read -r id; do
            [ -n "$id" ] || continue
            say "adopting $id, made by a create whose answer was lost"
            printf '%s %s %s %s %s %s %s %s\n' "$NAME" unknown unknown "$PRICE_MAX" "$ATTEMPTED" "$$" "$ESTIMATE" "$MODE" > "$ACTIVE/$id"
            POD=$id
        done < <(jq -r --arg n "mpd2951-$NAME" '.[]? | select(.name == $n) | select(.desiredStatus == "RUNNING") | .id' <<< "$(body_of "$r")" 2> /dev/null)
    fi
    if [ -n "$POD" ]; then
        # The watcher sees this process end and finds nothing left to reap.
        reap "$POD" || rc=1
        # Any other pod this runner made that is still there.
        local r
        r=$(api GET "$REST/pods")
        if [ "$(status_of "$r")" = 200 ]; then
            while read -r id pname st; do
                if [ -f "$ACTIVE/$id" ]; then
                    say "pod $id ($pname, $st) belongs to a run in progress"
                else
                    say "POD $id ($pname, $st) REMAINS and no run of this Mac owns it"
                    rc=1
                fi
            done < <(jq -r '.[] | select(.name | startswith("mpd2951-")) | select(.desiredStatus == "RUNNING") | "\(.id) \(.name) \(.desiredStatus)"' <<< "$(body_of "$r")")
        else
            say "could not list pods to confirm none remain"
            rc=1
        fi
    fi
    rm -rf "$TMP"
    rm -f "$OUT/ssh" "$OUT/rsh" "$OUT/host" "$OUT/STOP" "$OUT/EXTEND"
    say "$NAME ended with status $rc; log $LOG"
    exit $rc
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Records POD in active/ (name gpu cloud price created owner estimate mode) and starts its watcher.
record() {  # GPU_ID KIND
    printf '%s %s %s %s %s %s %s %s\n' "$NAME" "${1// /_}" "$2" "$PRICE" "$CREATED" "$$" "$ESTIMATE" "$MODE" > "$ACTIVE/$POD"
    echo "$DEADLINE" > "$ACTIVE/.$POD.deadline"
    nohup "$SELF" --watch "$POD" "$$" "$DEADLINE" >> "$OUT/watch.log" 2>&1 &
}

# Waits for SSH to POD and checks its own deletion timer. Sets IP PORT VCPU.
reach() {
    local r b st
    until [ -n "$IP" ]; do
        (( $(date +%s) - CREATED < 1200 )) || { say "no public SSH address after 20 minutes"; return 1; }
        r=$(api GET "$REST/pods/$POD")
        if [ "$(status_of "$r")" = 200 ]; then
            b=$(body_of "$r")
            st=$(jq -r .desiredStatus <<< "$b")
            [ "$st" = RUNNING ] || { say "pod is $st ($(jq -r '.lastStatusChange // ""' <<< "$b"))"; return 1; }
            IP=$(jq -r '.publicIp // empty' <<< "$b")
            PORT=$(jq -r '.portMappings["22"] // empty' <<< "$b")
            VCPU=$(jq -r '.vcpuCount // empty' <<< "$b")
            [ -n "$PORT" ] || IP=""
            [ -n "$IP" ] && jq 'del(.env)' <<< "$b" >> "$OUT/pod.json"
        fi
        [ -n "$IP" ] || sleep 5
    done
    until on_pod true 2> /dev/null; do
        (( $(date +%s) - CREATED < 1200 )) || { say "SSH to $IP:$PORT not answering after 20 minutes"; return 1; }
        sleep 5
    done
    say "ssh root@$IP -p $PORT up after $(( $(date +%s) - CREATED )) s"
}

# A pod in stock, reachable by SSH, its own deletion timer armed. Sets POD IP PORT VCPU PRICE.
# Signals wait while a pod is created, so none can end the run between its creation and its record.
launch() {
    local kind price gpu r code left
    POD="" IP="" PORT=""
    # The first pod must be in stock now; a replacement waits for stock while time remains.
    until [ -n "$POD" ]; do
    while IFS='|' read -r kind price gpu; do
        left=$(( ${DEADLINE:-$(( $(date +%s) + CAP_SECONDS ))} - $(date +%s) ))
        (( left > 0 )) || { say "no time left under the HOURS cap"; exit 1; }
        trap '' INT TERM HUP
        ATTEMPTED=$(date +%s)
        r=$(api POST "$REST/pods" "$(create_body "$kind" "$gpu" "$left" "$KEYS")")
        code=$(status_of "$r")
        if [[ $code == 2* ]]; then
            CREATED=$(date +%s)
            DEADLINE=${DEADLINE:-$(( CREATED + CAP_SECONDS ))}
            POD=$(jq -r .id <<< "$(body_of "$r")")
            PRICE=$(jq -r '.costPerHr // .adjustedCostPerHr // empty' <<< "$(body_of "$r")")
            PRICE=${PRICE:-$price}
            record "$gpu" "$kind"
        fi
        trap 'exit 130' INT
        trap 'exit 143' TERM
        trap 'exit 129' HUP
        if [ -n "$POD" ]; then
            say "pod $POD: $gpu, $kind at \$$PRICE/h"
            break
        fi
        say "no $gpu on ${kind%%:*} ($code): $(body_of "$r" | head -c 200)"
    done <<< "$OFFERS"
    if [ -z "$POD" ]; then
        [ -n "$DEADLINE" ] || { say "none of $GPU in stock"; exit 1; }
        (( $(date +%s) + 600 < DEADLINE )) || { say "none of $GPU in stock and less than 10 minutes left"; exit 1; }
        sleep 60
    fi
    done
    reach || return 1
    on_pod 'kill -0 "$(cat /rp-watchdog.pid)" && command -v runpodctl > /dev/null' ||
        { say "the pod's own deletion timer is not running (no runpodctl or watchdog)"; return 1; }
    on_pod 'nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader' | sed "s/^/$POD /; s/\$/, $VCPU vCPUs/" | tee -a "$OUT/pod.txt" >&2
}

# (Re)arms the pod's own deletion timer: the pod deletes itself SECONDS from now. The old timer's
# shell is killed outright first: killing only its sleep would let it go on to the deletion.
arm() {  # SECONDS
    on_pod 'cat > /rp-arm.sh && bash /rp-arm.sh '"$1" <<'ARM'
old=$(cat /rp-watchdog.pid 2> /dev/null || true)
[ -z "$old" ] || kill -9 "$old" 2> /dev/null || true
eval "$(tr '\0' '\n' < /proc/1/environ | grep -E '^RUNPOD_(API_KEY|POD_ID)=' | sed 's/^/export /')"
setsid nohup bash -c 'echo $$ > /rp-watchdog.pid; sleep "$0"; runpodctl remove pod "$RUNPOD_POD_ID" || runpodctl pod delete "$RUNPOD_POD_ID"' "$1" > /rp-watchdog.log 2>&1 < /dev/null &
for i in $(seq 50); do [ "$(cat /rp-watchdog.pid 2> /dev/null)" != "$old" ] && break; sleep 0.1; done
kill -0 "$(cat /rp-watchdog.pid)" && command -v runpodctl > /dev/null
ARM
}

# The files under mpd-data that COMMAND reads, in parallel streams over separate connections (one
# connection's rate falls short of the Mac's uplink on distant pods). Files go into streams by size,
# largest first; a file larger than a stream's even share goes up in byte ranges of that share, so
# the streams finish together.
upload_inputs() {
    [ ${#files[@]} -gt 0 ] || return 0
    local streams=4 started=$(date +%s) share f size i k piece best total=0 parts=()
    for f in "${files[@]}"; do total=$(( total + $(stat -L -f %z "$MAC_DATA/$f") )); done
    # Each stream's even share, in whole MiB (the unit of the byte ranges), at least one.
    share=$(( (total / streams + 1048575) / 1048576 ))
    share=$(( (share > 0 ? share : 1) * 1048576 ))
    for f in "${files[@]}"; do dirname "$f"; done | sort -u | on_pod 'mkdir -p /workspace/mpd-data && cd /workspace/mpd-data && xargs -d "\n" mkdir -p' || return 1
    for f in "${files[@]}"; do
        size=$(stat -L -f %z "$MAC_DATA/$f")
        if (( size > share )); then
            on_pod "truncate -s $size /workspace/mpd-data/$(printf %q "$f")" || return 1
            for (( k = 0; k * share < size; k++ )); do parts+=("$size $f $k"); done
        else
            parts+=("$size $f -")
        fi
    done
    # Greedy: each piece, largest first, to the stream with the least so far.
    local -a load=() lists=()
    for (( i = 0; i < streams; i++ )); do load[i]=0; lists[i]=""; done
    while read -r size f k; do
        best=0
        for (( i = 1; i < streams; i++ )); do (( load[i] < load[best] )) && best=$i; done
        if [ "$k" = - ]; then piece=$size; else piece=$share; fi
        lists[best]+="$f $k"$'\n'
        load[best]=$(( load[best] + piece ))
    done < <(printf '%s\n' "${parts[@]}" | sort -rn)
    local pids=()
    for (( i = 0; i < streams; i++ )); do
        [ -n "${lists[i]}" ] || continue
        (
            while read -r f k; do
                [ -n "$f" ] || continue
                q=$(printf %q "$f")
                if [ "$k" = - ]; then
                    gzip -1 -c "$MAC_DATA/$f" | new_conn "gzip -dc > /workspace/mpd-data/$q" || exit 1
                else
                    dd if="$MAC_DATA/$f" bs=1048576 skip=$(( k * share / 1048576 )) count=$(( share / 1048576 )) 2> /dev/null |
                        gzip -1 | new_conn "gzip -dc | dd of=/workspace/mpd-data/$q bs=1048576 seek=$(( k * share / 1048576 )) conv=notrunc 2> /dev/null" || exit 1
                fi
            done <<< "${lists[i]}"
        ) &
        pids+=($!)
    done
    local failed=0 took
    for i in "${pids[@]}"; do wait "$i" || failed=1; done
    (( ! failed )) || { say "upload failed"; return 1; }
    took=$(( $(date +%s) - started ))
    echo "$took" >> "$TMP/upload_s"
    say "uploaded ${#files[@]} files, $(( upload_kb / 1024 )) MB, in $took s ($(awk -v k="$upload_kb" -v t="$took" 'BEGIN { printf "%.1f", k / 1024 / (t > 0 ? t : 1) }') MB/s, $streams streams)"
}

# The Hugging Face snapshots COMMAND names, downloaded by the pod at their revisions.
fetch_models() {
    local p repo rev list
    for p in "${hf[@]}"; do
        [[ $p =~ models--([^/]+)--([^/]+)/snapshots/([0-9a-f]+)$ ]]
        repo=${BASH_REMATCH[1]}/${BASH_REMATCH[2]} rev=${BASH_REMATCH[3]}
        list=$(cd "$p" && find . -type f -o -type l | sed 's|^\./||' | tr '\n' ' ')
        new_conn "set -e; d=/workspace/hf/$repo/$rev; for f in $list; do mkdir -p \"\$d/\$(dirname \$f)\"; curl -fsSL --retry 3 -o \"\$d/\$f\" https://huggingface.co/$repo/resolve/$rev/\$f; done" || return 1
        say "fetched $repo@${rev:0:12} on the pod"
    done
}

# The Python packages the data builds use, installed once per pod (either build may ask first).
# NumPy 2, as the release was built with: under NumPy 1 an unsigned offset plus an int is a float,
# which the FineWeb script cannot slice with.
pydeps() {
    on_pod 'flock /workspace/.pydeps.lock sh -c "[ -f /workspace/.pydeps ] || { python3 -m pip install -q \"numpy>=2\" pyarrow huggingface_hub tokenizers > /workspace/pydeps.log 2>&1 && touch /workspace/.pydeps; }"'
}

# A build on the pod: a lost connection (ssh's 255) loses the pod; any other failure, or files
# that differ from their recorded sha256s, refuses the run (TMP/refused).
data_step() {  # WHAT COMMAND...
    local what=$1 rc
    shift
    new_conn "$@"
    rc=$?
    (( rc == 0 )) && return 0
    (( rc == 255 )) || { say "$what failed; refusing to run"; touch "$TMP/refused"; }
    return 1
}

# The FineWeb shards the command names, tokenized on the pod by the commit's script from the
# FineWeb source file, each file checked against the release's sha256 (CONTENTS.json, made from the
# tarballs SHA256SUMS lists). The shards build at once, the vCPUs shared among them, so one shard's
# download overlaps another's tokenizing; each source file is deleted once its shard is built.
build_fineweb() {
    [ ${#fw_plan[@]} -gt 0 ] || return 0
    local started=$(date +%s) e workers pids=() failed=0 p
    pydeps || { touch "$TMP/refused"; say "the Python packages for the data builds did not install (/workspace/pydeps.log)"; return 1; }
    workers=$(( ${VCPU:-${#fw_plan[@]}} / ${#fw_plan[@]} ))
    (( workers > 0 )) || workers=1
    for e in "${fw_plan[@]}"; do
        (
            IFS='|' read -r d k n ts sums <<< "$e"
            data_step "building qwen3_fineweb/$d (/workspace/data-$d.log)" "cd /workspace/src && python3 bench/mpd_qwen3_fineweb_2951.py --file $k --documents $n --context ${ts//,/ } --out /workspace/mpd-data/qwen3_fineweb/$d --workers $workers > /workspace/data-$d.log 2>&1 && rm -rf ~/.cache/huggingface/hub/datasets--HuggingFaceFW--fineweb/blobs/\$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"source\"][\"sha256\"])' /workspace/mpd-data/qwen3_fineweb/$d/meta.json)" || exit 1
            tr ';' '\n' <<< "$sums" | sed '/^$/d' | data_step "checking qwen3_fineweb/$d against the release's sha256s" "cd /workspace/mpd-data/qwen3_fineweb/$d && sha256sum -c --quiet" || exit 1
            say "built qwen3_fineweb/$d on the pod (FineWeb file $k, $n documents, contexts $ts); its files match the release"
        ) &
        pids+=($!)
    done
    for p in "${pids[@]}"; do wait "$p" || failed=1; done
    (( ! failed )) || return 1
    echo $(( $(date +%s) - started )) >> "$TMP/data_s"
}

# The Pile-extended vpd4l exports the command names, built on the pod by the commit's script from
# the uploaded base export and the Pile files, every tensor checked against the Mac's export.json,
# which then replaces the pod's (they differ only in the base export's path), so the export is the
# Mac's byte for byte.
build_pile() {
    [ ${#pile_plan[@]} -gt 0 ] || return 0
    local started=$(date +%s) e x base min
    pydeps || { touch "$TMP/refused"; say "the Python packages for the data builds did not install (/workspace/pydeps.log)"; return 1; }
    for e in "${pile_plan[@]}"; do
        read -r x base min <<< "$e"
        data_step "building engine/$x (/workspace/data-$x.log)" "cd /workspace/src && python3 bench/vpd_2951/vpd_engine_export_pile.py /workspace/mpd-data/$base /workspace/mpd-data/engine/$x $min > /workspace/data-$x.log 2>&1 && rm -rf ~/mpd-data/hf" || return 1
        jq -r '.files | to_entries[] | "\(.value.sha256)  \(.key).f64"' "$MAC_DATA/engine/$x/export.json" |
            data_step "checking engine/$x against the Mac's export.json" "cd /workspace/mpd-data/engine/$x && sha256sum -c --quiet" || return 1
        data_step "installing engine/$x's export.json" "cat > /workspace/mpd-data/engine/$x/export.json" < "$MAC_DATA/engine/$x/export.json" || return 1
        say "built engine/$x on the pod ($min Pile train rows after $base's); its tensors match the Mac's export.json"
    done
    echo $(( $(date +%s) - started )) >> "$TMP/data_s"
}

# The pod's upload, data-build and waiting seconds, into its record for the ledger.
note_times() {
    local up data rec=$ACTIVE/$POD n g k p c o e m
    [ -f "$rec" ] || return 0
    up=$(awk '{ s += $1 } END { print s + 0 }' "$TMP/upload_s" 2> /dev/null || echo 0)
    data=$(awk '{ s += $1 } END { print s + 0 }' "$TMP/data_s" 2> /dev/null || echo 0)
    read -r n g k p c o e m _ < "$rec"
    printf '%s %s %s %s %s %s %s %s %s %s %s\n' "$n" "$g" "$k" "$p" "$c" "$o" "$e" "$m" "$up" "$data" "$(( $(date +%s) - CREATED ))" > "$rec"
}

# The source, binaries, inputs, data, models and the outputs synced so far, on the current pod.
setup() {
    local started=$(date +%s) x pkg flags build=() cached=() jobs=()
    # Every step checks its own status: `set -e` does not act inside the condition this runs in. A
    # step that fails on the connection (ssh's 255) loses the pod; any other failure ends the run.
    # The source first: the data builds run its scripts.
    git -C "$MAC_GAM" archive "$C" crates Cargo.toml Cargo.lock rust-toolchain.toml src build.rs bench/cargo_benches docs/rust-library-surface.md "${srcpaths[@]}" |
        gzip -1 | on_pod 'mkdir -p /workspace/src /workspace/bin "/workspace/mpd-data/runpod/'"$NAME"'" && gzip -dc | tar -x -C /workspace/src' || return 1
    # Inputs, data, models and rsync (for syncing outputs) arrive while the toolchain and builds do.
    rm -f "$TMP/upload_s" "$TMP/data_s" "$TMP/refused"
    { upload_inputs && build_pile; } & jobs+=($!)
    build_fineweb & jobs+=($!)
    fetch_models & jobs+=($!)
    on_pod 'command -v rsync > /dev/null || { apt-get update -qq && apt-get install -y -qq rsync; } > /dev/null 2>&1' & jobs+=($!)
    for x in "${examples[@]}"; do
        if [ -x "$CACHE/$x" ]; then cached+=("$x"); else build+=("$x"); fi
    done
    if (( NEED_RUST )) || [ ${#build[@]} -gt 0 ]; then
        on_pod "[ -x ~/.cargo/bin/cargo ] || curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y -q --profile minimal --default-toolchain $CHANNEL" > /dev/null || return 1
    fi
    if [ ${#cached[@]} -gt 0 ]; then
        COPYFILE_DISABLE=1 tar --no-xattrs --no-mac-metadata -C "$CACHE" -cf - "${cached[@]}" | gzip -1 | on_pod 'gzip -dc | tar -x -C /workspace/bin' || return 1
        say "${cached[*]} from the cache ($KEY)"
    fi
    if [ ${#build[@]} -gt 0 ]; then
        for pkg in $(for x in "${build[@]}"; do echo "${package_of[$x]}"; done | sort -u); do
            flags=""
            for x in "${build[@]}"; do [ "${package_of[$x]}" = "$pkg" ] && flags+=" --example $x"; done
            say "building$flags (-p $pkg) at ${C:0:12} with ${VCPU:-all} jobs"
            on_pod "source ~/.cargo/env && cd /workspace/src && cargo build -q --release ${VCPU:+-j $VCPU} -p $pkg$flags" 2>&1 | tee -a "$OUT/build.log" >&2
            case ${PIPESTATUS[0]} in
                0) ;;
                255) return 1 ;;
                *) say "the build failed (build.log)"; exit 1 ;;
            esac
        done
        on_pod "cd /workspace/src/target/release/examples && cp ${build[*]} /workspace/bin/" || return 1
        mkdir -p "$CACHE"
        on_pod "tar -C /workspace/bin -cf - ${build[*]} | gzip -1" | gzip -dc | tar -x -C "$CACHE" || return 1
        say "built and cached ${build[*]} ($KEY)"
    fi
    local failed=0
    for x in "${jobs[@]}"; do wait "$x" || failed=1; done
    if [ -f "$TMP/refused" ]; then
        note_times
        on_pod 'tail -n 40 /workspace/pydeps.log /workspace/data-*.log 2> /dev/null' > "$OUT/data.log" 2>&1
        say "the data builds' logs are in $OUT/data.log"
        exit 1
    fi
    (( ! failed )) || { say "an input, data, model or rsync did not arrive"; return 1; }
    # What an earlier pod of this run wrote, so the command can resume from it.
    if [ "$MODE" = run ] && [ -n "$(find "$OUT" -mindepth 1 $(printf '! -name %s ' "${OWN[@]}") -print -quit)" ]; then
        rsync -a "${RSYNC_EXCLUDE[@]}" -e "${SSH[*]} -o ControlPath=none -p $PORT" "$OUT/" "root@$IP:/workspace/mpd-data/runpod/$NAME/" || return 1
        say "restored the outputs synced so far"
    fi
    note_times
    say "set up in $(( $(date +%s) - started )) s (pod waited $(( $(date +%s) - CREATED )) s since its creation)"
}

# The outputs, copied to the Mac a minute after each copy ends, while the command runs.
sync_outputs() {
    rsync -a "${RSYNC_EXCLUDE[@]}" -e "${SSH[*]} -o ControlPath=none -p $PORT" "root@$IP:/workspace/mpd-data/runpod/$NAME/" "$OUT/" 2> /dev/null
}

# Starts COMMAND detached on the pod (a dropped connection does not end it) and streams its log.
# Sets RC to its exit status; returns 1 when the pod is lost first.
run_command() {
    {
        echo 'export PATH=/root/.cargo/bin:/workspace/bin:/usr/local/cuda/bin:$PATH'
        echo 'export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/nvidia/lib64:/usr/local/nvidia/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}'
        echo 'export MPD_BIN=/workspace/bin'
        echo "cd /workspace/src"
        echo "$cmd"
    } | on_pod 'cat > /workspace/run.sh' || return 1
    # The detached shell writes its own pid, so `tail --pid` follows the command and not a launcher.
    on_pod 'rm -f /workspace/run.exit /workspace/run.pid
        setsid nohup bash -c "echo \$\$ > /workspace/run.pid; bash /workspace/run.sh > /workspace/run.log 2>&1; echo \$? > /workspace/run.exit" > /dev/null 2>&1 < /dev/null &
        until [ -s /workspace/run.pid ]; do sleep 0.1; done' || return 1
    say "running: $cmd"
    ( while sleep 60 && kill -0 $$ 2> /dev/null; do sync_outputs || true; done ) &
    SYNC=$!
    local base misses=0 state r
    base=$(wc -c < "$LOG" | tr -d ' ')
    RC=""
    while :; do
        on_pod "tail -c +$(( $(wc -c < "$LOG" | tr -d ' ') - base + 1 )) -f --pid=\$(cat /workspace/run.pid) /workspace/run.log" | tee -a "$LOG" || true
        if state=$(on_pod 'cat /workspace/run.exit 2> /dev/null || { kill -0 "$(cat /workspace/run.pid)" 2> /dev/null && echo alive; } || echo vanished'); then
            misses=0
            case $state in
                alive) continue ;;
                vanished) say "the command's shell ended without an exit status"; RC=255; break ;;
                *) RC=$state; break ;;
            esac
        fi
        # The connection dropped, or the pod is gone (taken back, its cap, deleted elsewhere).
        r=$(api GET "$REST/pods/$POD")
        if [ "$(status_of "$r")" != 200 ] || [ "$(jq -r .desiredStatus <<< "$(body_of "$r")")" != RUNNING ]; then
            say "pod $POD lost ($(body_of "$r" | jq -r '.lastStatusChange // .error // ""' 2> /dev/null))"
            break
        fi
        misses=$(( misses + 1 ))
        (( misses <= 10 )) || { say "pod $POD unreachable"; break; }
        sleep 15
    done
    kill "$SYNC" 2> /dev/null
    wait "$SYNC" 2> /dev/null
    SYNC=""
    [ -n "$RC" ]
}

# Login and copy commands for a held pod, in OUT/.
access() {
    local opts
    opts=$(printf '%q ' -F none -i "$TMP/key" -o IdentitiesOnly=yes -o ForwardAgent=no -o ForwardX11=no \
        -o UserKnownHostsFile="$TMP/known_hosts" -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -p "$PORT")
    printf '#!/bin/sh\n# Logs in to pod %s (%s); gone with the pod.\nexec ssh %s root@%s "$@"\n' "$POD" "$NAME" "$opts" "$IP" > "$OUT/ssh"
    printf '#!/bin/sh\n# ssh for rsync -e: the host comes from the rsync destination (see host).\nexec ssh %s "$@"\n' "$opts" > "$OUT/rsh"
    echo "root@$IP" > "$OUT/host"
    chmod +x "$OUT/ssh" "$OUT/rsh"
}

# Holds the pod until a stop request, the cap (moved by extensions) or a lost pod; returns 0 on a
# stop or the cap, 1 on a lost pod.
hold() {
    local h now next=0 r
    rm -f "$OUT/STOP" "$OUT/EXTEND"
    say "held until $(date -r "$DEADLINE" '+%F %T'): $OUT/ssh logs in; rp-run stop $NAME deletes it; rp-run extend $NAME HOURS extends it"
    while :; do
        now=$(date +%s)
        (( now < DEADLINE )) || { say "the HOURS cap is reached"; return 0; }
        if [ -f "$OUT/STOP" ]; then
            say "stop requested"
            return 0
        fi
        if [ -f "$OUT/EXTEND" ]; then
            h=$(cat "$OUT/EXTEND")
            DEADLINE=$(( DEADLINE + $(awk -v h="$h" 'BEGIN { printf "%d", h * 3600 }') ))
            ESTIMATE=$(awk -v e="$ESTIMATE" -v p="$PRICE" -v h="$h" 'BEGIN { printf "%.2f", e + p * h }')
            if arm $(( DEADLINE - now )); then
                read -r n g k p c o _ m rest < "$ACTIVE/$POD"
                printf '%s %s %s %s %s %s %s %s %s\n' "$n" "$g" "$k" "$p" "$c" "$o" "$ESTIMATE" "$m" "${rest:-}" > "$ACTIVE/$POD"
                echo "$DEADLINE" > "$ACTIVE/.$POD.deadline"
                say "extended by $h h: held until $(date -r "$DEADLINE" '+%F %T')"
            else
                DEADLINE=$(( DEADLINE - $(awk -v h="$h" 'BEGIN { printf "%d", h * 3600 }') ))
                say "could not move the pod's own deletion timer; the cap stays at $(date -r "$DEADLINE" '+%F %T')"
            fi
            rm -f "$OUT/EXTEND"
        fi
        if (( now >= next )); then
            r=$(api GET "$REST/pods/$POD")
            if [ "$(status_of "$r")" = 404 ] || { [ "$(status_of "$r")" = 200 ] && [ "$(jq -r .desiredStatus <<< "$(body_of "$r")")" != RUNNING ]; }; then
                say "pod $POD lost ($(body_of "$r" | jq -r '.lastStatusChange // .error // ""' 2> /dev/null))"
                return 1
            fi
            next=$(( now + 60 ))
        fi
        sleep 5
    done
}

case $MODE in
    run)
        attempt=1
        until launch && setup && run_command; do
            # Lost or never usable: release it, then a new pod while time remains.
            # The lost pod's shared connection is gone too: closing it fails, harmlessly.
            [ -z "$IP" ] || on_pod -O exit > /dev/null 2>&1 || true
            [ -z "$POD" ] || reap "$POD" || exit 1
            POD="" IP=""
            attempt=$(( attempt + 1 ))
            if [ -n "$DEADLINE" ] && (( $(date +%s) + 600 > DEADLINE )); then
                say "less than 10 minutes left under the HOURS cap; not relaunching"
                exit 1
            fi
            (( attempt <= 5 )) || { say "five pods failed; giving up"; exit 1; }
            say "attempt $attempt"
        done
        say "command exited $RC after $(( $(date +%s) - CREATED )) s on pod $POD"
        sync_outputs || on_pod "cd /workspace/mpd-data/runpod/$NAME && tar -cf - . | gzip -1" | gzip -dc | tar -x -C "$OUT"
        say "outputs in $OUT"
        exit "$RC" ;;
    dev)
        launch && setup || exit 1
        # A git repository of the commit, so changes made on the pod show as a diff against it.
        on_pod "cd /workspace/src && git init -q && echo /target/ > .git/info/exclude && git add -A && git -c user.name=rp-run -c user.email=rp-run@localhost commit -qm ${C:0:12}" ||
            { say "could not make the source a git repository"; exit 1; }
        # The dependencies compile while the developer starts: a release and a test build of gam-gpu.
        on_pod "cd /workspace/src && setsid nohup bash -c 'source ~/.cargo/env; cargo build --release -p gam-gpu --example tensor_f32_speed ${VCPU:+-j $VCPU} && cargo test -p gam-gpu --no-run --test tensor_f32 --test tensor_posterior ${VCPU:+-j $VCPU}' > /workspace/warm.log 2>&1 < /dev/null &" ||
            { say "could not start the warm build"; exit 1; }
        # The toolchain and CUDA for every shell, a command over SSH included (sourced before
        # .bashrc's early return for non-interactive shells); a login starts in the source.
        {
            echo 'export PATH=/root/.cargo/bin:/workspace/bin:/usr/local/cuda/bin:$PATH'
            echo 'export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/nvidia/lib64:/usr/local/nvidia/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}'
        } | on_pod 'cat > /workspace/env.sh && sed -i "1i . /workspace/env.sh" ~/.bashrc && echo "cd /workspace/src" >> ~/.bashrc' || exit 1
        access
        say "dev pod $POD ready: $OUT/ssh; source /workspace/src at ${C:0:12}; rust $CHANNEL; warm build in /workspace/warm.log"
        hold || exit 1
        exit 0 ;;
    adopt)
        IP=$(jq -r '.publicIp // empty' <<< "$ADOPTED")
        PORT=$(jq -r '.portMappings["22"] // empty' <<< "$ADOPTED")
        [ -n "$IP" ] && [ -n "$PORT" ] || { IP=""; say "pod $ADOPT has no public SSH port"; exit 2; }
        PRICE=$PRICE_MAX
        # The ledger counts the pod from its own creation.
        created=$(jq -r '.createdAt // .lastStartedAt' <<< "$ADOPTED")
        CREATED=$(date -j -u -f '%Y-%m-%d %H:%M:%S' "${created:0:19}" +%s)
        DEADLINE=$(( $(date +%s) + CAP_SECONDS ))
        # The pod's own timer first: a pod that cannot be capped is left as it was, unrecorded.
        arm "$CAP_SECONDS" || { say "could not arm pod $ADOPT's own deletion timer over SSH with $ADOPT_KEY; the pod is left as it was"; exit 1; }
        trap '' INT TERM HUP
        POD=$ADOPT
        record "$GPU" ADOPTED
        trap 'exit 130' INT
        trap 'exit 143' TERM
        trap 'exit 129' HUP
        jq 'del(.env)' <<< "$ADOPTED" >> "$OUT/pod.json"
        say "adopted pod $POD ($(jq -r .name <<< "$ADOPTED"), $GPU at \$$PRICE/h, created $(date -r "$CREATED" '+%F %T')); it deletes itself at $(date -r "$DEADLINE" '+%F %T')"
        access
        hold || exit 1
        exit 0 ;;
esac
}
