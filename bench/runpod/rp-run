                    raw) ln -f "$(realpath "$f")" "$stage/$name" 2> /dev/null || cp "$f" "$stage/$name" ;;
                    *) "$MAC_DATA/venv/bin/python" -c 'import sys
import numpy as np
x = np.memmap(sys.argv[1], dtype="<f8", mode="r")
with open(sys.argv[2], "wb") as out:
    for i in range(0, len(x), 1 << 24):
        out.write(np.asarray(x[i:i + (1 << 24)]).astype(sys.argv[3]).tobytes())' "$f" "$stage/$name" "$( [ "$enc" = u16 ] && echo '<u2' || echo '<f4')" ;;
