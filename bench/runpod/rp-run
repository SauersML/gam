            printf '%-15s %-22s %-9s %-22s %6s %5s %5s %7s %6s %6s %-9s %s\n' "$id" "${name:0:22}" "${owner:0:9}" "$(cut -c1-22 <<< "${gpu#NVIDIA } ${kind%%:*}")" "$price" "${util:--}" "$up" \
                "$(awk -v p="$price" -v u="$up" 'BEGIN { printf "%.2f", p * u }')" "$left" "$setup" "${flag:--}" "$last"
            # Runs packed onto this pod.
            for g in "$ACTIVE/.$id.guests"/*; do
                [ -f "$g" ] && kill -0 "$(cat "$g")" 2> /dev/null || continue
                gname=${g##*/}
                last=$(grep -v '^[[:space:]]*$' "$RP/$gname/run.log" 2> /dev/null | tail -n 1 | cut -c1-90 || true)
                printf '%-15s %-22s %-9s %-22s %6s %5s %5s %7s %6s %6s %-9s %s\n' "  + packed" "${gname:0:22}" "-" "" "" "" "" "" "" "" "-" "$last"
            done
        done <<< "$pods"
        rm -rf "$utils"
        r=$(gql 'query { myself { clientBalance currentSpendPerHr } }')
        # Thunder's and Nebius's part: their pods in the ledger, and the rate of those running now.
        tspent=$(awk -F'\t' 'NR > 1 && ($4 == "THUNDER" || $4 == "NEBIUS") { s += $6 } END { printf "%.2f", s }' "$LEDGER" 2> /dev/null || echo 0)
        trate=$(awk -F'\t' '$1 ~ /^(thunder|nebius)-/ && $3 != "-" { s += $3 } END { printf "%.4f", s }' <<< "$pods")
        jq -r --arg s "$START_BALANCE" --arg c "$CAP_DOLLARS" --arg idle "$idle_rate" --argjson ts "$tspent" --argjson tr "$trate" '.data.myself
            | (($s | tonumber) - .clientBalance + $ts) as $spent | (.currentSpendPerHr + $tr) as $rate
            | "spend (the RunPod team account, shared with other MATS users, and our Thunder and Nebius pods; the $\($c) check counts all of it): $\($spent * 100 | round / 100) since $\($s) of RunPod credit (Thunder and Nebius $\($ts)), $\($rate * 100 | round / 100)/h now ($\($idle | tonumber * 100 | round / 100)/h on GPUs under 20%); at this rate the $\($c) cap is \(if $rate > 0 then ((($c | tonumber) - $spent) / $rate * 10 | round / 10 | tostring) + " h" else "never" end) away"' <<< "$(body_of "$r")"
        exit 0 ;;
    publish)
