        done <<< "$pods"
        wait
        printf '%-15s %-22s %-9s %-22s %6s %5s %5s %7s %6s %6s %-9s %s\n' POD NAME OWNER GPU '$/h' 'GPU%' 'UP h' '$ SO FAR' 'LEFT h' 'SETUP' FLAG 'LAST LOG LINE'
        idle_rate=0
        while IFS=$'\t' read -r id pname price gpu created _; do
