        # sealed material.
        [ $# -ge 2 ] || usage
        shift
        have=$(published_data)
        gh release view rp-run-data -R SauersML/gam > /dev/null 2>&1 ||
            gh release create rp-run-data -R SauersML/gam --prerelease --title "rp-run data" \
                --notes "Public inputs of #2951's GPU runs (VPD's public weights, exports derived from them, public datasets), one asset per file named by its sha256, for pods to download." > /dev/null
        stage=$RP/.publish
        mkdir -p "$stage"
