#!/usr/bin/env bash
# Rented GPUs for #2951: RunPod's, billed to the MATS team account, and Thunder Compute's and
# Nebius's (the user's own accounts) once their keys are in the Keychain (PROVIDERS, below).
#
#   rp-run NAME GPU_TYPE[,GPU_TYPE...] HOURS -- COMMAND...      run COMMAND on one pod
#   rp-run dev NAME [GPU_TYPE[,GPU_TYPE...] [HOURS]] [-- PATH...] a pod held for development
#   rp-run extend NAME HOURS                                      extend a run's or a held pod's cap by HOURS
#   rp-run stop NAME                                              end a run or a held pod now
#   rp-run batch SPEC                                             launch every run SPEC lists, at once
#   rp-run status                                                 one line per running pod
#   rp-run publish PATH...                                        publish public inputs for pods to download
#
# GPU_TYPE is a RunPod GPU id ("NVIDIA RTX A5000") or its display name ("RTX A5000"), a Thunder
# card thunder:CARD[:MODE] (thunder:a6000, thunder:a100xl:prototyping) or a Nebius platform
# nebius:PLATFORM (nebius:gpu-h100-sxm, preemptible); a list gives the types in order of preference;
# auto ranks every offer (RunPod's community and secure, Thunder's, Nebius's) of the cards the
# benchmark table (gpu_bench.tsv) has measured by expected $ per scored token, with each offer's
# measured failures (attempts.tsv, rank_auto), keeping those with
# RP_MIN_VRAM_GB of memory, and prints the choice; RP_MAX_PRICE ($/h) drops every offer above it,
# in auto and in a list of types (cap_offers); another provider's card enters it once a
# benchmark run of it (gpu_bench.sh with GPU thunder:CARD:MODE or nebius:PLATFORM) is in the table. Work that does not use a GPU (builds, float64 references, CPU fits) goes to
# GitHub Actions (gha-run), never to a RunPod pod. A run takes community cloud for every listed type before secure
# cloud, which it takes only when no community pod is in stock (RunPod no longer offers spot pods:
# "Spot pods are no longer offered", 2026-10-05). It runs COMMAND on the source of a published
# commit, the outputs come back, and the pod is deleted. HOURS (fractional) caps the run: the Mac
# deletes the pod HOURS after the first pod's creation (a watcher process that outlives this one),
# and each pod deletes itself when that time is up by its own clock (runpodctl with the pod's own
# key; a Thunder or Nebius machine shuts down, which ends its GPU's bill), so a Mac that sleeps,
# disconnects or dies still stops the bill.
#
# A pod lost before COMMAND ends (a host that fails, a pod deleted elsewhere) is replaced while time
# remains. The new pod gets the same source, binaries and inputs and the outputs synced so far, and
# runs COMMAND again, so a command that resumes from its own checkpoint under the outputs continues.
# Outputs are synced to the Mac (rsync) every minute while COMMAND runs, except files still being
# written (*.partial) and library_mdl's rebuildable target caches (*.targets).
# The outputs synced so far go up from the Mac at its upload rate, about 1.6 MB/s (1.15 GB of a
# vpd4l 2^24 fit's checkpoint and best checkpoint took 12 min of setup, the GPU idle and paid,
# frontier-gn-n32768-line6, 2026-10-06), and the fit then rebuilds its target caches. To resume a
# large checkpoint in a new run, copy it outside runpod/ (run outputs are never published, e.g.
# mpd-data/checkpoints/NAME/), publish it once (rp-run publish PATH) and start the command from that
# copy (a driver's start:PATH, library_mdl::checkpoint_start): pods download published inputs at
# about 145 MB/s. A checkpoint resumes only at a commit whose fit identity matches the one that
# wrote it ("a checkpoint of another fit" otherwise).
#
# Source: `git archive` of origin/main, or of RP_REF=<commit> when it is published: the Rust
# workspace (crates/, the manifests, the toolchain pin), bench/runpod/ and every /Users/user/gam/...
# path COMMAND names, unpacked at WS/src (WS=/workspace/runs/NAME, the run's own directory on the
# pod), the command's working directory.
#
# Paths are translated as mats-run translates them:
#   target/release/examples/X, /Users/user/gam/target/release/examples/X and
#   `cargo run ... --example X -- ARGS`  -> the pod's X, built at the commit by
#       `cargo build --release -p PACKAGE --example X` (no target-cpu flags: the pod's CPU is
#       unknown), or taken from ~/mpd-data/runpod/_bin/ when the same Rust sources built it before;
#   /Users/user/gam/...       -> WS/src/...;
#   /Users/user/mpd-data/...  -> WS/mpd-data/...; every existing input COMMAND names,
#       outside mpd-data/runpod/, is uploaded first, symlinks as the files they name;
#   ~/.cache/huggingface/hub/models--ORG--NAME/snapshots/REV[/...] -> WS/hf/ORG/NAME/REV[/...],
#       fetched on the pod from huggingface.co at REV (public models; nothing is uploaded);
#   python, python3, the Mac venv's python -> the pod's python3.
# Data with a public source is built on the pod, not uploaded, and checked before COMMAND starts
# (a mismatch refuses the run; the builds' logs come back in data.log):
#   /Users/user/mpd-data/qwen3_fineweb/SHARD[/FILE], SHARD a shard of the FineWeb release
#       (train_shard00 .. train_shard07, heldout_f284, or the Mac's copies train and heldout), FILE
#       one of its files (windows_T{128,256,512,1024}.u32, documents.u32, offsets.u64): the shard is
#       tokenized from its FineWeb source file by bench/mpd_qwen3_fineweb_2951.py at the commit,
#       and every file built is checked against the release's sha256 (release/CONTENTS.json,
#       remade by fineweb_contents.py from the tarballs that release/SHA256SUMS lists);
#   /Users/user/mpd-data/engine/EXPORT, a vpd4l export extended with Pile training rows
#       (source.extends in its export.json): its base export, which holds the target's weights, is
#       uploaded, the export built from it and the Pile files by
#       bench/vpd_2951/vpd_engine_export_pile.py, and every tensor checked against the Mac's
#       export.json, which then replaces the pod's.
# Other cargo commands (`cargo test -p gam-gpu ...`) run as given in WS/src.
# RP_PYENV=NAME gives COMMAND the Python environment pinned in bench/runpod/pyenv/NAME.txt (python and
# python3 are its own; built on the pod by uv while the inputs upload, once per pod and pinned set),
# and RP_HF_MODELS="ORG/NAME[@REVISION] ..." downloads those models into the pod's Hugging Face cache
# (HF_HOME) first, so code that loads them by name finds them there.
# RP_EXAMPLES="X Y" builds further examples for a script that runs them through $MPD_BIN;
# RP_DISK_GB=N sets the container disk (default: 30 GB, 60 for a dev pod, plus twice the inputs
# and models); RP_ENV="K=V ..." adds environment (RUST_LOG is forwarded when set); RP_MIN_RAM_GB=N
# asks for a pod with at least N GB of host memory (default 32), for a command whose host half
# needs more (a float64 reference of a large model).
#
# Write outputs under /Users/user/mpd-data/runpod/NAME/. They come back there, beside the runner's
# own files: run.log (the command's output, streamed while it runs), rp-run.log (the runner's
# steps, timed), pod.json and pod.txt (the pods), build.log, watch.log and cost.txt.
#
# Dev pods: one pod of the first listed type in stock (community, then secure; default RTX A5000,
# then RTX 4090; default cap 4 h), with the source of the commit at WS/src as a git
# repository of one commit, the pinned Rust toolchain, the CUDA 12.4 toolkit, rsync, the PATHs
# given (translated as above) and a release and test build of gam-gpu started in the background
# (WS/warm.log). The runner holds it until `rp-run stop NAME`, its cap, or an interrupt,
# then deletes it. ~/mpd-data/runpod/NAME/ssh [COMMAND] logs in; `rsync -e ~/mpd-data/runpod/NAME/rsh
# SRC "$(cat ~/mpd-data/runpod/NAME/host):DEST"` copies files. `rp-run extend NAME HOURS` moves both
# caps (only on request: the budget check runs again).
#
# Money. The API key is read from the macOS Keychain (service runpod-api-key) at each request and
# handed to curl on a file descriptor: never in argv, the environment, a file or a log. The $150 cap
# counts everything the team account has spent since the credit was $750 (750 minus
# myself.clientBalance), whoever spent it, plus what every pod running on the account may still
# cost (its price for the time left to its cap; 4 h for a pod made outside the runner, which every
# start names); a launch or extension whose estimate (the dearest offer x HOURS) would pass it is
# refused unless RP_ALLOW_OVER=1. Thunder and Nebius pods count toward the same cap: what the
# ledger records for them (cloud THUNDER or NEBIUS) plus their price for the time left to their
# caps. Each pod appends (date, name, gpu, cloud, hours, dollars, pod) to
# ~/mpd-data/runpod/LEDGER.tsv, dollars = the pod's price per hour x hours from creation to
# deletion; cloud is COMMUNITY, SECURE:cheapest-per-token, SECURE:no-community-stock or SECURE:dev; then the seconds
# the pod spent uploading inputs, building data, and from its creation to the command's start (the
# first two overlap each other and the Rust build, so the third is the paid waiting), how its run
# ended, its owner (RP_OWNER) and its approval. A run beside another live run needs RP_PARALLEL=1
# unless it is small (below; held pods do not count). After deleting its pod the runner checks
# through the API that the pod is gone and lists any other pod it created that remains.
#
# Approval: a run starts when ~/mpd-data/runpod/APPROVED.txt (the lead's) lists a prefix of its
# NAME, or when it is small: its estimate at most $3, its owner's spend over the last 24 h plus the
# estimate at most $8 (RP_OWNER=AGENT names the owner), and the account's spend rate now plus the
# run's price at most $4/h. Each automatic approval is logged in ~/mpd-data/runpod/approvals.tsv
# (with its owner and the three amounts), and the ledger marks the pod's approval listed or auto.
#
# Batch: SPEC holds one run per line, written as rp-run's arguments would be (NAME GPU_TYPE HOURS --
# COMMAND..., shell quoting; leading VAR=VALUE words set that run's environment; # starts a comment).
# Every run is checked (as RP_DRY=1 checks it) and priced first, the budget checked once for all of
# them together, and each launched in the background with RP_PARALLEL=1; its console goes to
# ~/mpd-data/runpod/NAME/console.log. The call returns once all are launched.
#
# Status: every pod running on the team account, one line each: pod, run NAME, who started it
# (RP_OWNER=AGENT when the run was launched), GPU and cloud, $/h, the GPU's mean utilization over the
# last 10 minutes, hours up, $ so far, hours left to its cap, flags (IDLE: GPU under 20%; FLAT: a
# run's log and synced outputs unchanged for 15 minutes) and the last line of its run's log; then the account's spend,
# its rate, the rate paid for GPUs under 20%, and the hours until the $150 cap at that rate.
#
# Binaries: the examples and test binaries (RP_TESTS="PACKAGE:TEST ...", run as $MPD_BIN/test-TEST;
# TEST lib is the package's library unit tests, so one package's per run) a
# run needs come from the prerelease rp-run-bin (assets KEY.NAME, KEY the hash of the commit's Rust
# sources), which the pod downloads itself; what it lacks is built first on GitHub Actions
# (gha-run bins, before any pod exists). Only when that fails does the run's first GPU pod build
# them, once per set of sources (other runs wait), and the Mac caches them in _bin. A command that
# compiles (cargo ...) is refused: a GPU pod does not compile.
# A run whose GPU averages under 20% over 15 minutes once its command has run that long is stopped as
# idle-stopped (dev pods are held, not stopped). rp-run stop NAME ends a run (its runner
# deletes the pod and enters it in the ledger; a runner that does not end within a minute is killed
# and the pod deleted) as it ends a held pod.
#
# Packing: a run that states the GPU memory it needs (RP_MIN_VRAM_GB) runs on a pod of ours already
# up, beside the run that holds it, when that pod's GPU is one the run takes, has averaged under 20%
# over the last 5 minutes, has that memory and the run's disk free, and has the run's HOURS left
# before its cap: no new pod, no new cost (status lists it under the pod as "+ packed"). The run's
# own HOURS still cap it (its command is stopped then). A pod is deleted when the last run on it
# ends, or at its own cap; the ledger enters it once. With another run live this needs
# RP_PARALLEL=1, as any run beside another does; RP_PACK=0 always takes a pod of its own.
#
# SSH uses a key made for the run (deleted with it); ~/.ssh/runpod_ed25519.pub is also authorized,
# for a look by hand. RP_DRY=1 prints the translation, uploads, builds, offers and the pod request,
# and creates nothing.
# The whole script is one block, so bash has read all of it before it runs: replacing the file while
# a run is in progress cannot change what that run executes next.
{
set -Eeuo pipefail
REST=https://rest.runpod.io/v1 GRAPHQL=https://api.runpod.io/graphql
SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
MAC_GAM=/Users/user/gam MAC_DATA=/Users/user/mpd-data HF_HUB=/Users/user/.cache/huggingface/hub
# test_ownership.sh runs the runner against a mock API in a scratch data directory.
if [ -n "${RP_TEST_ROOT:-}" ]; then
    MAC_DATA=$RP_TEST_ROOT REST=$RP_TEST_API/v1 GRAPHQL=$RP_TEST_API/graphql
fi
RP=$MAC_DATA/runpod LEDGER=$MAC_DATA/runpod/LEDGER.tsv ACTIVE=$MAC_DATA/runpod/active
# CUDA 12.4 devel: NVRTC and the CUDA libraries the device code loads at run time.
IMAGE=runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
# Hosts whose driver runs what the image's CUDA toolkit (NVRTC) compiles: driver CUDA versions at or
# above the toolkit's, from those RunPod's pod request accepts.
TOOLKIT=$(sed -nE 's/.*-cuda([0-9]+[.][0-9]+).*/\1/p' <<< "$IMAGE")
CUDA_OK=$(jq -nc --arg t "$TOOLKIT" '["11.8","12.0","12.1","12.2","12.3","12.4","12.5","12.6","12.7","12.8","12.9","13.0"]
    | map(select((split(".") | map(tonumber)) >= ($t | split(".") | map(tonumber))))')
# A run replaces a pod its host lost at most RELAUNCHES times, and discards at most DISCARDS pods on
# hosts that fail its checks (no SSH, no CUDA, recorded as failing) before it gives up.
RELAUNCHES=3 DISCARDS=5
# The budget: at most $150 of the team account's credit, which stood at $750 on 2026-10-05 11:10.
# A pod made outside the runner has no cap it knows; it is counted as running 4 h more, the default
# cap of a dev pod.
CAP_DOLLARS=150 START_BALANCE=750 UNCAPPED_HOURS=4
# The benchmark table GPU_TYPE auto ranks cards by (gpu_bench_table.py's output for the latest
# gpu_bench.sh runs).
TABLE=$MAC_DATA/runpod/gpu_bench.tsv
# The team account is shared with other MATS users. The runner stops, deletes or extends only pods it
# created itself: named mpd2951-... and listed in REGISTRY (every pod id it creates, appended at
# creation, never rewritten; the ids in LEDGER.tsv count too). Any other pod is listed by status as
# "not ours" and never acted on, even when a record in active/ names it.
REGISTRY=$MAC_DATA/runpod/created.tsv
# A host (RunPod machine id) or data center is never banned for good: whether a new pod on it is
# kept is decided from its record in ATTEMPTS (unit_risk), as GPU auto ranks offers.
# One row per pod this runner created, written when the pod's attempt ends (attempt_end): date, run,
# pod, GPU id, cloud (COMMUNITY, SECURE, THUNDER, NEBIUS), host, data center, $/h, seconds from
# creation to the end, outcome and detail. Outcomes: worked (the command ran on it), setup failed
# (no SSH, a host or data center that failed before, no own cap), broken driver (CUDA or NVRTC does
# not start, the GPU busy or power-capped), dead network (inputs too slow), lost (gone during setup
# or the command), ended (the runner stopped before the command for reasons of its own: refused
# inputs, STOP, a pod deleted elsewhere; not counted against the offer). GPU_TYPE auto ranks offers
# by these records (rank_auto).
ATTEMPTS=$MAC_DATA/runpod/attempts.tsv
# The runner's own files in the outputs directory: never synced from or restored to a pod.
OWN=(run.log rp-run.log console.log pod.json pod.txt build.log data.log watch.log cost.txt ssh rsh host STOP EXTEND)
# Never synced either: a file still being written (library_mdl writes NAME.partial, then renames it),
# and library_mdl's cache of M's targets beside its checkpoint (tens of GB on Qwen3, rebuilt when
# missing; moving it through the Mac's uplink would take longer than rebuilding it).
SKIP=('*.partial' '*.targets' '*.rp-pull')
RSYNC_EXCLUDE=()
for o in "${OWN[@]}"; do RSYNC_EXCLUDE+=("--exclude=/$o"); done
for o in "${SKIP[@]}"; do RSYNC_EXCLUDE+=("--exclude=$o"); done
mkdir -p "$RP" "$ACTIVE"

# A RunPod API request: METHOD URL [JSON]. Prints the body, then the HTTP status on its own line.
api() {
    local args=(-sS -X "$1" --max-time 60 -w '\n%{http_code}' -H 'Content-Type: application/json')
    [ -n "${3:-}" ] && args+=(--data-binary "$3")
    if [ -n "${RP_TEST_ROOT:-}" ]; then
        curl "${args[@]}" "$2" || printf '\n000'
        return
    fi
    curl "${args[@]}" -H @<(printf 'Authorization: Bearer %s\n' "$(security find-generic-password -s runpod-api-key -w)") "$2" || printf '\n000'
}
status_of() { printf '%s' "${1##*$'\n'}"; }
body_of() { printf '%s' "${1%$'\n'*}"; }
gql() { api POST "$GRAPHQL" "$(jq -nc --arg q "$1" '{query: $q}')"; }

# Providers besides RunPod, each used only while the macOS Keychain holds its credentials (service
# PROVIDER-api-key): with thunder listed, `security add-generic-password -s thunder-api-key -a "$USER" -w`
# turns Thunder Compute on, and deleting the key turns it off; likewise nebius-api-key for Nebius.
PROVIDERS=(thunder nebius)
# Thunder Compute (the user's own account). A pod id thunder-ID is its instance ID. Its cards are
# a6000, a100xl, l40 and h100, in prototyping mode (a GPU attached over the network, cheaper) or
# production mode (a GPU in the machine); an offer's GPU is written thunder:CARD:MODE, the name a
# benchmark run of it gets in gpu_bench.tsv. The price is read from Thunder's public price list at
# launch: the card's hourly rate (production's own rate where it lists one), plus the vCPUs above
# those the card includes (the fewest its spec offers) and the disk above the 100 GB included, at
# its per-vCPU and per-GB rates; Thunder bills only while an instance runs. An offer above the
# lead's ceiling for its card (THUNDER_CEILING, $/h) is never taken, nor is a card it does not name.
# Instances run the cuda12-8 template (Ubuntu, CUDA 12.8: NVRTC for the device code) as user
# ubuntu. No key goes on an instance, so it cannot delete itself: at the cap the Mac's watcher
# deletes it, and the instance itself shuts down (which ends the bill).
THUNDER=https://api.thundercompute.com:8443/v1
THUNDER_CEILING='{"a6000": 0.45, "a100xl": 1.10, "h100": 1.50}'
provider_of() { case $1 in thunder-*) echo thunder ;; nebius-*) echo nebius ;; *) echo runpod ;; esac; }
thunder_enabled() {
    [ -z "${RP_TEST_ROOT:-}" ] && [[ " ${PROVIDERS[*]} " == *" thunder "* ]] && security find-generic-password -s thunder-api-key > /dev/null 2>&1
}
# The vCPUs a Thunder instance gets: the fewest its spec offers with RP_MIN_RAM_GB of memory
# (default 32; it gives ramPerVCPUGiB per vCPU); null when none has that much (no offer).
THUNDER_CORES='def cores($s; $ram): [($s.vcpuOptions | sort)[] | select(. * ($s.ramPerVCPUGiB // 8) >= $ram)] | first;'

tapi() {  # METHOD PATH [JSON]; prints the body, then the HTTP status on its own line
    local args=(-sS -X "$1" --max-time 60 -w '\n%{http_code}' -H 'Content-Type: application/json')
    [ -n "${3:-}" ] && args+=(--data-binary "$3")
    curl "${args[@]}" -H @<(printf 'Authorization: Bearer %s\n' "$(security find-generic-password -s thunder-api-key -w)") "$THUNDER$2" || printf '\n000'
}
# POD's state as the runner acts on it: RUNNING; GONE (deleted, or terminated: the run ends);
# OTHER (stopped or exited by its host: the run may replace it); UNKNOWN (the API did not answer).
pod_state() {
    local r
    case $(provider_of "$1") in
        thunder)
            r=$(tapi GET /instances/list)
            [ "$(status_of "$r")" = 200 ] || { echo UNKNOWN; return; }
            jq -r --arg id "${1#thunder-}" 'if has($id) then (if (.[$id].status // "" | ascii_upcase) == "RUNNING" then "RUNNING" else "OTHER" end) else "GONE" end' <<< "$(body_of "$r")" ;;
        nebius)
            # Preempted, a VM stops (OTHER: the run replaces it); booting counts as running.
            r=$(napi GET "/compute/v1/instances/${1#nebius-}")
            case $(status_of "$r") in
                404) echo GONE ;;
                200) jq -r '.status.state // "" | if . == "DELETING" then "GONE" elif . == "STOPPING" or . == "STOPPED" or . == "ERROR" then "OTHER" else "RUNNING" end' <<< "$(body_of "$r")" ;;
                *) echo UNKNOWN ;;
            esac ;;
        *)
            r=$(api GET "$REST/pods/$1")
            case $(status_of "$r") in
                404) echo GONE ;;
                200) jq -r 'if (.desiredStatus == "TERMINATED") or ((.lastStatusChange // "") | startswith("Terminated")) then "GONE"
                            elif .desiredStatus == "RUNNING" then "RUNNING" else "OTHER" end' <<< "$(body_of "$r")" ;;
                *) echo UNKNOWN ;;
            esac ;;
    esac
}
# Thunder's single-GPU offers under the ceilings: "THUNDER|PRICE|thunder:CARD:MODE|VRAM GB" per
# line, from its public lists, priced for DISK GB of disk (0: the included 100 GB).
thunder_offers() {  # DISK
    local pricing specs
    thunder_enabled || return 0
    pricing=$(curl -sS --max-time 30 "$THUNDER/pricing") && specs=$(curl -sS --max-time 30 "$THUNDER/specs") || return 0
    jq -rn --argjson p "$pricing" --argjson s "$specs" --argjson ceil "$THUNDER_CEILING" --argjson ram "${RP_MIN_RAM_GB:-32}" --argjson disk "${1:-0}" "$THUNDER_CORES"'
        $s.specs | to_entries[] | select(.key | test("^[a-z0-9]+_x1_(prototyping|production)$"))
        | (.key | capture("^(?<g>[a-z0-9]+)_x1_(?<m>[a-z]+)$")) as $k | .value as $spec
        | ($p.pricing[if $k.m == "production" and ($p.pricing[$k.g + "_native"] != null) then $k.g + "_native" else $k.g + "_x1" end]) as $gpu
        | cores($spec; $ram) as $n | select(($gpu // 0) > 0 and $n != null)
        | ($gpu + ($n - ($spec.vcpuOptions | min)) * ($p.pricing.additional_vcpus // 0)
           + ([$disk - ($spec.storageGB.min // 100), 0] | max) * ($p.pricing.disk_gb // 0)) as $price
        | select($ceil[$k.g] != null and $price <= $ceil[$k.g])
        | "THUNDER|\($price * 10000 | round / 10000)|thunder:\($k.g):\($k.m)|\($spec.vramGB)"'
}
# Thunder's instances: "ID STATUS" per line.
thunder_instances() {
    local r
    thunder_enabled || return 0
    r=$(tapi GET /instances/list)
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: Thunder instance list failed: $(body_of "$r" | head -c 200)" >&2; return 1; }
    jq -r 'to_entries[] | "\(.key) \(.value.status // "?")"' <<< "$(body_of "$r")"
}

# Nebius AI Cloud (the user's own account). The Keychain item nebius-api-key holds a service
# account's credentials JSON (what `nebius iam auth-public-key generate --output FILE` writes; its
# "subject-credentials" hold the private key, the key's id and the account's id). Each request signs
# a JWT good for five minutes with that key (RS256 by openssl, which reads the key from a file
# descriptor) and exchanges it for an access token: Nebius's documented REST flow. The project is
# the service account's own unless NEBIUS_PROJECT names one; a VM goes on the project's first
# subnet with a public address. A pod id nebius-ID is the instance's ID. An offer's GPU is
# nebius:PLATFORM (gpu-h100-sxm, gpu-h200-sxm, ...): a preemptible VM (preempted, it stops, and the
# run replaces it) under the pricing policy mpd2951-ceiling-PLATFORM, a standing bid of the
# platform's ceiling (NEBIUS_CEILING, $ per GPU-hour; a platform it does not name is not taken),
# so the VM is preempted rather than charged above it; the platform's one-GPU preset with
# RP_MIN_RAM_GB of memory and the fewest vCPUs; a boot disk of the run's size from image family
# NEBIUS_IMAGE (Ubuntu 24.04, CUDA 12.8 toolkit); cloud-init authorizing the run's key for user
# ubuntu. Its price is Nebius's own estimate for that request at the spot price now (billing
# calculator, per hour). At the cap the VM shuts itself down (preemptible VMs keep recovery policy
# FAIL: stopped, not restarted) and the Mac's watcher deletes it with its disk.
NEBIUS=https://api.nebius.cloud NEBIUS_AUTH=https://auth.eu.nebius.com/oauth2/token/exchange
NEBIUS_PROJECT="" NEBIUS_IMAGE=ubuntu24.04-cuda12
NEBIUS_CEILING='{"gpu-h100-sxm": 1.50, "gpu-h200-sxm": 1.50}'
nebius_enabled() {
    [ -z "${RP_TEST_ROOT:-}" ] && [[ " ${PROVIDERS[*]} " == *" nebius "* ]] && security find-generic-password -s nebius-api-key > /dev/null 2>&1
}
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
# The credentials JSON, from the Keychain (which hands back hex when the item holds line breaks).
nebius_creds() {
    local c
    c=$(security find-generic-password -s nebius-api-key -w) || return 1
    if [[ $c == \{* ]]; then printf '%s' "$c"; else printf '%s' "$c" | xxd -r -p; fi
}
# An access token, printed for the caller to hand to curl on a file descriptor.
nebius_token() {
    local h p now
    now=$(date +%s)
    h=$(nebius_creds | jq -cj '."subject-credentials" | {alg: "RS256", typ: "JWT", kid: .kid}' | b64url)
    p=$(nebius_creds | jq -cj --argjson now "$now" '."subject-credentials" | {iss: .iss, sub: .sub, iat: $now, exp: ($now + 300)}' | b64url)
    printf '%s.%s.%s' "$h" "$p" "$(printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -sign <(nebius_creds | jq -r '."subject-credentials"."private-key"') | b64url)" |
        curl -sS --max-time 30 "$NEBIUS_AUTH" --data-urlencode grant_type=urn:ietf:params:oauth:grant-type:token-exchange \
            --data-urlencode requested_token_type=urn:ietf:params:oauth:token-type:access_token \
            --data-urlencode subject_token_type=urn:ietf:params:oauth:token-type:jwt --data-urlencode subject_token@- |
        jq -r '.access_token // empty'
}
napi() {  # METHOD PATH [JSON]; prints the body, then the HTTP status on its own line
    local args=(-sS -X "$1" --max-time 60 -w '\n%{http_code}' -H 'Content-Type: application/json') token
    [ -n "${3:-}" ] && args+=(--data-binary "$3")
    token=$(nebius_token)
    [ -n "$token" ] || { printf 'Nebius token exchange failed\n000'; return; }
    curl "${args[@]}" -H @<(printf 'Authorization: Bearer %s\n' "$token") "$NEBIUS$2" || printf '\n000'
}
nebius_subnet() {  # PROJECT
    local r
    r=$(napi GET "/vpc/v1/subnets?parentId=$1&pageSize=100")
    jq -er '.items[0].metadata.id' <<< "$(body_of "$r")" 2> /dev/null || { echo "rp-run: no Nebius subnet in project $1: $(body_of "$r" | head -c 200)" >&2; return 1; }
}
nebius_project() {
    local r
    [ -z "$NEBIUS_PROJECT" ] || { echo "$NEBIUS_PROJECT"; return; }
    r=$(napi GET "/iam/v1/service-accounts/$(nebius_creds | jq -r '."subject-credentials".sub')")
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: Nebius service account lookup failed: $(body_of "$r" | head -c 200)" >&2; return 1; }
    jq -er '.metadata.parentId' <<< "$(body_of "$r")"
}
# The platform's one-GPU preset with $ram GiB of memory and the fewest vCPUs (null: none).
NEBIUS_PRESET='def preset($p; $ram): [$p.spec.presets[] | select(.resources.gpuCount == 1 and (.resources.memoryGibibytes // 0) >= $ram)] | sort_by(.resources.vcpuCount) | first;'
# A CreateInstanceRequest: PLATFORM PRESET PROJECT SUBNET POLICY KEY NAME (POLICY empty for a price
# estimate, which follows the spot price).
nebius_request() {
    jq -nc --arg platform "$1" --arg preset "$2" --arg project "$3" --arg subnet "$4" --arg policy "$5" --arg key "$6" --arg name "$7" \
        --argjson disk "$DISK" --arg image "$NEBIUS_IMAGE" '
        {metadata: {parentId: $project, name: $name},
         spec: ({resources: {platform: $platform, preset: $preset},
                 bootDisk: {attachMode: "READ_WRITE", managedDisk: {name: ($name + "-boot"),
                     spec: {type: "NETWORK_SSD", sizeGibibytes: ($disk | tostring), sourceImageFamily: {imageFamily: $image}}}},
                 networkInterfaces: (if $subnet == "" then [] else [{name: "eth0", subnetId: $subnet, ipAddress: {}, publicIpAddress: {}}] end),
                 cloudInitUserData: ("#cloud-config\nusers:\n  - name: ubuntu\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    ssh_authorized_keys:\n      - " + $key + "\n"),
                 preemptible: {onPreemption: "STOP"}, recoveryPolicy: "FAIL"}
                + (if $policy == "" then {followsSpotPrice: {}} else {spotPricingPolicy: {id: $policy}} end))}'
}
# Nebius's one-GPU preemptible offers under the ceilings: "NEBIUS|PRICE|nebius:PLATFORM|VRAM GB"
# per line, priced by Nebius's calculator for DISK GB of disk (default 30).
nebius_offers() {  # DISK
    local project subnet r platforms platform preset mem est price
    nebius_enabled || return 0
    project=$(nebius_project) && subnet=$(nebius_subnet "$project") || return 0
    r=$(napi GET "/compute/v1/platforms?parentId=$project&pageSize=100")
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: Nebius platform list failed: $(body_of "$r" | head -c 200)" >&2; return 0; }
    platforms=$(jq -r --argjson ceil "$NEBIUS_CEILING" --argjson ram "${RP_MIN_RAM_GB:-32}" "$NEBIUS_PRESET"'
        .items[] | select(.status.allowedForPreemptibles == true) | select($ceil[.metadata.name] != null)
        | preset(.; $ram) as $p | select($p != null)
        | "\(.metadata.name) \($p.name) \(.spec.gpuMemoryGigabytes // .spec.gpuMemoryGibibytes // 0)"' <<< "$(body_of "$r")")
    while read -r platform preset mem; do
        [ -n "$platform" ] || continue
        est=$(DISK=${1:-30} nebius_request "$platform" "$preset" "$project" "$subnet" "" "" "mpd2951-estimate" |
            jq -c '{currency: "usd", filterAggregationUnit: {filterAggregationUnitValues: ["FILTER_AGGREGATION_UNIT_HOUR"]},
                    resourceSpecs: [{spec: ({"@type": "type.googleapis.com/nebius.compute.v1.CreateInstanceRequest"} + .)}]}')
        r=$(napi POST /billing/v1/calculator/estimate-batch "$est")
        [ "$(status_of "$r")" = 200 ] || { echo "rp-run: Nebius price estimate for $platform failed: $(body_of "$r" | head -c 200)" >&2; continue; }
        price=$(jq -r '([.totalCosts[]? | select((.aggregationUnit.unit // "") | ascii_downcase | test("hour"))][0] // .totalCosts[0]?) | .general.total.cost // empty' <<< "$(body_of "$r")")
        [ -n "$price" ] || continue
        awk -v p="$price" -v c="$(jq -r --arg k "$platform" '.[$k]' <<< "$NEBIUS_CEILING")" -v g="$platform" -v m="$mem" \
            'p + 0 > 0 && p + 0 <= c + 0 { printf "NEBIUS|%.4f|nebius:%s|%s\n", p, g, m }'
    done <<< "$platforms"
}
# The ceiling's pricing policy for PLATFORM in PROJECT, made when missing; prints its id.
nebius_policy() {  # PROJECT PLATFORM
    local r name=mpd2951-ceiling-$2 ceil id started
    ceil=$(jq -r --arg k "$2" '.[$k]' <<< "$NEBIUS_CEILING")
    r=$(napi GET "/billing/v1/pricing-policies/get-by-name?parentId=$1&name=$name")
    if [ "$(status_of "$r")" != 200 ]; then
        r=$(napi POST /billing/v1/pricing-policies "$(jq -nc --arg p "$1" --arg n "$name" --arg g "$2" --arg c "$(printf '%.3f' "$ceil")" \
            '{metadata: {parentId: $p, name: $n}, spec: {computeInstanceSpec: {v1: {platform: $g}}, pricing: {maxPriceV1: {maxPrice: $c}}}}')")
        [[ $(status_of "$r") == 2* ]] || { echo "rp-run: Nebius pricing policy $name not made: $(body_of "$r" | head -c 200)" >&2; return 1; }
        id=$(jq -er '.resourceId' <<< "$(body_of "$r")") || return 1
        # A VM that names a policy still being made gets an error: wait for it, as for a VM.
        started=$(date +%s)
        until [ "$(napi GET "/billing/v1/pricing-policies/$id" | sed '$d' | jq -r '.status.state // ""' 2> /dev/null)" = STATE_ACTIVE ]; do
            (( $(date +%s) - started < 300 )) || { echo "rp-run: Nebius pricing policy $name not active after 5 minutes" >&2; return 1; }
            sleep 5
        done
        echo "$id"
        return
    fi
    jq -er '.metadata.id' <<< "$(body_of "$r")"
}
# Nebius's instances in the project: "ID STATE NAME" per line.
nebius_instances() {
    local r project
    nebius_enabled || return 0
    project=$(nebius_project) || return 1
    r=$(napi GET "/compute/v1/instances?parentId=$project&pageSize=1000")
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: Nebius instance list failed: $(body_of "$r" | head -c 200)" >&2; return 1; }
    jq -r '.items[]? | "\(.metadata.id) \(.status.state // "?") \(.metadata.name)"' <<< "$(body_of "$r")"
}
provider_offers() { thunder_offers "$@"; nebius_offers "$@"; }

# The binaries a run needs ("NAME" for an example, "test:PACKAGE:NAME" for a test) that neither the
# prerelease rp-run-bin (assets KEY.NAME, built on GitHub Actions) nor the Mac's cache _bin/KEY holds.
ASSETS=https://github.com/SauersML/gam/releases/download/rp-run-bin
# Inputs published once (rp-run publish PATH...) as assets of the prerelease rp-run-data, named by
# their sha256, which pods download at datacenter speed instead of the Mac's 2-3 MB/s uplink.
# published.tsv caches each file's sha256 by path, size and modification time.
DATA_ASSETS=https://github.com/SauersML/gam/releases/download/rp-run-data
PUBLISHED=$MAC_DATA/runpod/published.tsv
# The most a run may upload from the Mac (unpublished inputs): 50 MB, under half a minute at the
# Mac's measured uplink.
UPLOAD_MAX_MB=50
# Seconds of setup (pod creation to command start, the GPU idle and paid) past which a run's setup
# is a failure to fix.
SETUP_FAIL=600
published_data() { gh api --paginate "repos/SauersML/gam/releases/tags/rp-run-data" --jq '.assets[].name' 2> /dev/null || true; }
# The sha256 of mpd-data/REL, from the cache when its size and modification time are unchanged.
sha_of() {  # REL
    local f=$MAC_DATA/$1 size mtime sha
    size=$(stat -L -f %z "$f") mtime=$(stat -L -f %m "$f")
    sha=$(awk -F'\t' -v p="$1" -v s="$size" -v m="$mtime" '$4 == p && $2 == s && $3 == m { h = $1 } END { print h }' "$PUBLISHED" 2> /dev/null)
    if [ -z "$sha" ]; then
        sha=$(shasum -a 256 < "$f" | cut -d' ' -f1)
        printf '%s\t%s\t%s\t%s\n' "$sha" "$size" "$mtime" "$1" >> "$PUBLISHED"
    fi
    echo "$sha"
}
# A float64 file goes up in the smallest form that widens back to the same bytes: u16 when every
# value is a whole number in [0, 65535] (token ids: vpd4l_pile2p27's 2.0 GB tokens.f64 is 0.5 GB),
# f32 when every value is a float32 (an export's weights), else as it is. ENCODINGS caches each
# sha256's form.
ENCODINGS=$MAC_DATA/runpod/encodings.tsv
ENCODE_CHECK='import os, sys
import numpy as np
# In chunks of 16M values, so a 2 GB file needs about 0.3 GB of memory.
n = os.path.getsize(sys.argv[1]) // 8
x = np.memmap(sys.argv[1], dtype="<f8", mode="r") if n else None
u16 = f32 = n > 0
for i in range(0, n, 1 << 24):
    c = np.asarray(x[i:i + (1 << 24)])
    u16 = u16 and bool(np.all(c == np.floor(c)) and c.min() >= 0 and c.max() <= 65535)
    f32 = f32 and bool(np.array_equal(c.astype("<f4").astype("<f8"), c))
    if not (u16 or f32):
        break
print("u16" if u16 else "f32" if f32 else "raw")'
encoding_of() {  # REL SHA
    local enc
    case $1 in *.f64) ;; *) echo raw; return ;; esac
    (( $(stat -L -f %z "$MAC_DATA/$1") % 8 == 0 )) || { echo raw; return; }
    enc=$(awk -F'\t' -v h="$2" '$1 == h { e = $2 } END { print e }' "$ENCODINGS" 2> /dev/null)
    if [ -z "$enc" ]; then
        enc=$("$MAC_DATA/venv/bin/python" -c "$ENCODE_CHECK" "$MAC_DATA/$1" 2> /dev/null || echo raw)
        printf '%s\t%s\n' "$2" "$enc" >> "$ENCODINGS"
    fi
    echo "$enc"
}
# The published asset of SHA, smallest form first, or nothing.
asset_for() {  # SHA [LISTING]
    local have=${2:-$DATA_HAVE} a
    for a in "$1.u16" "$1.f32" "$1"; do grep -qx "$a" <<< "$have" && { echo "$a"; return; }; done
    return 0
}
published_assets() { gh api "repos/SauersML/gam/releases/tags/rp-run-bin" --jq '.assets[].name' 2> /dev/null || true; }
unbuilt() { unbuilt_in "$(published_assets)"; }
unbuilt_in() {  # LISTING
    local x
    for x in "${examples[@]}"; do [ -x "$CACHE/$x" ] || grep -qx "$KEY.$x" <<< "$1" || echo "$x"; done
    for x in "${tests[@]}"; do [ -x "$CACHE/test-${x#*:}" ] || grep -qx "$KEY.test-${x#*:}" <<< "$1" || echo "test:$x"; done
}


# Whether POD is ours: its id in REGISTRY (or LEDGER.tsv), and, when the API still knows it, its
# name mpd2951-... .
registered() { grep -q "^$1	" "$REGISTRY" 2> /dev/null || cut -f7 "$LEDGER" 2> /dev/null | grep -qx "$1"; }
owned() {
    local r
    registered "$1" || return 1
    # Thunder instances are on the user's own account and carry no name the runner sets.
    [ "$(provider_of "$1")" = runpod ] || return 0
    r=$(api GET "$REST/pods/$1")
    case $(status_of "$r") in
        404) return 0 ;;
        200) jq -e '(.name // "") | startswith("mpd2951-")' <<< "$(body_of "$r")" > /dev/null ;;
        *) return 1 ;;
    esac
}

# The live runs on POD other than this process, one pid per line: the run that made it (its
# record's owner) and the runs packed onto it (active/.POD.guests/NAME, each holding its pid).
holders() {  # POD
    local o x
    read -r _ _ _ _ _ o _ < "$ACTIVE/$1" 2> /dev/null || true
    for x in ${o:-} $(cat "$ACTIVE/.$1.guests"/* 2> /dev/null); do
        [ "$x" != "$$" ] && kill -0 "$x" 2> /dev/null && echo "$x"
    done
    return 0
}

# Delete POD (recorded in active/POD), confirm through the API that it is gone, and enter its
# cost in the ledger once. Safe to run twice at once (the run's exit and its watcher). A pod that is
# not ours is never deleted: its record is dropped and the refusal printed. A pod another live run
# still uses is kept for it (the last run to leave deletes it), except at the pod's cap (cap).
reap() {  # POD [cap]
    local pod=$1 rec=$ACTIVE/$1 r code tries=0 gone=0
    [ -f "$rec" ] || return 0
    if [ "${2:-}" != cap ] && [ -n "$(holders "$pod")" ]; then
        echo "rp-run: pod $pod kept: run process $(holders "$pod" | paste -sd ' ' -) still uses it" >&2
        return 0
    fi
    if ! owned "$pod"; then
        echo "rp-run: pod $pod is not ours (not named mpd2951- or not created by rp-run); not deleting it, dropping its record" >&2
        rm -f "$rec" "$ACTIVE/.$pod".*
        return 0
    fi
    local name gpu cloud price created ended upload_s data_s wait_s end
    read -r name gpu cloud price created _ _ _ upload_s data_s wait_s < "$rec"
    end=$(cat "$ACTIVE/.$pod.end" 2> /dev/null || echo deleted)
    gpu=${gpu//_/ }
    while (( tries < 20 )); do
        if [ "$(provider_of "$pod")" != runpod ]; then
            case $(provider_of "$pod") in
                thunder) tapi POST "/instances/${pod#thunder-}/delete" > /dev/null ;;
                nebius) napi DELETE "/compute/v1/instances/${pod#nebius-}" > /dev/null ;;
            esac
            [ "$(pod_state "$pod")" != GONE ] || { gone=1; break; }
            tries=$(( tries + 1 ))
            sleep 6
            continue
        fi
        r=$(api DELETE "$REST/pods/$pod")
        r=$(api GET "$REST/pods/$pod")
        code=$(status_of "$r")
        if [ "$code" = 404 ]; then
            gone=1
        elif [ "$code" = 200 ]; then
            # A deleted pod reads back EXITED with "Terminated by ..." (or TERMINATED), then not at all.
            jq -e '(.desiredStatus == "TERMINATED") or ((.lastStatusChange // "") | startswith("Terminated"))' <<< "$(body_of "$r")" > /dev/null 2>&1 && gone=1
        fi
        if (( gone )); then
            r=$(api GET "$REST/pods")
            if [ "$(status_of "$r")" = 200 ] && jq -e --arg p "$pod" 'type == "array" and all(.[]; .id != $p or (.desiredStatus != "RUNNING" and ((.lastStatusChange // "") | startswith("Terminated"))))' <<< "$(body_of "$r")" > /dev/null 2>&1; then
                break
            fi
            gone=0
        fi
        tries=$(( tries + 1 ))
        sleep 6
    done
    ended=$(date +%s)
    if (( ! gone )); then
        echo "rp-run: POD $pod MAY STILL BE RUNNING: deletion not confirmed after $tries attempts; delete it at https://console.runpod.io/pods" >&2
        return 1
    fi
    # The ledger takes each pod once. A lock older than two minutes is a reaper that died holding it.
    until mkdir "$RP/.ledger.lock" 2> /dev/null; do
        (( $(date +%s) - $(stat -f %m "$RP/.ledger.lock" 2> /dev/null || date +%s) > 120 )) && rmdir "$RP/.ledger.lock" 2> /dev/null
        sleep 1
    done
    if [ -f "$rec" ]; then
        [ -f "$LEDGER" ] || printf 'date\tname\tgpu\tcloud\thours\tdollars\tpod\tupload_s\tdata_s\twait_s\tend\n' > "$LEDGER"
        # Seconds the pod spent on the inputs' upload, on building data from public sources, and
        # from its creation to the command's start (the two overlap each other and the build).
        head -n 1 "$LEDGER" | grep -q wait_s || sed -i '' '1s/$/\tupload_s\tdata_s\twait_s/' "$LEDGER"
        # How the pod's run ended: exit N (its command's status), lost, stopped (rp-run stop),
        # idle-stopped (under 20% GPU for 15 minutes), cap (its HOURS), or deleted (no run on it).
        head -n 1 "$LEDGER" | grep -q $'\tend' || sed -i '' '1s/$/\tend/' "$LEDGER"
        # Who launched the run (RP_OWNER) and what approved it: listed (APPROVED.txt) or auto (the
        # small-run rule).
        head -n 1 "$LEDGER" | grep -q $'\towner\tapproval$' || sed -i '' '1s/$/\towner\tapproval/' "$LEDGER"
        local hours dollars total line owner approval
        owner=$(cat "$ACTIVE/.$pod.owner" 2> /dev/null || echo -)
        approval=$(cat "$ACTIVE/.$pod.approval" 2> /dev/null || echo -)
        hours=$(awk -v a="$created" -v b="$ended" 'BEGIN { printf "%.4f", (b - a) / 3600 }')
        dollars=$(awk -v h="$hours" -v p="$price" 'BEGIN { printf "%.4f", h * p }')
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$name" "$gpu" "$cloud" "$hours" "$dollars" "$pod" "${upload_s:--}" "${data_s:--}" "${wait_s:--}" "$end" "${owner:--}" "${approval:--}" >> "$LEDGER"
        total=$(awk -F'\t' 'NR > 1 { s += $6 } END { printf "%.2f", s }' "$LEDGER")
        line="pod $pod deleted (confirmed). $gpu ($cloud) at \$$price/h x $hours h = \$$dollars; ledger total \$$total"
        echo "rp-run: $line" >&2
        [ -d "$RP/$name" ] && echo "$(date '+%F %T') $line" >> "$RP/$name/cost.txt"
        rm -f "$rec" "$ACTIVE/.$pod.deadline" "$ACTIVE/.$pod.owner" "$ACTIVE/.$pod.approval" "$ACTIVE/.$pod.ssh" "$ACTIVE/.$pod.end"
        rm -rf "$ACTIVE/.$pod.guests"
    fi
    rmdir "$RP/.ledger.lock"
}

# The watcher: reaps POD when the run's process ends (any way, SIGKILL included) or at its deadline
# (DEADLINE, or a later one an extension wrote to active/.POD.deadline). For a run packed onto
# another's pod (GUEST, its NAME) the deadline is the run's own: the run is stopped (its runner,
# then its command on the pod), it leaves the pod, and the pod is deleted only when no run uses it.
if [ "${1:-}" = --watch ]; then
    pod=$2 parent=$3 deadline=$4 guest=${5:-}
    trap '' INT HUP
    due() { if [ -n "$guest" ]; then echo "$deadline"; else cat "$ACTIVE/.$pod.deadline" 2> /dev/null || echo "$deadline"; fi; }
    while kill -0 "$parent" 2> /dev/null && [ -f "$ACTIVE/$pod" ] && (( $(date +%s) < $(due) )); do sleep 10; done
    if [ -n "$guest" ]; then
        if kill -0 "$parent" 2> /dev/null; then
            echo "rp-run: $guest reached its HOURS cap on pod $pod; stopping it" >&2
            touch "$RP/$guest/STOP"
            kill -TERM "$parent" 2> /dev/null || true
            for i in $(seq 60); do kill -0 "$parent" 2> /dev/null || break; sleep 1; done
            kill -KILL "$parent" 2> /dev/null || true
        fi
        if [ -f "$ACTIVE/.$pod.ssh" ]; then
            read -r ip port tmp user < "$ACTIVE/.$pod.ssh"
            ssh -F none -i "$tmp/key" -o IdentitiesOnly=yes -o BatchMode=yes -o UserKnownHostsFile="$tmp/known_hosts" -o StrictHostKeyChecking=accept-new \
                -o ConnectTimeout=10 -o LogLevel=ERROR -p "$port" "${user:-root}@$ip" \
                "p=\$(cat /workspace/runs/$guest/run.pid 2> /dev/null) && kill -TERM -- -\$p" < /dev/null > /dev/null 2>&1 || true
        fi
        [ "$(cat "$ACTIVE/.$pod.guests/$guest" 2> /dev/null)" != "$parent" ] || rm -f "$ACTIVE/.$pod.guests/$guest"
        reap "$pod"
        exit
    fi
    if (( $(date +%s) >= $(due) )); then
        echo "rp-run: $pod reached its HOURS cap; deleting it" >&2
        [ -f "$ACTIVE/.$pod.end" ] || echo cap > "$ACTIVE/.$pod.end"
        reap "$pod" cap
        exit
    fi
    reap "$pod"
    exit
fi

usage() { sed -n '2,/^# The whole script is one block/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 2; }
hours_ok() { [[ $1 =~ ^[0-9]*\.?[0-9]+$ ]] && awk -v h="$1" 'BEGIN { exit !(h > 0 && h <= 72) }' || { echo "rp-run: HOURS must be in (0, 72]" >&2; exit 2; }; }
name_ok() { [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || { echo "rp-run: NAME must be [A-Za-z0-9._-]+" >&2; exit 2; }; }

# The budget, over the whole team account: what it has spent since the credit stood at
# START_BALANCE, plus what every pod running now may still cost: its price for the time left to its
# cap (the runner's deadline for a pod it holds; UNCAPPED_HOURS for a pod made elsewhere, which has
# no cap the runner knows), plus ESTIMATE. Every running pod the runner does not hold is named.
# Refuses when that passes CAP_DOLLARS unless RP_ALLOW_OVER=1; RP_DRY=1 only reports it.
budget() {  # ESTIMATE WHAT
    local r b balance spent pods running=0 id name price left now due rec created est
    r=$(gql 'query { myself { clientBalance currentSpendPerHr } }')
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: balance query failed: $(body_of "$r" | head -c 300)" >&2; exit 1; }
    b=$(body_of "$r")
    balance=$(jq -r '.data.myself.clientBalance' <<< "$b")
    spent=$(awk -v s="$START_BALANCE" -v b="$balance" 'BEGIN { printf "%.2f", s - b }')
    r=$(api GET "$REST/pods")
    [ "$(status_of "$r")" = 200 ] || { echo "rp-run: pod list failed: $(body_of "$r" | head -c 300)" >&2; exit 1; }
    pods=$(jq -r '.[] | select(.desiredStatus == "RUNNING") | "\(.id) \(.costPerHr // 0) \(.name)"' <<< "$(body_of "$r")")
    now=$(date +%s)
    while read -r id price name; do
        [ -n "$id" ] || continue
        rec=$ACTIVE/$id
        if [ -f "$ACTIVE/.$id.deadline" ]; then
            due=$(cat "$ACTIVE/.$id.deadline")
            left=$(( due - now ))
        elif [ -f "$rec" ]; then
            # Held by a runner from before deadlines were recorded: its estimate less what it has run.
            read -r _ _ _ _ created _ est _ < "$rec"
            left=$(awk -v e="$est" -v p="$price" -v t="$(( now - created ))" 'BEGIN { s = (p > 0 ? e / p * 3600 - t : 0); printf "%d", s }')
        else
            left=$(( UNCAPPED_HOURS * 3600 ))
            echo "rp-run: pod $id ($name, \$$price/h) is not ours (another user of the team account, or made outside rp-run); counted as running $UNCAPPED_HOURS h more" >&2
        fi
        running=$(awk -v a="$running" -v p="$price" -v t="$left" 'BEGIN { printf "%.2f", a + (t > 0 ? p * t / 3600 : 0) }')
    done <<< "$pods"
    # Thunder and Nebius: what their pods in the ledger cost, and what each held one may still cost
    # to its cap.
    local tspent
    tspent=$(awk -F'\t' 'NR > 1 && ($4 == "THUNDER" || $4 == "NEBIUS") { s += $6 } END { printf "%.2f", s }' "$LEDGER" 2> /dev/null || echo 0)
    spent=$(awk -v a="$spent" -v t="$tspent" 'BEGIN { printf "%.2f", a + t }')
    for rec in "$ACTIVE"/thunder-* "$ACTIVE"/nebius-*; do
        [ -f "$rec" ] && [ -f "$ACTIVE/.${rec##*/}.deadline" ] || continue
        read -r _ _ _ price _ < "$rec"
        left=$(( $(cat "$ACTIVE/.${rec##*/}.deadline") - now ))
        running=$(awk -v a="$running" -v p="$price" -v t="$left" 'BEGIN { printf "%.2f", a + (t > 0 ? p * t / 3600 : 0) }')
    done
    echo "rp-run: spent \$$spent (RunPod team account: balance \$$balance, \$$(jq -r '.data.myself.currentSpendPerHr' <<< "$b")/h now; Thunder and Nebius \$$tspent); running pods may add \$$running; $2 \$$1" >&2
    if awk -v s="$spent" -v r="$running" -v e="$1" -v c="$CAP_DOLLARS" 'BEGIN { exit !(s + r + e > c) }' && [ -z "${RP_ALLOW_OVER:-}" ] && [ -z "${RP_DRY:-}" ]; then
        echo "rp-run: \$$spent + \$$running + \$$1 exceeds \$$CAP_DOLLARS; RP_ALLOW_OVER=1 to spend it anyway" >&2
        exit 2
    fi
}

# The live record of a held pod NAME: prints "POD PRICE OWNER".
held() {
    local rec n price owner
    for rec in "$ACTIVE"/*; do
        [ -f "$rec" ] || continue
        read -r n _ _ price _ owner _ < "$rec" || true
        [ "$n" = "$1" ] && echo "${rec##*/} $price $owner" && return 0
    done
    return 1
}

# Launch approval: a run starts while ~/mpd-data/runpod/APPROVED.txt (lead only) lists a prefix of its
# NAME, a lost pod is replaced only while it still does, or the run is small enough to be approved
# automatically (small_run below). Paid GPUs serve goal-producing runs only.
approved() {
    local f="$RP/APPROVED.txt" p
    [ -f "$f" ] || return 1
    while IFS= read -r p; do
        case "$p" in ''|'#'*) continue ;; esac
        [[ "$1" == "$p"* ]] && return 0
    done < "$f"
    return 1
}

MODE=run
case ${1:-} in
    status)
        [ $# -eq 1 ] || usage
        r=$(api GET "$REST/pods?includeMachine=true")
        [ "$(status_of "$r")" = 200 ] || { echo "rp-run: pod list failed: $(body_of "$r" | head -c 200)" >&2; exit 1; }
        pods=$(jq -r '.[] | select(.desiredStatus == "RUNNING") | [.id, .name, (.costPerHr // 0), (.machine.gpuTypeId // .gpu.id // .cpuFlavorId // "?"), (.createdAt // ""), (.publicIp // "-"), (.portMappings["22"] // "-")] | @tsv' <<< "$(body_of "$r")")
        # Thunder's instances, as rows of the same form: ours named from the registry, priced and
        # timed from their records (creation time in UTC, as RunPod gives it).
        if thunder_enabled; then
            tr=$(tapi GET /instances/list)
