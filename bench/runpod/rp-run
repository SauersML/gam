        utils=$(mktemp -d)
        while IFS=$'\t' read -r id _ _ _ _ pip pport; do
            [ -n "$id" ] && [ -f "$ACTIVE/$id" ] || continue
            if [ -f "$ACTIVE/.$id.ssh" ]; then
                read -r ip port tmp user < "$ACTIVE/.$id.ssh"
                ssh -F none -i "$tmp/key" -o IdentitiesOnly=yes -o BatchMode=yes -o UserKnownHostsFile="$tmp/known_hosts" -o StrictHostKeyChecking=accept-new \
                    -o ConnectTimeout=8 -o LogLevel=ERROR -p "$port" "${user:-root}@$ip" \
                    "awk -v t=\$(( \$(date +%s) - 600 )) '\$1 >= t && NF == 2 { s += \$2; n++ } END { if (n) printf \"%d\", s / n }' /workspace/gpu-util.log 2> /dev/null" \
                    > "$utils/$id" 2> /dev/null < /dev/null &
