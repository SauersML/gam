{
  "schema": "benchmark-wall-budget/v1",
  "policy": {
    "base": "job_seconds of the scenario's own most recent COMPLETED run, as recorded in `measurements` below",
    "safety_factor": 2.0,
    "safety_factor_rationale": "The base is the whole GitHub job's wall time -- checkout, Python/R setup, artifact download and the smoke imports included -- while the budget caps only the `python3 bench/run_suite.py` invocation. The base is therefore already a strict upper bound on the quantity being capped, and doubling it leaves at least 2x headroom on the shard itself (much more on the short scenarios, whose job time is mostly setup). It is a headroom policy, NOT a fitted cost law: see `rejected_models`.",
    "unmeasured_budget_rule": "A scenario with no `completed` measurement has nothing to calibrate against. It receives the largest budget that any measured scenario earns under the rule above, so no scenario is ever capped below the most expensive scenario that has ever been observed to finish.",
    "ceiling_overhead_rationale": "`timeout-minutes` (the GitHub job ceiling) must sit ABOVE the GNU-timeout budget, or a censored shard is CANCELLED by GitHub instead of exiting 124 and the run loses the ability to tell censored from failed. The gap it must cover is everything outside the bench command -- checkout, Python/R setup, artifact download, smoke imports, upload. That is measured, not guessed: `job_overhead_seconds_observed_max` is the largest gap between job wall time and shard budget across the 22 censored jobs of run 30687540475 (heart_failure_survival), and the ceiling adds `safety_factor` times it, rounded up to the whole minute -- the SAME headroom policy the budget itself uses, applied to the same kind of measured upper bound.",
    "rejected_models": [
      "work = n*p^2 + p^3 with p = n_pcs*k (a matrix-shape cost model). Refuted by these same measurements: us48_demand_5day completes in 2634 s at work ~ 1e5 while papuan_oce4_duchon_k12 completes in 1529 s at work ~ 1e7. The driver of wall time on this matrix is the CONTENDER MIX (the brms MCMC folds in particular), not the design-matrix shape, so a shape-derived budget formula would be a fitted law on the wrong axis. Each scenario is budgeted from its OWN measured history instead."
    ],
    "job_overhead_seconds_observed_max": 203
  },
  "provenance": {
    "run_id": 30687540475,
    "run_url": "https://github.com/SauersML/gam/actions/runs/30687540475",
    "issue": 2737,
    "measured_at_utc": "2026-08-01",
    "source": "gh run view 30687540475 --json jobs -q '.jobs[] | select(.name|startswith(\"Bench \")) | [.conclusion, ((.completedAt|fromdate)-(.startedAt|fromdate)), .name] | @tsv'",
    "outcome_classification": "`completed` = the GitHub job concluded success. `censored` = the job failed having run at least as long as the budget then in force (`budget_seconds_at_measurement`), i.e. the shard was cut short and measured NOTHING. `errored` = the job failed strictly under that budget, i.e. it is a real defect and not a budget case at all.",
    "population": "110 scenarios: 68 completed, 22 censored, 20 errored."
  },
