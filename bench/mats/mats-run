#!/usr/bin/env bash
# Run a command on the MATS Slurm cluster (#2951).
#
#   mats-run NAME CPUS MEM_GB HOURS -- COMMAND...
#
# Submits COMMAND as Slurm job NAME (CPUS cores, RAYON_NUM_THREADS=CPUS, MEM_GB, HOURS wall, may be
# fractional) built from the commit of ~/gam's HEAD (or origin/main when HEAD is unpushed), and
# prints the job id. Binaries are built once per commit in their own build job; the run waits on it.
#
# Paths are translated: /Users/user/mpd-data/... -> the cluster's ~/mpd-data/...;
# /Users/user/gam/target/release/examples/X, target/release/examples/X and
# `cargo run ... --example X -- ARGS` -> that commit's X; /Users/user/gam/... -> a snapshot of the
# source at that commit (also the job's working directory); python/python3 or the Mac venv's
# python -> the cluster venv (numpy, scipy). Every existing /Users/user/mpd-data input the command
# names (outside mpd-data/cluster/) is rsynced up first (MATS_NO_UPLOAD=1 skips that). Write
# outputs under /Users/user/mpd-data/cluster/NAME/ so `mats-pull NAME` brings them back; the Slurm
# log is ~/mpd-data/cluster/NAME/slurm-JOBID.log there.
#
# Environment: MATS_GPUS=N (L40s; CUDA 12.2 libs are on LD_LIBRARY_PATH), MATS_QOS=debug (2 h max),
# MATS_ENV="K=V ..." (extra environment for the command; RUST_LOG is forwarded when set).
set -Eeuo pipefail
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ $# -ge 6 ] && [ "$5" = -- ] || usage
NAME=$1 CPUS=$2 MEM=$3 HOURS=$4
shift 5
[[ $NAME =~ ^[A-Za-z0-9._-]+$ ]] || { echo "mats-run: NAME must be [A-Za-z0-9._-]+" >&2; exit 2; }
[[ $CPUS =~ ^[0-9]+$ ]] && (( CPUS >= 1 && CPUS <= 124 )) || { echo "mats-run: CPUS must be 1..124" >&2; exit 2; }
[[ $MEM =~ ^[0-9]+$ ]] && (( MEM >= 1 && MEM <= 384 )) || { echo "mats-run: MEM_GB must be 1..384" >&2; exit 2; }
MINUTES=$(awk -v h="$HOURS" 'BEGIN { m = int(h * 60 + 0.999); if (m < 1) m = 1; print m }')
QOS=${MATS_QOS:-}
max=$([ "$QOS" = debug ] && echo 120 || echo 1440)
(( MINUTES <= max )) || { echo "mats-run: HOURS exceeds the ${max}-minute limit" >&2; exit 2; }
GPUS=${MATS_GPUS:-0}

MAC_DATA=/Users/user/mpd-data MAC_GAM=/Users/user/gam CL_DATA=/mnt/nw/home/s.sauers/mpd-data

# `cargo run [...] --example X [...] -- ARGS` -> X ARGS
if [ "$1" = cargo ]; then
    ex="" rest=()
    while [ $# -gt 0 ]; do
        case $1 in
            --example) ex=$2; shift 2 ;;
            --example=*) ex=${1#--example=}; shift ;;
            --) shift; rest=("$@"); break ;;
            *) shift ;;
        esac
    done
    [ -n "$ex" ] || { echo "mats-run: only 'cargo run --example X' is translated" >&2; exit 2; }
    set -- "$ex" "${rest[@]}"
fi

uploads=()
words=()
first=1
for a in "$@"; do
    if [ $first = 1 ]; then
        case $a in
            "$MAC_GAM"/target/*/examples/*|target/*/examples/*|./target/*/examples/*) a="@@BIN@@/${a##*/}" ;;
            python|python3|"$MAC_DATA"/venv/bin/python*) a=python ;;
        esac
        first=0
    fi
    while read -r p; do
        [ -n "$p" ] || continue
        case $p in "$MAC_DATA"/cluster/*|"$MAC_DATA"/venv*) continue ;; esac
        [ -e "$p" ] && uploads+=("$p")
    done < <(grep -oE "$MAC_DATA/[^ :,;=\"']+" <<< "$a" || true)
    a=${a//$MAC_GAM\/target\/release\/examples\//@@BIN@@/}
    a=${a//$MAC_GAM\//@@BIN@@/src/}
    a=${a//$MAC_DATA/$CL_DATA}
    words+=("$a")
done
envp=()
[ -n "${RUST_LOG:-}" ] && envp+=("RUST_LOG=$RUST_LOG")
[ -n "${MATS_ENV:-}" ] && read -r -a extra <<< "$MATS_ENV" && envp+=("${extra[@]}")
cmd=$(printf '%q ' "${words[@]}")
cmd=${cmd//\\@\\@BIN\\@\\@/@@BIN@@}
cmd=${cmd//@@BIN@@/@@BIN@@}
[ ${#envp[@]} -gt 0 ] && cmd="env $(printf '%q ' "${envp[@]}")$cmd"

if [ ${#uploads[@]} -gt 0 ] && [ -z "${MATS_NO_UPLOAD:-}" ]; then
    rel=()
    for p in "${uploads[@]}"; do rel+=("$MAC_DATA/./${p#"$MAC_DATA"/}"); done
    kb=$(du -sk "${uploads[@]}" | awk '{ s += $1 } END { print s }')
    if (( kb > 40 * 1024 * 1024 )) && [ -z "${MATS_UPLOAD_BIG:-}" ]; then
        echo "mats-run: inputs are $((kb / 1024 / 1024)) GB; set MATS_UPLOAD_BIG=1 to send them" >&2; exit 2
    fi
    echo "mats-run: syncing $((kb / 1024)) MB of inputs: ${uploads[*]#"$MAC_DATA"/}" >&2
    rsync -a --relative --exclude '*.pem' --exclude '*.key' --exclude '.env' "${rel[@]}" mats:mpd-data/
fi

want=$(git -C "$MAC_GAM" rev-parse HEAD)
b64=$(printf '%s' "$cmd" | base64 | tr -d '\n')
ssh mats bash -s -- "$NAME" "$CPUS" "$MEM" "$MINUTES" "$want" "$GPUS" "'$QOS'" "$b64" < "$here/remote_submit.sh"
