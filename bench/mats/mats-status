#!/usr/bin/env bash
# MATS cluster status from the shared cache that mats-poll refreshes every 2 minutes (#2951); no ssh.
#
#   mats-status          our jobs, our CPU/GPU/memory use against the QOS, the node, and others' queue
#   mats-status NAME     also NAME's job history and the last 30 lines of its newest log
set -Eeuo pipefail
S=$HOME/mpd-data/cluster/_status
[ -f "$S/STAMP" ] || { echo "mats-status: no snapshot yet; is mats-poll running? (pgrep -f mats-poll)" >&2; exit 1; }
echo "snapshot $(cat "$S/STAMP"), polled $(cat "$S/POLLED")"
[ -f "$HOME/mpd-data/cluster/_status_error.txt" ] && echo "last poll failed: $(cat "$HOME/mpd-data/cluster/_status_error.txt")"
cat "$S/squeue_ours.txt"
awk 'NR > 1 {
        m = $6; gb = m ~ /G$/ ? m + 0 : m ~ /T$/ ? m * 1024 : m / 1024
        g = ($7 ~ /gpu/) ? substr($7, match($7, /[0-9]+$/)) + 0 : 0
        if ($3 == "R") { c += $5; mm += gb; gg += g } else { pc += $5; pn++ } }
     END { printf "ours: running %d CPUs (normal cap 124), %d GB, %d GPUs; pending %d jobs (%d CPUs)\n", c, mm, gg, pn, pc }' "$S/squeue_ours.txt"
awk '/CPUAlloc/ { print "node: " $1 " " $2 } /AllocTRES/ { print "node: " $1 }' "$S/node.txt"
awk 'NR > 1 && $4 == "PD" && $2 != "s.sauers" { n++; r[$NF]++ } END { printf "others pending: %d", n; for (k in r) printf "; %s %s", r[k], k; print "" }' "$S/squeue.txt"
if [ -n "${1:-}" ]; then
    d=$S/files/mpd-data/cluster/$1
    [ -f "$d/JOBS" ] && { echo "-- JOBS"; tail -n 5 "$d/JOBS"; }
    log=$(ls -t "$d"/slurm-*.log "$d"/pool-*.log 2> /dev/null | head -1 || true)
    if [ -n "$log" ]; then echo "-- ${log#"$S/files/"}"; tail -n 30 "$log"; else echo "-- no log in the snapshot for $1"; fi
    jid=$(tail -n 1 "$d/JOBS" 2> /dev/null | awk '{ print $1 }')
    [ -n "$jid" ] && grep -E "^${jid}(_|\\|)" "$S/sacct.txt" | head -12 | tr '|' ' ' || true
fi
